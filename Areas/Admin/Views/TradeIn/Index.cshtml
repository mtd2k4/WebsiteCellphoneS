@model IEnumerable<WebsiteBanDienThoai.Models.TradeInRequest>
@{
    ViewData["Title"] = "Quản Lý Thu Cũ Đổi Mới";
    int? currentStatus = ViewBag.Status;
    string? currentSearch = ViewBag.Search;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STATUS FILTER PILLS & SEARCH -->
<div class="cps-admin-card mb-3">
    <div class="cps-admin-card-body p-3">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-action="Index" asp-route-search="@currentSearch" 
               class="btn btn-sm @(!currentStatus.HasValue ? "btn-dark" : "btn-outline-secondary")">
                Tất cả phiếu
            </a>
            <a asp-action="Index" asp-route-status="0" asp-route-search="@currentSearch" 
               class="btn btn-sm @(currentStatus == 0 ? "btn-secondary text-white fw-bold" : "btn-outline-secondary")">
                <i class="bi bi-hourglass-split me-1"></i>Chờ tiếp nhận
            </a>
            <a asp-action="Index" asp-route-status="1" asp-route-search="@currentSearch" 
               class="btn btn-sm @(currentStatus == 1 ? "btn-primary text-white fw-bold" : "btn-outline-primary")">
                <i class="bi bi-calendar2-check me-1"></i>Đã xác nhận lịch
            </a>
            <a asp-action="Index" asp-route-status="2" asp-route-search="@currentSearch" 
               class="btn btn-sm @(currentStatus == 2 ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
                <i class="bi bi-tools me-1"></i>Đang thẩm định
            </a>
            <a asp-action="Index" asp-route-status="3" asp-route-search="@currentSearch" 
               class="btn btn-sm @(currentStatus == 3 ? "btn-success text-white fw-bold" : "btn-outline-success")">
                <i class="bi bi-check2-all me-1"></i>Hoàn tất lên đời
            </a>
            <a asp-action="Index" asp-route-status="4" asp-route-search="@currentSearch" 
               class="btn btn-sm @(currentStatus == 4 ? "btn-danger text-white fw-bold" : "btn-outline-danger")">
                <i class="bi bi-x-circle me-1"></i>Đã hủy
            </a>
        </div>

        <form method="get" class="row g-2 align-items-center">
            @if (currentStatus.HasValue)
            {
                <input type="hidden" name="status" value="@currentStatus" />
            }
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo mã phiếu (CPS-TC-...), tên khách, SĐT, máy cũ..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="bi bi-search"></i> Tìm Kiếm
                </button>
                <a asp-area="Admin" asp-controller="TradeIn" asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TRADE-IN REQUESTS TABLE -->
<div class="cps-admin-card">
    <div class="cps-admin-card-header">
        <h5>
            <i class="bi bi-arrow-repeat text-danger"></i> Danh Sách Hồ Sơ Thu Cũ Đổi Mới
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2">@ViewBag.TotalItems hồ sơ</span>
        </h5>
    </div>
    <div class="cps-admin-card-body p-0">
        <div class="table-responsive">
            <table class="table table-cps table-hover mb-0">
                <thead>
                    <tr>
                        <th>Mã Hồ Sơ</th>
                        <th>Khách Hàng</th>
                        <th>Máy Cũ Bán Lại</th>
                        <th>Giá Thu + Trợ Giá</th>
                        <th>Máy Lên Đời</th>
                        <th>Tiền Bù</th>
                        <th>Chi Nhánh & Lịch Hẹn</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong class="text-danger">@item.RequestCode</strong>
                                    <small class="d-block text-muted" style="font-size: 11px;">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                    @if (item.ActionType == "CashOut")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle mt-1" style="font-size: 10px;">Bán nhận tiền</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle mt-1" style="font-size: 10px;">Lên đời máy</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.CustomerName</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.OldDeviceName @item.OldDeviceStorage</div>
                                    <span class="badge bg-light text-dark border" style="font-size: 11px;">@item.ConditionName</span>
                                </td>
                                <td>
                                    <div class="text-muted small">Thu: @item.BaseEstimatePrice.ToString("N0")₫</div>
                                    @if (item.SmemberBonus > 0)
                                    {
                                        <div class="text-primary small">+ Smem: @item.SmemberBonus.ToString("N0")₫</div>
                                    }
                                    @if (item.ActionType != "CashOut")
                                    {
                                        <div class="text-success small">+ Trợ: @item.SubsidyAmount.ToString("N0")₫</div>
                                    }
                                    <strong class="text-danger">@item.TotalBenefit.ToString("N0")₫</strong>
                                </td>
                                <td>
                                    @if (item.ActionType == "CashOut")
                                    {
                                        <span class="badge bg-light text-muted border">Không đổi máy</span>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-dark small">@(item.TargetProductName ?? "Chưa chọn")</div>
                                        <small class="text-muted">@item.TargetProductPrice.ToString("N0")₫</small>
                                    }
                                </td>
                                <td>
                                    @if (item.ActionType == "CashOut")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">Nhận @item.TotalBenefit.ToString("N0")₫</span>
                                    }
                                    else
                                    {
                                        <strong class="text-danger fs-6">@item.PayDifference.ToString("N0")₫</strong>
                                    }
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 220px;" title="@item.BranchStore">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i><small>@item.BranchStore</small>
                                    </div>
                                    <small class="text-muted d-block"><i class="bi bi-calendar-event me-1"></i>@item.AppointmentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass">@item.StatusText</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & duyệt">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không có hồ sơ thu cũ đổi mới nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PAGINATION -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@currentSearch" asp-route-status="@currentStatus">
                        @p
                    </a>
                </li>
            }
        </ul>
    </nav>
}
