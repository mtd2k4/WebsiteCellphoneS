@model WebsiteBanDienThoai.Models.TradeInRequest
@{
    ViewData["Title"] = "Chi Tiết Phiếu Thu Cũ #" + Model.RequestCode;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <a asp-area="Admin" asp-controller="TradeIn" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h4 class="m-0 fw-bold text-dark">
            Hồ Sơ Thu Cũ Đổi Mới <span class="text-danger">#@Model.RequestCode</span>
        </h4>
        <small class="text-muted">Tạo lúc: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") (Giờ Việt Nam)</small>
    </div>

    <div>
        <span class="badge @Model.StatusBadgeClass fs-6 py-2 px-3">
            @Model.StatusText
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- STEPPER TIẾN TRÌNH THU CŨ ĐỔI MỚI -->
<div class="cps-admin-card mb-4">
    <div class="cps-admin-card-body py-4">
        <div class="row text-center">
            <div class="col-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(Model.Status >= 0 ? "bg-danger text-white" : "bg-light text-muted border")" style="width: 44px; height: 44px; font-size: 18px;">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>
                <div class="small fw-bold @(Model.Status >= 0 ? "text-danger" : "text-muted")">1. Đã đặt lịch</div>
            </div>

            <div class="col-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(Model.Status >= 1 ? "bg-danger text-white" : "bg-light text-muted border")" style="width: 44px; height: 44px; font-size: 18px;">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div class="small fw-bold @(Model.Status >= 1 ? "text-danger" : "text-muted")">2. Đã xác nhận lịch</div>
            </div>

            <div class="col-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(Model.Status >= 2 ? "bg-danger text-white" : "bg-light text-muted border")" style="width: 44px; height: 44px; font-size: 18px;">
                    <i class="bi bi-tools"></i>
                </div>
                <div class="small fw-bold @(Model.Status >= 2 ? "text-danger" : "text-muted")">3. Đang thẩm định</div>
            </div>

            <div class="col-3">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 @(Model.Status == 3 ? "bg-success text-white" : "bg-light text-muted border")" style="width: 44px; height: 44px; font-size: 18px;">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <div class="small fw-bold @(Model.Status == 3 ? "text-success" : "text-muted")">4. Hoàn tất lên đời</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN CHI TIẾT MÁY & BẢNG TÍNH -->
    <div class="col-lg-8">
        <!-- CARD MÁY CŨ VÀ ĐỊNH GIÁ -->
        <div class="cps-admin-card mb-4">
            <div class="cps-admin-card-header">
                <h5><i class="bi bi-phone text-danger"></i> Chi Tiết Thiết Bị Thu Đổi</h5>
            </div>
            <div class="cps-admin-card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <span class="text-muted small">Loại hình giao dịch:</span>
                        @if (Model.ActionType == "CashOut")
                        {
                            <span class="badge bg-success ms-1 fs-6"><i class="bi bi-cash-stack me-1"></i>Bán lại lấy tiền (Không mua máy)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-1 fs-6"><i class="bi bi-stars me-1"></i>Thu cũ đổi mới - Lên đời máy</span>
                        }
                    </div>
                    @if (Model.SmemberBonus > 0)
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                            <i class="bi bi-gem me-1"></i>Thưởng Smember: +@Model.SmemberBonus.ToString("N0")₫
                        </span>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thiết bị</th>
                                <th>Tình trạng máy</th>
                                <th>Giá thu cơ sở</th>
                                @if (Model.SmemberBonus > 0)
                                {
                                    <th>Thưởng Smember (5%)</th>
                                }
                                @if (Model.ActionType != "CashOut")
                                {
                                    <th>Trợ giá lên đời</th>
                                }
                                <th>Tổng giá trị thu lại</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong class="text-dark fs-6">@Model.OldDeviceName @Model.OldDeviceStorage</strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@Model.ConditionName</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@Model.BaseEstimatePrice.ToString("N0")₫</span>
                                </td>
                                @if (Model.SmemberBonus > 0)
                                {
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold">
                                            +@Model.SmemberBonus.ToString("N0")₫
                                        </span>
                                    </td>
                                }
                                @if (Model.ActionType != "CashOut")
                                {
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
                                            +@Model.SubsidyAmount.ToString("N0")₫
                                        </span>
                                    </td>
                                }
                                <td>
                                    <strong class="text-danger fs-6">@Model.TotalBenefit.ToString("N0")₫</strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3 border">
                    @if (Model.ActionType == "CashOut")
                    {
                        <div class="row align-items-center g-2">
                            <div class="col-md-6">
                                <span class="text-muted small">Hình thức:</span>
                                <div class="fw-bold text-success fs-6"><i class="bi bi-cash-stack me-1"></i>Bán lại nhận tiền mặt / chuyển khoản</div>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <span class="text-muted small">Số tiền cửa hàng chi trả cho khách:</span>
                                <div class="text-success fw-bolder fs-4">@Model.TotalBenefit.ToString("N0")₫</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row align-items-center g-2">
                            <div class="col-md-6">
                                <span class="text-muted small">Thiết bị muốn lên đời:</span>
                                <div class="fw-bold text-dark fs-6">@(Model.TargetProductName ?? "Chưa xác định")</div>
                                <small class="text-muted">Giá niêm yết: @Model.TargetProductPrice.ToString("N0")₫</small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <span class="text-muted small">Số tiền khách cần bù chênh lệch:</span>
                                <div class="text-danger fw-bolder fs-4">@Model.PayDifference.ToString("N0")₫</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CARD ĐỊA ĐIỂM & THỜI GIAN HẸN -->
        <div class="cps-admin-card mb-4">
            <div class="cps-admin-card-header">
                <h5><i class="bi bi-geo-alt text-danger"></i> Lịch Hẹn Tại Cửa Hàng</h5>
            </div>
            <div class="cps-admin-card-body">
                <div class="row g-3">
                    <div class="col-md-7">
                        <span class="text-muted small">Chi nhánh tiếp nhận:</span>
                        <div class="fw-bold text-danger">
                            <i class="bi bi-shop me-1"></i>@Model.BranchStore
                        </div>
                    </div>
                    <div class="col-md-5">
                        <span class="text-muted small">Thời gian khách hẹn đến:</span>
                        <div class="fw-bold text-dark">
                            <i class="bi bi-clock-fill text-muted me-1"></i>@Model.AppointmentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CustomerNote))
                    {
                        <div class="col-12">
                            <span class="text-muted small">Ghi chú của khách:</span>
                            <div class="p-2 bg-light rounded border text-muted small">
                                <em>@Model.CustomerNote</em>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: KHÁCH HÀNG & THAO TÁC CẬP NHẬT TRẠNG THÁI -->
    <div class="col-lg-4">
        <!-- CARD KHÁCH HÀNG -->
        <div class="cps-admin-card mb-4">
            <div class="cps-admin-card-header">
                <h5><i class="bi bi-person-fill text-danger"></i> Khách Hàng</h5>
            </div>
            <div class="cps-admin-card-body">
                <div class="mb-2">
                    <span class="text-muted small d-block">Họ và tên:</span>
                    <strong class="text-dark">@Model.CustomerName</strong>
                </div>
                <div class="mb-2">
                    <span class="text-muted small d-block">Số điện thoại:</span>
                    <a href="tel:@Model.PhoneNumber" class="text-danger fw-bold text-decoration-none">
                        <i class="bi bi-telephone-fill me-1"></i>@Model.PhoneNumber
                    </a>
                </div>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="mb-2">
                        <span class="text-muted small d-block">Email:</span>
                        <a href="mailto:@Model.Email" class="text-dark small text-decoration-none">@Model.Email</a>
                    </div>
                }
                @if (Model.User != null)
                {
                    <div class="mt-3 pt-2 border-top">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="bi bi-gem me-1"></i>Hội viên Smember (@Model.User.SmemberLevel)
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- CARD CẬP NHẬT TRẠNG THÁI -->
        <div class="cps-admin-card mb-4">
            <div class="cps-admin-card-header">
                <h5><i class="bi bi-pencil-square text-danger"></i> Cập Nhật Trạng Thái</h5>
            </div>
            <div class="cps-admin-card-body">
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Chọn trạng thái xử lý:</label>
                        <select name="status" class="form-select">
                            <option value="0" selected="@(Model.Status == 0)">0. Chờ tiếp nhận</option>
                            <option value="1" selected="@(Model.Status == 1)">1. Đã xác nhận lịch hẹn</option>
                            <option value="2" selected="@(Model.Status == 2)">2. Đang thẩm định tại shop</option>
                            <option value="3" selected="@(Model.Status == 3)">3. Đã hoàn tất lên đời</option>
                            <option value="4" selected="@(Model.Status == 4)">4. Đã hủy phiếu</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Lưu Thay Đổi
                    </button>
                </form>

                <hr class="my-3" />

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="confirmDeleteTradeIn(event, this)">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-trash me-1"></i> Xóa phiếu thu cũ
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDeleteTradeIn(e, form) {
            e.preventDefault();
            Swal.fire({
                title: 'Xóa phiếu thu cũ?',
                html: `Bạn có chắc chắn muốn xóa phiếu thu cũ đổi mới <strong>#@Model.Id</strong> của khách hàng <strong>@Model.CustomerName</strong> không?<br><small class="text-danger">Thao tác này không thể hoàn tác!</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d70018',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="bi bi-trash me-1"></i> Đồng ý xóa',
                cancelButtonText: 'Huỷ bỏ',
                customClass: {
                    popup: 'rounded-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }
    </script>
}

