@model IEnumerable<WebsiteBanDienThoai.Models.WarrantyCard>
@{
    ViewData["Title"] = "Quản Lý Phiếu Bảo Hành Khách Hàng";
    WebsiteBanDienThoai.Models.WarrantyCardStatus? currentStatus = ViewBag.Status;
    string? currentSearch = ViewBag.Search;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bolder text-dark mb-1">
            <i class="bi bi-shield-check text-danger me-2"></i> Quản Lý Phiếu Bảo Hành Điện Tử
        </h4>
        <small class="text-muted">Theo dõi, cấp mới và gia hạn phiếu bảo hành sản phẩm khách hàng đã mua tại hệ thống CellphoneS.</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="" asp-controller="Warranty" asp-action="Lookup" target="_blank" class="btn btn-outline-secondary fw-semibold btn-sm shadow-xs">
            <i class="bi bi-search me-1"></i> Trang Tra Cứu Khách
        </a>
        <a asp-action="Create" class="btn btn-danger fw-bold btn-sm shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Cấp Phiếu Bảo Hành Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- THẺ THỐNG KÊ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="cps-admin-card p-3 border-start border-primary border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Tổng số phiếu</span>
                    <h4 class="m-0 fw-bold text-dark mt-1">@ViewBag.TotalWarranties</h4>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white shadow-sm" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-shield-shaded"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cps-admin-card p-3 border-start border-success border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Đang còn hạn</span>
                    <h4 class="m-0 fw-bold text-success mt-1">@ViewBag.ActiveCount</h4>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white shadow-sm" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cps-admin-card p-3 border-start border-warning border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Sắp hết hạn (&lt; 30 ngày)</span>
                    <h4 class="m-0 fw-bold text-warning mt-1">@ViewBag.ExpiringSoonCount</h4>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning text-dark shadow-sm" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="cps-admin-card p-3 border-start border-secondary border-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Đã hết hạn / Từ chối</span>
                    <h4 class="m-0 fw-bold text-secondary mt-1">@(ViewBag.ExpiredCount + ViewBag.VoidCount)</h4>
                </div>
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-secondary text-white shadow-sm" style="width: 44px; height: 44px; font-size: 20px;">
                    <i class="bi bi-calendar-x"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- THANH TÌM KIẾM & BỘ LỌC -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" 
                           placeholder="Tìm theo mã phiếu BH-..., IMEI, khách hàng, SĐT, máy..." />
                </div>
            </div>

            <div class="col-md-4">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Tất cả trạng thái hiệu lực --</option>
                    <option value="Active" selected="@(currentStatus == WebsiteBanDienThoai.Models.WarrantyCardStatus.Active)">Còn hiệu lực bảo hành</option>
                    <option value="ExpiringSoon" selected="@(currentStatus == WebsiteBanDienThoai.Models.WarrantyCardStatus.ExpiringSoon)">Sắp hết hạn (&lt; 30 ngày)</option>
                    <option value="Expired" selected="@(currentStatus == WebsiteBanDienThoai.Models.WarrantyCardStatus.Expired)">Đã hết hạn bảo hành</option>
                    <option value="Void" selected="@(currentStatus == WebsiteBanDienThoai.Models.WarrantyCardStatus.Void)">Đã hủy / Từ chối bảo hành</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-danger fw-bold flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentStatus.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH PHIẾU BẢO HÀNH -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle m-0 table-cps">
                <thead>
                    <tr>
                        <th style="width: 130px;">Mã Phiếu BH</th>
                        <th>Khách Hàng</th>
                        <th>Thiết Bị &amp; IMEI</th>
                        <th>Gói Bảo Hành</th>
                        <th style="width: 170px;">Thời Hạn</th>
                        <th style="width: 140px;">Trạng Thái</th>
                        <th class="text-end" style="width: 130px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-x fs-1 d-block mb-2 text-muted"></i>
                                Không tìm thấy phiếu bảo hành nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var effectiveStatus = item.EffectiveStatus;
                            string badgeClass = effectiveStatus switch
                            {
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Active => "bg-success",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.ExpiringSoon => "bg-warning text-dark",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Expired => "bg-secondary",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Void => "bg-danger",
                                _ => "bg-secondary"
                            };

                            string statusText = effectiveStatus switch
                            {
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Active => "Còn hạn",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.ExpiringSoon => "Sắp hết hạn",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Expired => "Hết hạn",
                                WebsiteBanDienThoai.Models.WarrantyCardStatus.Void => "Đã hủy",
                                _ => "Không rõ"
                            };

                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold font-monospace text-danger text-decoration-none d-block">
                                        @item.WarrantyCode
                                    </a>
                                    <small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </td>

                                <td>
                                    <strong class="text-dark d-block">@item.CustomerName</strong>
                                    <span class="text-muted small font-monospace"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                        {
                                            <img src="@item.ProductImageUrl" alt="" style="width: 38px; height: 38px; object-fit: contain; border-radius: 6px; border: 1px solid #e2e8f0;" class="p-1 bg-white" />
                                        }
                                        <div>
                                            <strong class="text-dark d-block small">@item.ProductName</strong>
                                            <span class="text-danger small font-monospace"><i class="bi bi-upc me-1"></i>@item.SerialNumber</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border small fw-semibold">@item.WarrantyPackage</span>
                                    @if (!string.IsNullOrEmpty(item.OrderCode))
                                    {
                                        <small class="text-muted d-block mt-1">Đơn: <strong class="text-dark">#@item.OrderCode</strong></small>
                                    }
                                </td>

                                <td>
                                    <div class="small">
                                        <span class="text-muted">Đến:</span> <strong class="@(item.IsActiveNow ? "text-dark" : "text-muted")">@item.EndDate.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                    <div class="progress mt-1" style="height: 5px;">
                                        <div class="progress-bar @(item.IsActiveNow ? "bg-success" : "bg-secondary")" style="width: @item.UsedPercent%;"></div>
                                    </div>
                                    <small class="@(item.IsActiveNow ? "text-success" : "text-muted")" style="font-size: 11px;">
                                        @(item.IsActiveNow ? $"Còn {item.RemainingDays} ngày" : "Đã hết hạn")
                                    </small>
                                </td>

                                <td>
                                    <span class="badge @badgeClass px-2 py-1 small rounded-pill">
                                        @statusText
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & Cập nhật">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-area="" asp-controller="Warranty" asp-action="Certificate" asp-route-code="@item.WarrantyCode" target="_blank" class="btn btn-sm btn-outline-dark" title="In phiếu bảo hành">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PHÂN TRANG -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Hiển thị trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng @ViewBag.TotalItems phiếu)</span>
            <nav>
                <ul class="pagination pagination-sm m-0">
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@currentSearch" asp-route-status="@currentStatus">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
