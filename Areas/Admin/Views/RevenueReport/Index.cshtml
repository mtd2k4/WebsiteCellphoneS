@model WebsiteBanDienThoai.Areas.Admin.Models.RevenueReportViewModel
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu & Tài Chính";
}

<!-- TIÊU ĐỀ & NÚT HÀNH ĐỘNG -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bolder text-dark mb-1">
            <i class="bi bi-bar-chart-line-fill text-danger me-2"></i> Báo Cáo Doanh Thu & Kinh Doanh
        </h3>
        <p class="text-muted small m-0">Phân tích dòng tiền bán hàng, cơ cấu doanh thu, hiệu quả khuyến mãi và xuất báo cáo tài chính.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportPdf" 
           asp-route-preset="@Model.Preset" 
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" 
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" 
           asp-route-paymentMethod="@Model.PaymentMethod" 
           asp-route-statusFilter="@Model.StatusFilter" 
           target="_blank" 
           class="btn btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2">
            <i class="bi bi-printer-fill"></i>
            <span>Xem Bản In Chuẩn A4</span>
        </a>

        <button type="button" class="btn btn-danger px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" onclick="exportReportToPdf()">
            <i class="bi bi-file-earmark-pdf-fill"></i>
            <span>Xuất File PDF Báo Cáo</span>
        </button>
    </div>
</div>

<!-- THANH LỌC THỜI GIAN & ĐIỀU KIỆN -->
<div class="cps-admin-card p-3 mb-4">
    <form method="get" asp-action="Index" id="filterForm">
        <!-- Preset pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 pb-3 mb-3 border-bottom">
            <span class="small fw-bold text-muted me-1">Khoảng thời gian:</span>
            <button type="button" class="btn btn-sm @(Model.Preset == "today" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="today">Hôm nay</button>
            <button type="button" class="btn btn-sm @(Model.Preset == "7days" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="7days">7 ngày qua</button>
            <button type="button" class="btn btn-sm @(Model.Preset == "30days" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="30days">30 ngày qua</button>
            <button type="button" class="btn btn-sm @(Model.Preset == "thismonth" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="thismonth">Tháng này</button>
            <button type="button" class="btn btn-sm @(Model.Preset == "lastmonth" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="lastmonth">Tháng trước</button>
            <button type="button" class="btn btn-sm @(Model.Preset == "thisyear" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill preset-btn" data-preset="thisyear">Năm nay</button>
            <input type="hidden" name="preset" id="inputPreset" value="@Model.Preset" />
        </div>

        <div class="row g-2 align-items-end">
            <!-- Từ ngày -->
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1">Từ ngày:</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" id="inputStartDate" />
            </div>

            <!-- Đến ngày -->
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small text-muted mb-1">Đến ngày:</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" id="inputEndDate" />
            </div>

            <!-- Phương thức thanh toán -->
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Phương thức:</label>
                <select name="paymentMethod" class="form-select form-select-sm">
                    <option value="all" selected="@(Model.PaymentMethod == "all")">Tất cả phương thức</option>
                    <option value="COD" selected="@(Model.PaymentMethod == "COD")">COD Tiền mặt</option>
                    <option value="VNPay" selected="@(Model.PaymentMethod == "VNPay")">VNPAY-QR</option>
                    <option value="BankTransfer" selected="@(Model.PaymentMethod == "BankTransfer")">Chuyển khoản</option>
                </select>
            </div>

            <!-- Trạng thái đơn -->
            <div class="col-12 col-sm-6 col-md-2">
                <label class="form-label small text-muted mb-1">Trạng thái đơn:</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="all" selected="@(Model.StatusFilter == "all")">Tất cả trạng thái</option>
                    <option value="valid" selected="@(Model.StatusFilter == "valid")">Đơn hợp lệ (Trừ hủy)</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed")">Đã hoàn thành</option>
                    <option value="shipping" selected="@(Model.StatusFilter == "shipping")">Đang giao hàng</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">Chờ xử lý / Xác nhận</option>
                    <option value="cancelled" selected="@(Model.StatusFilter == "cancelled")">Đã hủy</option>
                </select>
            </div>

            <!-- Nút lọc -->
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-sm btn-danger w-100 fw-bold">
                    <i class="bi bi-funnel-fill me-1"></i> Áp Dụng Lọc
                </button>
            </div>
        </div>
    </form>
</div>

<!-- VÙNG BÁO CÁO CÓ THỂ XUẤT RA PDF (PRINTABLE REPORT AREA) -->
<div id="printableReportArea">
    <!-- Header tóm tắt khi xuất PDF -->
    <div class="d-none d-print-block p-4 mb-4 border-bottom bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bolder text-danger m-0">CÔNG TY CỔ PHẦN BÁN LẺ CELLPHONES</h4>
                <p class="small text-muted m-0">Mã số thuế: 0107778899 - Hotline: 1800.2097</p>
                <p class="small text-muted m-0">Địa chỉ: 123 Đường Công Nghệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</p>
            </div>
            <div class="text-end">
                <h5 class="fw-bold text-dark m-0">BÁO CÁO DOANH THU KINH DOANH</h5>
                <p class="small text-muted m-0">Kỳ báo cáo: @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</p>
                <p class="small text-muted m-0">Ngày trích xuất: @DateTime.UtcNow.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>

    <!-- 1. THẺ THỐNG KÊ TÀI CHÍNH (KPIs) -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu thuần -->
        <div class="col-sm-6 col-xl-3">
            <div class="cps-admin-card p-3 border-start border-danger border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">Tổng Doanh Thu</span>
                        <h4 class="m-0 fw-bolder text-danger mt-1">@Model.TotalRevenue.ToString("N0")₫</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white shadow-sm" style="width: 48px; height: 48px; font-size: 22px;">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top small text-muted d-flex justify-content-between">
                    <span>Tiền hàng gốc:</span>
                    <strong class="text-dark">@Model.TotalSubtotal.ToString("N0")₫</strong>
                </div>
            </div>
        </div>

        <!-- Tổng số đơn hàng -->
        <div class="col-sm-6 col-xl-3">
            <div class="cps-admin-card p-3 border-start border-primary border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">Tổng Đơn Hàng</span>
                        <h4 class="m-0 fw-bolder text-primary mt-1">@Model.TotalOrders đơn</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white shadow-sm" style="width: 48px; height: 48px; font-size: 22px;">
                        <i class="bi bi-cart-check"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top small text-muted d-flex justify-content-between">
                    <span>Hoàn thành:</span>
                    <strong class="text-success">@Model.CompletedOrders đơn</strong>
                </div>
            </div>
        </div>

        <!-- Giá trị trung bình đơn hàng (AOV) -->
        <div class="col-sm-6 col-xl-3">
            <div class="cps-admin-card p-3 border-start border-success border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">Giá Trị Đơn Trung Bình</span>
                        <h4 class="m-0 fw-bolder text-success mt-1">@Model.AverageOrderValue.ToString("N0")₫</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white shadow-sm" style="width: 48px; height: 48px; font-size: 22px;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top small text-muted d-flex justify-content-between">
                    <span>Đang giao / chờ:</span>
                    <strong class="text-dark">@(Model.ShippingOrders + Model.PendingOrders) đơn</strong>
                </div>
            </div>
        </div>

        <!-- Chiết khấu & Voucher -->
        <div class="col-sm-6 col-xl-3">
            <div class="cps-admin-card p-3 border-start border-warning border-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold">Chiết Khấu & Voucher</span>
                        <h4 class="m-0 fw-bolder text-warning mt-1">-@Model.TotalDiscount.ToString("N0")₫</h4>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-warning text-white shadow-sm" style="width: 48px; height: 48px; font-size: 22px;">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top small text-muted d-flex justify-content-between">
                    <span>Phí ship thu:</span>
                    <strong class="text-dark">@Model.TotalShippingFee.ToString("N0")₫</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BIỂU ĐỒ TRỰC QUAN (CHARTS) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ đường: Doanh thu theo thời gian -->
        <div class="col-lg-8">
            <div class="cps-admin-card p-3 p-md-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark m-0">
                        <i class="bi bi-graph-up text-danger me-2"></i> Xu Hướng Doanh Thu Theo Thời Gian
                    </h6>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                        @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <div style="position: relative; height: 300px; width: 100%;">
                    <canvas id="revenueTimelineChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ tròn: Cơ cấu doanh thu theo Danh mục -->
        <div class="col-lg-4">
            <div class="cps-admin-card p-3 p-md-4 h-100 shadow-sm">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i> Cơ Cấu Theo Danh Mục
                </h6>
                <div style="position: relative; height: 220px; width: 100%;" class="d-flex justify-content-center">
                    <canvas id="categoryDonutChart"></canvas>
                </div>
                <div class="mt-3 pt-2 border-top small">
                    @foreach (var cat in Model.CategoryBreakdown.Take(4))
                    {
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-truncate text-muted" style="max-width: 140px;">@cat.CategoryName</span>
                            <span class="fw-bold text-dark">@cat.Percentage% <small class="text-muted fw-normal">(@cat.Revenue.ToString("N0")₫)</small></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 3. HAI BẢNG TÓM TẮT: CƠ CẤU THANH TOÁN & TOP SẢN PHẨM -->
    <div class="row g-4 mb-4">
        <!-- Cơ cấu thanh toán -->
        <div class="col-lg-5">
            <div class="cps-admin-card p-3 h-100 shadow-sm">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-credit-card-2-back-fill text-success me-2"></i> Doanh Thu Theo Phương Thức Thanh Toán
                </h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small m-0">
                        <thead class="table-light">
                            <tr>
                                <th>Phương thức</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh thu</th>
                                <th class="text-end">Tỷ trọng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PaymentBreakdown.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Không có dữ liệu</td></tr>
                            }
                            else
                            {
                                @foreach (var pay in Model.PaymentBreakdown)
                                {
                                    <tr>
                                        <td class="fw-semibold">@pay.MethodName</td>
                                        <td class="text-center">@pay.OrderCount</td>
                                        <td class="text-end fw-bold text-danger">@pay.Revenue.ToString("N0")₫</td>
                                        <td class="text-end">
                                            <span class="badge bg-secondary-subtle text-dark">@pay.Percentage%</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Top sản phẩm doanh thu cao nhất -->
        <div class="col-lg-7">
            <div class="cps-admin-card p-3 h-100 shadow-sm">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-trophy-fill text-warning me-2"></i> Top Sản Phẩm Doanh Thu Cao Nhất
                </h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small m-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TopProducts.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu bán hàng</td></tr>
                            }
                            else
                            {
                                int rank = 1;
                                @foreach (var p in Model.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-danger rounded-circle p-2">1</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="badge bg-warning rounded-circle p-2">2</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="badge bg-primary rounded-circle p-2">3</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fw-bold">@rank</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                                {
                                                    <img src="@p.ImageUrl" alt="@p.ProductName" style="width: 34px; height: 34px; object-fit: contain;" class="rounded border p-1 bg-white" />
                                                }
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 220px;">@p.ProductName</span>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-secondary border">@p.CategoryName</span></td>
                                        <td class="text-center fw-bold">@p.QuantitySold</td>
                                        <td class="text-end fw-bolder text-danger">@p.TotalRevenue.ToString("N0")₫</td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. DANH SÁCH CHI TIẾT ĐƠN HÀNG TRONG KỲ -->
    <div class="cps-admin-card overflow-hidden shadow-sm mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white">
            <h6 class="fw-bold text-dark m-0">
                <i class="bi bi-receipt text-danger me-2"></i> Danh Sách Chi Tiết Đơn Hàng (@Model.Orders.Count đơn)
            </h6>
            <span class="small text-muted">Hiển thị toàn bộ đơn hàng (tất cả các trạng thái) trong khoảng thời gian đã chọn</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle small m-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Thời Gian</th>
                        <th>Khách Hàng</th>
                        <th>Phương Thức</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Tiền Hàng</th>
                        <th class="text-end">Giảm Giá</th>
                        <th class="text-end">Phí Ship</th>
                        <th class="text-end">Tổng Thu</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Orders.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không có đơn hàng nào phát sinh trong khoảng thời gian này.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in Model.Orders)
                        {
                            var totalDiscount = o.OrderDiscountAmount + o.ShippingDiscountAmount;
                            <tr>
                                <td>
                                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="fw-bold text-danger font-monospace text-decoration-none">
                                        @o.OrderCode
                                    </a>
                                </td>
                                <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@o.CustomerName</div>
                                    <small class="text-muted font-monospace">@o.PhoneNumber</small>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border">@o.PaymentMethod</span>
                                </td>
                                <td>
                                    @switch (o.Status)
                                    {
                                        case WebsiteBanDienThoai.Models.OrderStatus.Completed:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>
                                            break;
                                        case WebsiteBanDienThoai.Models.OrderStatus.Shipping:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Đang giao</span>
                                            break;
                                        case WebsiteBanDienThoai.Models.OrderStatus.Confirmed:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã xác nhận</span>
                                            break;
                                        case WebsiteBanDienThoai.Models.OrderStatus.Cancelled:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Chờ duyệt</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">@o.SubtotalAmount.ToString("N0")₫</td>
                                <td class="text-end text-danger">@(totalDiscount > 0 ? $"-{totalDiscount:N0}₫" : "0₫")</td>
                                <td class="text-end">@o.ShippingFee.ToString("N0")₫</td>
                                <td class="text-end fw-bold text-danger fs-6">@o.TotalAmount.ToString("N0")₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Chart.js & html2pdf.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. XỬ LÝ PRESET BUTTONS
            const presetBtns = document.querySelectorAll('.preset-btn');
            const inputPreset = document.getElementById('inputPreset');
            const filterForm = document.getElementById('filterForm');

            presetBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    inputPreset.value = this.dataset.preset;
                    filterForm.submit();
                });
            });

            // 2. VẼ BIỂU ĐỒ DOANH THU THEO THỜI GIAN (Chart.js)
            const timelineLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TimelineLabels));
            const timelineRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TimelineRevenue));
            const timelineOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TimelineOrders));

            const ctxTimeline = document.getElementById('revenueTimelineChart').getContext('2d');
            new Chart(ctxTimeline, {
                type: 'bar',
                data: {
                    labels: timelineLabels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Số lượng đơn hàng',
                            data: timelineOrders,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            borderWidth: 2,
                            tension: 0.3,
                            yAxisID: 'yOrders',
                            pointRadius: 3
                        },
                        {
                            type: 'bar',
                            label: 'Doanh thu (VNĐ)',
                            data: timelineRevenue,
                            backgroundColor: 'rgba(215, 0, 24, 0.85)',
                            borderColor: '#d70018',
                            borderRadius: 4,
                            yAxisID: 'yRevenue'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    if (context.dataset.yAxisID === 'yRevenue') {
                                        return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.raw) + '₫';
                                    } else {
                                        return 'Đơn hàng: ' + context.raw + ' đơn';
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        yRevenue: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            beginAtZero: true,
                            min: 0,
                            suggestedMax: 10000000,
                            ticks: {
                                callback: function (value) {
                                    if (value === 0) return '0đ';
                                    if (value >= 1000000) {
                                        var m = value / 1000000;
                                        return (Number.isInteger(m) ? m : m.toFixed(1)) + ' Tr';
                                    }
                                    if (value >= 1000) {
                                        var k = value / 1000;
                                        return (Number.isInteger(k) ? k : k.toFixed(0)) + 'K';
                                    }
                                    return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
                                }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        yOrders: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            beginAtZero: true,
                            min: 0,
                            suggestedMax: 5,
                            grid: { drawOnChartArea: false },
                            ticks: {
                                stepSize: 1,
                                precision: 0,
                                callback: function (value) {
                                    if (Number.isInteger(value)) return value + ' đơn';
                                    return null;
                                }
                            }
                        }
                    }
                }
            });

            // 3. VẼ BIỂU ĐỒ TRÒN CƠ CẤU DANH MỤC
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(c => c.CategoryName).ToList()));
            const catValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBreakdown.Select(c => c.Revenue).ToList()));

            const ctxCategory = document.getElementById('categoryDonutChart').getContext('2d');
            new Chart(ctxCategory, {
                type: 'doughnut',
                data: {
                    labels: catLabels.length > 0 ? catLabels : ['Chưa có dữ liệu'],
                    datasets: [{
                        data: catValues.length > 0 ? catValues : [1],
                        backgroundColor: [
                            '#d70018', '#0071e3', '#ff9800', '#10b981', '#6f42c1', '#20c997', '#fd7e14'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label + ': ' + new Intl.NumberFormat('vi-VN').format(context.raw) + '₫';
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        });

        // 4. HÀM XUẤT BÁO CÁO SANG FILE PDF (HTML2PDF)
        function exportReportToPdf() {
            if (typeof html2pdf === 'undefined') {
                alert('Đang tải thư viện PDF, vui lòng thử lại sau 2 giây...');
                return;
            }

            const element = document.getElementById('printableReportArea');
            const opt = {
                margin:       [10, 10, 10, 10],
                filename:     `BaoCaoDoanhThu_CellPhoneS_${new Date().toISOString().slice(0,10)}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            // Thông báo đang xử lý
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Đang tạo file PDF...',
                    text: 'Vui lòng chờ trong giây lát trong khi hệ thống kết xuất báo cáo doanh thu.',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            }

            html2pdf().set(opt).from(element).save().then(() => {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Xuất PDF thành công!',
                        text: 'File báo cáo doanh thu đã được tải về máy của bạn.',
                        timer: 2500,
                        showConfirmButton: false
                    });
                } else {
                    alert('Đã xuất file PDF thành công!');
                }
            }).catch(err => {
                console.error(err);
                alert('Có lỗi khi tạo file PDF. Bạn có thể sử dụng nút "Xem Bản In Chuẩn A4" để in trực tiếp.');
            });
        }
    </script>
}
