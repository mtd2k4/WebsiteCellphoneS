@model WebsiteBanDienThoai.Areas.Admin.Models.RevenueReportViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Báo Cáo Doanh Thu CellphoneS - @Model.StartDate.ToString("dd/MM/yyyy") đến @Model.EndDate.ToString("dd/MM/yyyy")</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            color: #000;
            background-color: #f8fafc;
            margin: 0;
            padding: 20px;
            font-size: 13.5px;
            line-height: 1.4;
        }

        .report-paper {
            background-color: #fff;
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-radius: 4px;
        }

        .table-report {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .table-report th, .table-report td {
            border: 1px solid #333;
            padding: 6px 8px;
        }

        .table-report th {
            background-color: #f2f2f2;
            text-align: center;
            font-weight: bold;
        }

        .report-header-title {
            text-align: center;
            margin: 25px 0 15px;
            text-transform: uppercase;
            font-weight: bold;
            font-size: 20px;
            color: #d70018;
        }

        .toolbar {
            max-width: 1000px;
            margin: 0 auto 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            padding: 12px 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        }

        @@media print {
            body {
                background: none;
                padding: 0;
            }
            .report-paper {
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            .toolbar {
                display: none !important;
            }
            .page-break {
                page-break-before: always;
            }
        }
    </style>
</head>
<body>

    <!-- THANH CÔNG CỤ IN & XUẤT PDF -->
    <div class="toolbar">
        <div>
            <strong class="text-danger fs-5">cellphone<span class="text-dark">S</span></strong>
            <span class="text-muted ms-2">| Bản In Báo Cáo Doanh Thu Chuẩn A4</span>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/RevenueReport" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Trở Về Bảng Điều Khiển
            </a>
            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> In Ngay (Print / Save as PDF)
            </button>
            <button type="button" class="btn btn-sm btn-dark fw-bold" onclick="downloadPdfFile()">
                <i class="bi bi-download me-1"></i> Tải File PDF Trực Tiếp
            </button>
        </div>
    </div>

    <!-- TỜ GIẤY BÁO CÁO A4 -->
    <div class="report-paper" id="pdfContent">
        <!-- HEADER CÔNG TY & QUỐC HIỆU -->
        <div class="row align-items-start pb-3 border-bottom border-dark">
            <div class="col-7">
                <h6 class="m-0 fw-bold text-uppercase">CÔNG TY CỔ PHẦN BÁN LẺ CELLPHONES</h6>
                <div>Mã số thuế: <strong>0107778899</strong></div>
                <div>Địa chỉ: 123 Đường Công Nghệ, Phường Bến Nghé, Quận 1, TP.HCM</div>
                <div>Hotline: 1800.2097 - Email: ketoan@cellphones.com.vn</div>
            </div>
            <div class="col-5 text-center">
                <h6 class="m-0 fw-bold text-uppercase">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h6>
                <div class="fst-italic">Độc lập - Tự do - Hạnh phúc</div>
                <div style="letter-spacing: 2px;">---------------</div>
                <div class="fst-italic small">TP. Hồ Chí Minh, ngày @DateTime.UtcNow.ToString("dd") tháng @DateTime.UtcNow.ToString("MM") năm @DateTime.UtcNow.ToString("yyyy")</div>
            </div>
        </div>

        <!-- TIÊU ĐỀ BÁO CÁO -->
        <div class="report-header-title">
            BÁO CÁO DOANH THU & KẾT QUẢ HOẠT ĐỘNG KINH DOANH
        </div>
        <div class="text-center fst-italic mb-3">
            Thời kỳ báo cáo: Từ ngày <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong> đến ngày <strong>@Model.EndDate.ToString("dd/MM/yyyy")</strong>
        </div>

        <!-- THÔNG TIN TÓM TẮT -->
        <div class="mb-3 small">
            <div>• Phương thức thanh toán xét lọc: <strong>@(Model.PaymentMethod == "all" ? "Tất cả phương thức" : Model.PaymentMethod)</strong></div>
            <div>• Trạng thái đơn xét lọc: <strong>
                @(Model.StatusFilter switch {
                    "completed" => "Đã hoàn thành",
                    "shipping" => "Đang giao hàng",
                    "pending" => "Chờ xử lý / Đã xác nhận",
                    "cancelled" => "Đã hủy",
                    "valid" => "Đơn hợp lệ (Trừ đơn hủy)",
                    _ => "Tất cả trạng thái"
                })
            </strong></div>
            <div>• Đơn vị tiền tệ: <strong>Việt Nam Đồng (VNĐ)</strong></div>
        </div>

        <!-- PHẦN I: TỔNG QUAN CHỈ SỐ KINH DOANH -->
        <h6 class="fw-bold text-uppercase mt-4 mb-2">I. TỔNG QUAN CÁC CHỈ TIÊU KINH DOANH</h6>
        <table class="table-report">
            <thead>
                <tr>
                    <th style="width: 5%;">STT</th>
                    <th style="width: 45%;">Chỉ tiêu tài chính</th>
                    <th style="width: 25%;">Giá trị</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center">1</td>
                    <td><strong>Tổng doanh thu thực thu (Net Revenue)</strong></td>
                    <td class="text-end fw-bold text-danger">@Model.TotalRevenue.ToString("N0")₫</td>
                    <td>Doanh thu sau chiết khấu + phí ship</td>
                </tr>
                <tr>
                    <td class="text-center">2</td>
                    <td>Tổng tiền hàng nguyên giá (Subtotal)</td>
                    <td class="text-end">@Model.TotalSubtotal.ToString("N0")₫</td>
                    <td>Chưa trừ mã voucher</td>
                </tr>
                <tr>
                    <td class="text-center">3</td>
                    <td>Tổng chiết khấu & mã giảm giá áp dụng</td>
                    <td class="text-end text-danger">-@Model.TotalDiscount.ToString("N0")₫</td>
                    <td>Voucher đơn hàng & trợ giá freeship</td>
                </tr>
                <tr>
                    <td class="text-center">4</td>
                    <td>Tổng cước phí vận chuyển thu</td>
                    <td class="text-end">@Model.TotalShippingFee.ToString("N0")₫</td>
                    <td>Phí giao hàng toàn quốc</td>
                </tr>
                <tr>
                    <td class="text-center">5</td>
                    <td>Tổng số lượng đơn hàng phát sinh</td>
                    <td class="text-end fw-bold">@Model.TotalOrders đơn</td>
                    <td>Hoàn tất: @Model.CompletedOrders đơn</td>
                </tr>
                <tr>
                    <td class="text-center">6</td>
                    <td>Giá trị trung bình một đơn hàng (AOV)</td>
                    <td class="text-end fw-bold">@Model.AverageOrderValue.ToString("N0")₫</td>
                    <td>Doanh thu / Tổng đơn</td>
                </tr>
                <tr>
                    <td class="text-center">7</td>
                    <td>Lợi nhuận gộp ước tính (~22%)</td>
                    <td class="text-end fw-bold text-success">@Model.EstimatedProfit.ToString("N0")₫</td>
                    <td>Biên lợi nhuận bán lẻ công nghệ</td>
                </tr>
            </tbody>
        </table>

        <!-- PHẦN II: CƠ CẤU DOANH THU THEO DANH MỤC -->
        <h6 class="fw-bold text-uppercase mt-4 mb-2">II. DOANH THU THEO PHÂN LOẠI DANH MỤC HÀNG HÓA</h6>
        <table class="table-report">
            <thead>
                <tr>
                    <th style="width: 5%;">STT</th>
                    <th>Tên danh mục sản phẩm</th>
                    <th style="width: 20%;" class="text-center">Số lượng bán (Chiếc)</th>
                    <th style="width: 25%;" class="text-end">Doanh số (VNĐ)</th>
                    <th style="width: 15%;" class="text-center">Tỷ trọng (%)</th>
                </tr>
            </thead>
            <tbody>
                @{ int catIdx = 1; }
                @foreach (var c in Model.CategoryBreakdown)
                {
                    <tr>
                        <td class="text-center">@catIdx</td>
                        <td class="fw-semibold">@c.CategoryName</td>
                        <td class="text-center">@c.TotalQuantity</td>
                        <td class="text-end fw-bold">@c.Revenue.ToString("N0")₫</td>
                        <td class="text-center">@c.Percentage%</td>
                    </tr>
                    catIdx++;
                }
            </tbody>
        </table>

        <!-- PHẦN III: CƠ CẤU THEO PHƯƠNG THỨC THANH TOÁN -->
        <h6 class="fw-bold text-uppercase mt-4 mb-2">III. DOANH THU THEO PHƯƠNG THỨC THANH TOÁN</h6>
        <table class="table-report">
            <thead>
                <tr>
                    <th style="width: 5%;">STT</th>
                    <th>Phương thức thanh toán</th>
                    <th style="width: 20%;" class="text-center">Số lượng đơn</th>
                    <th style="width: 25%;" class="text-end">Tổng tiền (VNĐ)</th>
                    <th style="width: 15%;" class="text-center">Tỷ trọng (%)</th>
                </tr>
            </thead>
            <tbody>
                @{ int payIdx = 1; }
                @foreach (var p in Model.PaymentBreakdown)
                {
                    <tr>
                        <td class="text-center">@payIdx</td>
                        <td>@p.MethodName</td>
                        <td class="text-center">@p.OrderCount</td>
                        <td class="text-end fw-bold">@p.Revenue.ToString("N0")₫</td>
                        <td class="text-center">@p.Percentage%</td>
                    </tr>
                    payIdx++;
                }
            </tbody>
        </table>

        <!-- PHẦN IV: TOP 5 SẢN PHẨM DOANH THU CAO NHẤT -->
        <h6 class="fw-bold text-uppercase mt-4 mb-2">IV. TOP SẢN PHẨM ĐÓNG GÓP DOANH THU CAO NHẤT</h6>
        <table class="table-report">
            <thead>
                <tr>
                    <th style="width: 5%;">Xếp hạng</th>
                    <th>Tên sản phẩm</th>
                    <th style="width: 20%;">Ngành hàng</th>
                    <th style="width: 15%;" class="text-center">Đã bán</th>
                    <th style="width: 25%;" class="text-end">Doanh số mang lại</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var tp in Model.TopProducts.Take(5))
                {
                    <tr>
                        <td class="text-center fw-bold">#@rank</td>
                        <td class="fw-semibold">@tp.ProductName</td>
                        <td>@tp.CategoryName</td>
                        <td class="text-center">@tp.QuantitySold</td>
                        <td class="text-end fw-bold text-danger">@tp.TotalRevenue.ToString("N0")₫</td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>

        <!-- PHẦN V: CHỮ KÝ VÀ PHÊ DUYỆT -->
        <div class="row text-center mt-5 pt-3">
            <div class="col-4">
                <div class="fw-bold text-uppercase">NGƯỜI LẬP BÁO CÁO</div>
                <div class="fst-italic small text-muted">(Ký và ghi rõ họ tên)</div>
                <div style="height: 70px;"></div>
                <div class="fw-bold">Bộ Phận Quản Trị Hệ Thống</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-uppercase">KẾ TOÁN TRƯỞNG</div>
                <div class="fst-italic small text-muted">(Ký và ghi rõ họ tên)</div>
                <div style="height: 70px;"></div>
                <div class="fw-bold">Nguyễn Thị Thanh Hằng</div>
            </div>
            <div class="col-4">
                <div class="fw-bold text-uppercase">GIÁM ĐỐC ĐIỀU HÀNH</div>
                <div class="fst-italic small text-muted">(Ký tên và đóng dấu)</div>
                <div style="height: 70px;"></div>
                <div class="fw-bold text-danger">CELLPHONES RETAIL CORP</div>
            </div>
        </div>
    </div>

    <!-- Script xuất PDF tự động -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function downloadPdfFile() {
            const element = document.getElementById('pdfContent');
            const opt = {
                margin:       [10, 10, 10, 10],
                filename:     `BaoCaoKinhDoanh_CellPhoneS_${new Date().toISOString().slice(0,10)}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
