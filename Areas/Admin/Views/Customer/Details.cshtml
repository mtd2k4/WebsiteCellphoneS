@model WebsiteBanDienThoai.Models.AppUser

@{
    ViewData["Title"] = $"Khách Hàng: {Model.FullName} - CellphoneS Admin";
    var orders = ViewBag.Orders as List<WebsiteBanDienThoai.Models.Order> ?? new();
    var tradeIns = ViewBag.TradeIns as List<WebsiteBanDienThoai.Models.TradeInRequest> ?? new();
    var reviews = ViewBag.Reviews as List<WebsiteBanDienThoai.Models.ProductReview> ?? new();
    decimal totalSpent = ViewBag.TotalSpent is decimal ts ? ts : 0m;
    var initial = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "K";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size: 13px;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Quản lý khách hàng</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold">Chi tiết khách hàng</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-person-badge-fill text-danger"></i> Hồ Sơ Khách Hàng #@Model.Id
            </h4>
            <div class="text-muted small">Chi tiết thông tin cá nhân, hạng Smember và lịch sử mua sắm tại CellphoneS</div>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách khách hàng
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN HỒ SƠ & THẺ SMEMBER (4 PHẦN) -->
    <div class="col-lg-4">
        <!-- CARD THÔNG TIN CÁ NHÂN -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="bg-danger text-white p-4 text-center" style="background: linear-gradient(135deg, #d70018 0%, #b30014 100%);">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-white text-danger fw-bold fs-2 shadow mb-2" 
                     style="width: 72px; height: 72px;">
                    @initial
                </div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
                    @if (Model.SmemberLevel == "S-VIP")
                    {
                        <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-award-fill me-1"></i> Thành Viên S-VIP
                        </span>
                    }
                    else if (Model.SmemberLevel == "S-Mem")
                    {
                        <span class="badge bg-white text-danger fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-shield-fill-check me-1"></i> Thành Viên S-Mem
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-person-fill me-1"></i> Thành Viên S-New
                        </span>
                    }

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success text-white fw-semibold rounded-pill px-2">
                            <i class="bi bi-check-circle-fill"></i> Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-dark text-white fw-semibold rounded-pill px-2">
                            <i class="bi bi-lock-fill"></i> Đã khóa
                        </span>
                    }
                </div>
            </div>

            <div class="card-body p-3 p-md-4">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-info-circle me-1 text-danger"></i> Thông Tin Liên Hệ
                </h6>

                <div class="d-flex flex-column gap-3 small">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-envelope me-2"></i>Email:</span>
                        <a href="mailto:@Model.Email" class="fw-bold text-dark text-decoration-none">@Model.Email</a>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-telephone me-2"></i>Số điện thoại:</span>
                        <a href="tel:@Model.PhoneNumber" class="fw-bold text-danger text-decoration-none">@Model.PhoneNumber</a>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Giới tính:</span>
                        <span class="fw-semibold">@(Model.Gender ?? "Chưa rõ")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>Ngày sinh:</span>
                        <span class="fw-semibold">@(Model.Birthday.HasValue ? Model.Birthday.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-geo-alt me-2"></i>Tỉnh / Thành phố:</span>
                        <span class="badge bg-light text-dark border">@(Model.Province ?? "Chưa cập nhật")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-start">
                        <span class="text-muted"><i class="bi bi-house-door me-2"></i>Địa chỉ:</span>
                        <span class="fw-semibold text-end" style="max-width: 200px;">@(Model.Address ?? "Chưa cập nhật")</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted"><i class="bi bi-clock-history me-2"></i>Ngày đăng ký:</span>
                        <span class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <!-- THẺ ĐIỂM THƯỞNG SMEMBER -->
                <div class="bg-light rounded-3 p-3 mt-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-muted fw-semibold">Điểm tích lũy Smember:</span>
                        <h5 class="fw-bold text-danger mb-0">@Model.SmemberPoints.ToString("N0") <small class="fs-6 text-muted">điểm</small></h5>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Tổng chi tiêu mua sắm:</span>
                        <span class="fw-bold text-dark">@totalSpent.ToString("N0")₫</span>
                    </div>
                </div>

                <!-- NÚT THAO TÁC NHANH -->
                <div class="d-grid gap-2 mt-4">
                    <button type="button" class="btn btn-outline-warning fw-semibold" 
                            onclick="openSmemberModal(@Model.Id, '@Model.FullName', '@Model.SmemberLevel', @Model.SmemberPoints)">
                        <i class="bi bi-stars me-1"></i> Điều Chỉnh Hạng & Điểm Smember
                    </button>

                    <button type="button" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-semibold" 
                            onclick="toggleStatus(@Model.Id, '@Model.FullName', @(Model.IsActive ? "true" : "false"))">
                        <i class="bi @(Model.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                        @(Model.IsActive ? "Khóa Tài Khoản Này" : "Mở Khóa Tài Khoản")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: LỊCH SỬ ĐƠN HÀNG, THU CŨ ĐỔI MỚI & ĐÁNH GIÁ (8 PHẦN) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-bottom p-0">
                <!-- TABS ĐIỀU HƯỚNG -->
                <ul class="nav nav-tabs border-0 px-3 pt-2" id="customerTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-danger border-0 border-bottom border-danger border-2 px-3 py-3" 
                                id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders-pane" type="button" role="tab">
                            <i class="bi bi-cart-check-fill me-1"></i> Lịch Sử Đơn Hàng (@orders.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-0 px-3 py-3" 
                                id="tradeins-tab" data-bs-toggle="tab" data-bs-target="#tradeins-pane" type="button" role="tab">
                            <i class="bi bi-arrow-repeat me-1"></i> Yêu Cầu Thu Cũ Đổi Mới (@tradeIns.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark border-0 px-3 py-3" 
                                id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab">
                            <i class="bi bi-chat-square-text me-1"></i> Đánh Giá Sản Phẩm (@reviews.Count)
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-3 p-md-4">
                <div class="tab-content" id="customerTabContent">
                    <!-- TAB 1: ĐƠN HÀNG ĐÃ MUA -->
                    <div class="tab-pane fade show active" id="orders-pane" role="tabpanel">
                        @if (!orders.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-bag-x fs-1 d-block mb-2 text-muted"></i>
                                <h6 class="fw-bold">Khách hàng chưa có đơn hàng nào trên hệ thống.</h6>
                                <p class="small text-muted mb-0">Khi khách hàng đặt hàng qua Website, các đơn hàng sẽ được hiển thị và đồng bộ tại đây.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase text-muted" style="font-size: 11px;">
                                        <tr>
                                            <th>Mã đơn</th>
                                            <th>Ngày đặt</th>
                                            <th>Sản phẩm đặt</th>
                                            <th class="text-end">Tổng tiền</th>
                                            <th class="text-center">Thanh toán</th>
                                            <th class="text-center">Trạng thái</th>
                                            <th class="text-end">Chi tiết</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in orders)
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" 
                                                       class="fw-bold text-danger text-decoration-none font-monospace">
                                                        @o.OrderCode
                                                    </a>
                                                </td>
                                                <td class="small">
                                                    <div>@o.CreatedAt.ToString("dd/MM/yyyy")</div>
                                                    <small class="text-muted">@o.CreatedAt.ToString("HH:mm")</small>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">
                                                        @o.OrderDetails.Count mặt hàng (@o.OrderDetails.Sum(d => d.Quantity) chiếc)
                                                    </span>
                                                    @if (o.OrderDetails.Any())
                                                    {
                                                        <div class="small text-muted text-truncate mt-1" style="max-width: 180px;">
                                                            @o.OrderDetails.First().Product?.Name
                                                        </div>
                                                    }
                                                </td>
                                                <td class="text-end fw-bold text-dark fs-6">
                                                    @o.TotalAmount.ToString("N0")₫
                                                </td>
                                                <td class="text-center small">
                                                    <span class="badge bg-light text-secondary border">@o.PaymentMethod</span>
                                                </td>
                                                <td class="text-center">
                                                    @if (o.Status == WebsiteBanDienThoai.Models.OrderStatus.Completed)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>
                                                    }
                                                    else if (o.Status == WebsiteBanDienThoai.Models.OrderStatus.Shipping)
                                                    {
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Đang giao</span>
                                                    }
                                                    else if (o.Status == WebsiteBanDienThoai.Models.OrderStatus.Confirmed)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã xác nhận</span>
                                                    }
                                                    else if (o.Status == WebsiteBanDienThoai.Models.OrderStatus.Cancelled)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã huỷ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Chờ xử lý</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" 
                                                       class="btn btn-sm btn-outline-danger py-0 px-2" title="Xem chi tiết đơn hàng">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- TAB 2: YÊU CẦU THU CŨ ĐỔI MỚI -->
                    <div class="tab-pane fade" id="tradeins-pane" role="tabpanel">
                        @if (!tradeIns.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-arrow-repeat fs-1 d-block mb-2 text-muted"></i>
                                <h6 class="fw-bold">Khách hàng chưa có yêu cầu thu cũ đổi mới nào.</h6>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase text-muted" style="font-size: 11px;">
                                        <tr>
                                            <th>Mã yêu cầu</th>
                                            <th>Ngày gửi</th>
                                            <th>Thiết bị cũ</th>
                                            <th>Dung lượng</th>
                                            <th>Tình trạng máy</th>
                                            <th class="text-end">Định giá tạm tính</th>
                                            <th class="text-center">Trợ giá Smember</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in tradeIns)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-danger">@t.RequestCode</td>
                                                <td class="small">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="fw-semibold">@t.OldDeviceName</td>
                                                <td><span class="badge bg-light text-dark border">@t.OldDeviceStorage</span></td>
                                                <td>Loại @t.ConditionGrade</td>
                                                <td class="text-end fw-bold text-success">@t.TotalBenefit.ToString("N0")₫</td>
                                                <td class="text-center">
                                                    @if (t.SmemberBonus > 0)
                                                    {
                                                        <span class="badge bg-warning text-dark">+@t.SmemberBonus.ToString("N0")₫</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">--</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- TAB 3: ĐÁNH GIÁ SẢN PHẨM -->
                    <div class="tab-pane fade" id="reviews-pane" role="tabpanel">
                        @if (!reviews.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-star fs-1 d-block mb-2 text-muted"></i>
                                <h6 class="fw-bold">Khách hàng chưa để lại đánh giá nào trên hệ thống.</h6>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var r in reviews)
                                {
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="fw-bold text-dark">
                                                <i class="bi bi-box-seam text-danger me-1"></i> @(r.Product?.Name ?? "Sản phẩm")
                                            </div>
                                            <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <div class="text-warning mb-2" style="font-size: 13px;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= r.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                        <p class="mb-0 small text-dark">@r.Content</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CẬP NHẬT SMEMBER -->
<div class="modal fade" id="smemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-stars me-1"></i> Điều Chỉnh Hạng & Điểm Smember
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modalCustomerId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label small text-muted">Khách hàng:</label>
                    <div class="fw-bold text-dark fs-6">@Model.FullName</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Hạng thành viên Smember:</label>
                    <select class="form-select" id="modalSmemberLevel">
                        <option value="S-New" selected="@(Model.SmemberLevel == "S-New")">S-New (Khách hàng mới)</option>
                        <option value="S-Mem" selected="@(Model.SmemberLevel == "S-Mem")">S-Mem (Thành viên thân thiết)</option>
                        <option value="S-VIP" selected="@(Model.SmemberLevel == "S-VIP")">S-VIP (Khách hàng VIP)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Số điểm tích lũy:</label>
                    <div class="input-group">
                        <input type="number" class="form-control fw-bold" id="modalSmemberPoints" value="@Model.SmemberPoints" min="0" step="10" />
                        <span class="input-group-text bg-light">Điểm</span>
                    </div>
                    <small class="text-muted">1 điểm = 1.000₫ tích lũy chi tiêu tại CellphoneS.</small>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold px-3" onclick="saveSmemberUpdate()">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleStatus(id, name, isCurrentlyActive) {
            const actionText = isCurrentlyActive ? 'khóa' : 'mở khóa';
            const actionColor = isCurrentlyActive ? '#d70018' : '#198754';

            Swal.fire({
                title: `Xác nhận ${actionText}?`,
                text: `Bạn có chắc muốn ${actionText} tài khoản của "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: actionColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: `Đồng ý ${actionText}`,
                cancelButtonText: 'Huỷ bỏ'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Customer/ToggleStatus?id=${id}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: data.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', data.message || 'Không thể thay đổi trạng thái.', 'error');
                        }
                    } catch (e) {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    }
                }
            });
        }

        let smemberModalInstance = null;
        function openSmemberModal() {
            if (!smemberModalInstance) {
                smemberModalInstance = new bootstrap.Modal(document.getElementById('smemberModal'));
            }
            smemberModalInstance.show();
        }

        async function saveSmemberUpdate() {
            const id = document.getElementById('modalCustomerId').value;
            const level = document.getElementById('modalSmemberLevel').value;
            const points = parseInt(document.getElementById('modalSmemberPoints').value) || 0;

            try {
                const res = await fetch(`/Admin/Customer/UpdateSmember?id=${id}&smemberLevel=${level}&smemberPoints=${points}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    if (smemberModalInstance) smemberModalInstance.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã cập nhật',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', data.message || 'Không thể cập nhật.', 'error');
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
            }
        }
    </script>
}
