@model IEnumerable<WebsiteBanDienThoai.Models.AppUser>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng - CellphoneS Admin";
    var orderStats = ViewBag.OrderStats as Dictionary<int, WebsiteBanDienThoai.Areas.Admin.Controllers.CustomerStatsDto> ?? new();
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : 0;
    long totalSmemberPoints = ViewBag.TotalSmemberPoints is long sp ? sp : 0;
    int totalCustomers = ViewBag.TotalCustomers is int tc ? tc : 0;
    int newCustomers = ViewBag.NewCustomersThisMonth is int nc ? nc : 0;
    int vipCustomers = ViewBag.VipCustomers is int vc ? vc : 0;
    int activeCustomers = ViewBag.ActiveCustomers is int ac ? ac : 0;
    int lockedCustomers = ViewBag.LockedCustomers is int lc ? lc : 0;
    string curSearch = ViewBag.CurrentSearch as string ?? "";
    string curLevel = ViewBag.CurrentSmemberLevel as string ?? "";
    bool? curActive = ViewBag.CurrentIsActive as bool?;
    string curProv = ViewBag.CurrentProvince as string ?? "";
    string curSort = ViewBag.CurrentSortBy as string ?? "newest";
}

<!-- TIÊU ĐỀ & BREADCRUMB -->
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size: 13px;">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active text-danger fw-semibold">Khách hàng Smember</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-danger"></i> Quản Lý Khách Hàng Thành Viên
            </h4>
            <div class="text-muted small">Danh sách người dùng đã đăng ký tài khoản tham gia hệ thống CellphoneS & Smember</div>
        </div>
        <div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6 rounded-pill fw-semibold">
                <i class="bi bi-person-check-fill me-1"></i> @totalCustomers khách hàng đăng ký
            </span>
        </div>
    </div>
</div>

<!-- 4 THẺ THỐNG KÊ KPI KHÁCH HÀNG -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Tổng khách đăng ký</span>
                    <h4 class="fw-bold text-dark mb-0">@totalCustomers</h4>
                    <span class="text-success small fw-semibold" style="font-size: 11.5px;">
                        <i class="bi bi-check-circle me-1"></i>@activeCustomers đang hoạt động
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Khách mới tháng này</span>
                    <h4 class="fw-bold text-success mb-0">+@newCustomers</h4>
                    <span class="text-muted small" style="font-size: 11.5px;">Thành viên đăng ký mới</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning-emphasis p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-award-fill text-warning"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Thành viên S-VIP</span>
                    <h4 class="fw-bold text-warning mb-0">@vipCustomers</h4>
                    <span class="text-muted small" style="font-size: 11.5px;">Đặc quyền ưu đãi VIP</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                    <i class="bi bi-stars"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold d-block">Tổng điểm Smember</span>
                    <h4 class="fw-bold text-primary mb-0">@totalSmemberPoints.ToString("N0")</h4>
                    <span class="text-danger small fw-semibold" style="font-size: 11.5px;">
                        <i class="bi bi-slash-circle me-1"></i>@lockedCustomers tài khoản khóa
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KHUNG TÌM KIẾM & BỘ LỌC DỮ LIỆU -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index">
            <div class="row g-2 align-items-center">
                <!-- Tìm kiếm theo từ khóa -->
                <div class="col-lg-4 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" 
                               placeholder="Tìm theo họ tên, email, số điện thoại..." 
                               value="@curSearch" />
                    </div>
                </div>

                <!-- Lọc theo hạng thành viên -->
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <select name="smemberLevel" class="form-select">
                        <option value="All" selected="@(curLevel == "All" || string.IsNullOrEmpty(curLevel))">-- Hạng Smember --</option>
                        <option value="S-New" selected="@(curLevel == "S-New")">S-New (Mới)</option>
                        <option value="S-Mem" selected="@(curLevel == "S-Mem")">S-Mem (Thân thiết)</option>
                        <option value="S-VIP" selected="@(curLevel == "S-VIP")">S-VIP (Đặc quyền)</option>
                    </select>
                </div>

                <!-- Lọc theo trạng thái tài khoản -->
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <select name="isActive" class="form-select">
                        <option value="" selected="@(!curActive.HasValue)">-- Trạng thái --</option>
                        <option value="true" selected="@(curActive == true)">Hoạt động</option>
                        <option value="false" selected="@(curActive == false)">Đã bị khóa</option>
                    </select>
                </div>

                <!-- Lọc theo Tỉnh/Thành -->
                <div class="col-lg-2 col-md-4 col-sm-6">
                    <select name="province" class="form-select">
                        <option value="All" selected="@(curProv == "All" || string.IsNullOrEmpty(curProv))">-- Khu vực --</option>
                        <option value="Hồ Chí Minh" selected="@(curProv == "Hồ Chí Minh")">Hồ Chí Minh</option>
                        <option value="Hà Nội" selected="@(curProv == "Hà Nội")">Hà Nội</option>
                        <option value="Đà Nẵng" selected="@(curProv == "Đà Nẵng")">Đà Nẵng</option>
                        <option value="Cần Thơ" selected="@(curProv == "Cần Thơ")">Cần Thơ</option>
                        <option value="Hải Phòng" selected="@(curProv == "Hải Phòng")">Hải Phòng</option>
                        <option value="Bình Dương" selected="@(curProv == "Bình Dương")">Bình Dương</option>
                        <option value="Đồng Nai" selected="@(curProv == "Đồng Nai")">Đồng Nai</option>
                    </select>
                </div>

                <!-- Sắp xếp & Nút lọc -->
                <div class="col-lg-2 col-md-8 col-sm-6 d-flex gap-1">
                    <select name="sortBy" class="form-select">
                        <option value="newest" selected="@(curSort == "newest")">Mới nhất</option>
                        <option value="oldest" selected="@(curSort == "oldest")">Cũ nhất</option>
                        <option value="points_desc" selected="@(curSort == "points_desc")">Điểm tích lũy cao</option>
                        <option value="name_asc" selected="@(curSort == "name_asc")">Tên A-Z</option>
                    </select>
                    <button type="submit" class="btn btn-danger fw-bold px-3" title="Áp dụng bộ lọc">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-2" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH KHÁCH HÀNG THÀNH VIÊN -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table text-danger me-1"></i> Danh Sách Khách Hàng (@totalItems kết quả)
        </h6>
        <span class="small text-muted">Hiển thị trang @currentPage / @totalPages</span>
    </div>

    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                <h6 class="fw-bold">Không tìm thấy khách hàng nào phù hợp với điều kiện tìm kiếm.</h6>
                <p class="small text-muted mb-0">Thử tìm kiếm với từ khóa khác hoặc bấm nút làm mới bộ lọc.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted" style="font-size: 11.5px;">
                        <tr>
                            <th style="width: 50px;" class="ps-3">#ID</th>
                            <th style="min-width: 200px;">Khách hàng</th>
                            <th style="min-width: 180px;">Liên hệ</th>
                            <th>Khu vực / Địa chỉ</th>
                            <th class="text-center">Hạng & Điểm Smember</th>
                            <th class="text-center">Đơn hàng / Chi tiêu</th>
                            <th>Ngày tham gia</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-3" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var stats = orderStats.ContainsKey(user.Id) ? orderStats[user.Id] : new WebsiteBanDienThoai.Areas.Admin.Controllers.CustomerStatsDto();
                            var initial = !string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "K";

                            <tr id="customer-row-@user.Id">
                                <td class="ps-3 text-muted font-monospace small">#@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm flex-shrink-0" 
                                             style="width: 38px; height: 38px; background: linear-gradient(135deg, #d70018 0%, #ff5e62 100%); font-size: 14px;">
                                            @initial
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@user.Id" class="fw-bold text-dark text-decoration-none d-block hover-danger">
                                                @user.FullName
                                            </a>
                                            <div class="small text-muted" style="font-size: 11px;">
                                                <i class="bi bi-gender-ambiguous me-1"></i>@(user.Gender ?? "Khách")
                                                @if (user.Birthday.HasValue)
                                                {
                                                    <span> • @user.Birthday.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <a href="mailto:@user.Email" class="text-decoration-none text-dark small d-block">
                                            <i class="bi bi-envelope-at text-muted me-1"></i>@user.Email
                                        </a>
                                        <a href="tel:@user.PhoneNumber" class="text-decoration-none fw-semibold text-danger small d-block">
                                            <i class="bi bi-telephone-fill me-1"></i>@user.PhoneNumber
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border small fw-normal">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(user.Province ?? "Chưa cập nhật")
                                    </span>
                                    @if (!string.IsNullOrEmpty(user.Address))
                                    {
                                        <div class="small text-muted text-truncate mt-1" style="max-width: 220px;" title="@user.Address">
                                            @user.Address
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.SmemberLevel == "S-VIP")
                                    {
                                        <span class="badge bg-warning text-dark border border-warning-subtle fw-bold px-2 py-1">
                                            <i class="bi bi-award-fill me-1"></i> S-VIP
                                        </span>
                                    }
                                    else if (user.SmemberLevel == "S-Mem")
                                    {
                                        <span class="badge bg-danger text-white fw-bold px-2 py-1">
                                            <i class="bi bi-shield-fill-check me-1"></i> S-Mem
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white fw-bold px-2 py-1">
                                            <i class="bi bi-person-fill me-1"></i> S-New
                                        </span>
                                    }
                                    <div class="fw-bold text-danger small mt-1" id="points-display-@user.Id">
                                        @user.SmemberPoints.ToString("N0") <small class="text-muted fw-normal">điểm</small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-semibold">
                                        @stats.OrderCount đơn hàng
                                    </span>
                                    <div class="small fw-bold text-dark mt-1">
                                        @stats.TotalSpent.ToString("N0")₫
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark">@user.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted" style="font-size: 11px;">@user.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td class="text-center" id="status-cell-@user.Id">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                                            <i class="bi bi-lock-fill me-1"></i> Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Xem chi tiết hồ sơ & đơn hàng">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-warning" title="Chỉnh sửa hạng & điểm Smember" 
                                                onclick="openSmemberModal(@user.Id, '@user.FullName', '@user.SmemberLevel', @user.SmemberPoints)">
                                            <i class="bi bi-stars"></i>
                                        </button>
                                        <button type="button" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                                id="btn-toggle-@user.Id"
                                                title="@(user.IsActive ? "Khóa tài khoản này" : "Mở khóa tài khoản này")"
                                                onclick="toggleCustomerStatus(@user.Id, '@user.FullName', @(user.IsActive ? "true" : "false"))">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PHÂN TRANG -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">
                    <small class="text-muted">Đang xem trang @currentPage / @totalPages (Tổng @totalItems khách hàng)</small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(currentPage - 1)" 
                               asp-route-search="@curSearch" 
                               asp-route-smemberLevel="@curLevel" 
                               asp-route-isActive="@curActive" 
                               asp-route-province="@curProv" 
                               asp-route-sortBy="@curSort">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@p" 
                                   asp-route-search="@curSearch" 
                                   asp-route-smemberLevel="@curLevel" 
                                   asp-route-isActive="@curActive" 
                                   asp-route-province="@curProv" 
                                   asp-route-sortBy="@curSort">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(currentPage + 1)" 
                               asp-route-search="@curSearch" 
                               asp-route-smemberLevel="@curLevel" 
                               asp-route-isActive="@curActive" 
                               asp-route-province="@curProv" 
                               asp-route-sortBy="@curSort">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
    </div>
</div>

<!-- MODAL CẬP NHẬT HẠNG & ĐIỂM SMEMBER -->
<div class="modal fade" id="smemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-stars me-1"></i> Điều Chỉnh Hạng & Điểm Smember
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="modalCustomerId" />
                <div class="mb-3">
                    <label class="form-label small text-muted">Khách hàng:</label>
                    <div class="fw-bold text-dark fs-6" id="modalCustomerName">--</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Hạng thành viên Smember:</label>
                    <select class="form-select" id="modalSmemberLevel">
                        <option value="S-New">S-New (Khách hàng mới)</option>
                        <option value="S-Mem">S-Mem (Thành viên thân thiết)</option>
                        <option value="S-VIP">S-VIP (Khách hàng VIP)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Số điểm tích lũy:</label>
                    <div class="input-group">
                        <input type="number" class="form-control fw-bold" id="modalSmemberPoints" min="0" step="10" />
                        <span class="input-group-text bg-light">Điểm</span>
                    </div>
                    <small class="text-muted">1 điểm = 1.000₫ tích lũy chi tiêu tại CellphoneS.</small>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold px-3" onclick="saveSmemberUpdate()">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Khóa / Mở khóa tài khoản khách hàng
        function toggleCustomerStatus(id, name, isCurrentlyActive) {
            const actionText = isCurrentlyActive ? 'khóa' : 'mở khóa';
            const actionColor = isCurrentlyActive ? '#d70018' : '#198754';

            Swal.fire({
                title: `Xác nhận ${actionText}?`,
                text: `Bạn có chắc muốn ${actionText} tài khoản của khách hàng "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: actionColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: `Đồng ý ${actionText}`,
                cancelButtonText: 'Huỷ bỏ'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Customer/ToggleStatus?id=${id}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();

                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: data.message,
                                timer: 1800,
                                showConfirmButton: false
                            });

                            // Cập nhật DOM
                            const statusCell = document.getElementById(`status-cell-${id}`);
                            const btn = document.getElementById(`btn-toggle-${id}`);

                            if (data.isActive) {
                                statusCell.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Hoạt động</span>`;
                                btn.className = 'btn btn-outline-danger';
                                btn.title = 'Khóa tài khoản này';
                                btn.innerHTML = '<i class="bi bi-lock"></i>';
                                btn.setAttribute('onclick', `toggleCustomerStatus(${id}, '${name}', true)`);
                            } else {
                                statusCell.innerHTML = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold"><i class="bi bi-lock-fill me-1"></i> Đã khóa</span>`;
                                btn.className = 'btn btn-outline-success';
                                btn.title = 'Mở khóa tài khoản này';
                                btn.innerHTML = '<i class="bi bi-unlock"></i>';
                                btn.setAttribute('onclick', `toggleCustomerStatus(${id}, '${name}', false)`);
                            }
                        } else {
                            Swal.fire('Lỗi', data.message || 'Không thể thay đổi trạng thái.', 'error');
                        }
                    } catch (err) {
                        Swal.fire('Lỗi', 'Có lỗi kết nối đến máy chủ.', 'error');
                    }
                }
            });
        }

        // 2. Mở Modal cập nhật Hạng & Điểm
        let smemberModalInstance = null;
        function openSmemberModal(id, name, level, points) {
            document.getElementById('modalCustomerId').value = id;
            document.getElementById('modalCustomerName').innerText = name;
            document.getElementById('modalSmemberLevel').value = level || 'S-New';
            document.getElementById('modalSmemberPoints').value = points || 0;

            if (!smemberModalInstance) {
                smemberModalInstance = new bootstrap.Modal(document.getElementById('smemberModal'));
            }
            smemberModalInstance.show();
        }

        // 3. Lưu cập nhật Hạng & Điểm
        async function saveSmemberUpdate() {
            const id = document.getElementById('modalCustomerId').value;
            const level = document.getElementById('modalSmemberLevel').value;
            const points = parseInt(document.getElementById('modalSmemberPoints').value) || 0;

            try {
                const res = await fetch(`/Admin/Customer/UpdateSmember?id=${id}&smemberLevel=${level}&smemberPoints=${points}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    if (smemberModalInstance) smemberModalInstance.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã cập nhật',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', data.message || 'Không thể cập nhật.', 'error');
                }
            } catch (err) {
                Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
            }
        }
    </script>
}
