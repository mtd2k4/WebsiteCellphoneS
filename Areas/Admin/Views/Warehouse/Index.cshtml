@model IEnumerable<WebsiteBanDienThoai.Models.WarehouseReceipt>
@{
    ViewData["Title"] = "Quản Lý Kho Hàng & Nhập Kho";
    var activeTab = (string)ViewBag.ActiveTab;
    var productList = ViewBag.ProductList as List<WebsiteBanDienThoai.Models.Product>;
    var inventoryLogs = ViewBag.InventoryLogs as List<WebsiteBanDienThoai.Models.InventoryLog>;
}

<!-- TIÊU ĐỀ & NÚT TÁC VỤ -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size: 13px;">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active text-danger fw-semibold">Kho hàng</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-building-fill-check text-danger"></i> Quản Lý Kho Hàng & Nhập Kho
        </h4>
        <div class="text-muted small mt-1">Quản lý tồn kho thực tế, lập phiếu nhập hàng từ nhà cung cấp và theo dõi lịch sử biến động kho</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Warehouse" asp-action="Create" class="btn btn-danger fw-bold shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Tạo Phiếu Nhập Hàng
        </a>
    </div>
</div>

<!-- THỐNG KÊ 4 THẺ TỔNG QUAN KHO -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-danger">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số lượng tồn</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@(((int)ViewBag.TotalStockCount).ToString("N0"))</h3>
                    <small class="text-muted" style="font-size: 12px;">trên @ViewBag.TotalProducts mã sản phẩm</small>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Giá trị tồn kho ước tính</span>
                    <h4 class="fw-bold text-primary mb-0 mt-1">@(((decimal)ViewBag.TotalInventoryValue).ToString("N0"))₫</h4>
                    <small class="text-muted" style="font-size: 12px;">theo giá niêm yết hiện tại</small>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Cảnh báo tồn kho</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.LowStockCount</h3>
                    <small class="text-danger fw-semibold" style="font-size: 12px;">@ViewBag.OutOfStockCount mã đã hết hàng (0)</small>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100 p-3 bg-white border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Phiếu nhập kho</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@ViewBag.TotalReceiptsCount</h3>
                    <small class="text-muted" style="font-size: 12px;">giao dịch nhập hàng đã ghi nhận</small>
                </div>
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-file-earmark-arrow-down-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- THANH ĐIỀU HƯỚNG TABS -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-bottom p-0">
        <ul class="nav nav-tabs border-0 px-3 pt-2">
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold @(activeTab == "receipts" ? "active border-bottom-0 text-danger border-top border-start border-end" : "")" 
                   asp-action="Index" asp-route-tab="receipts">
                    <i class="bi bi-receipt me-1"></i> Danh Sách Phiếu Nhập Kho (@ViewBag.TotalReceiptsCount)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold @(activeTab == "inventory" ? "active border-bottom-0 text-danger border-top border-start border-end" : "")" 
                   asp-action="Index" asp-route-tab="inventory">
                    <i class="bi bi-box-seam me-1"></i> Tồn Kho Sản Phẩm Thực Tế (@ViewBag.TotalProducts)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold @(activeTab == "logs" ? "active border-bottom-0 text-danger border-top border-start border-end" : "")" 
                   asp-action="Index" asp-route-tab="logs">
                    <i class="bi bi-clock-history me-1"></i> Sổ Thẻ Kho & Lịch Sử Biến Động
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body p-3 p-md-4">
        <!-- ======================================================== -->
        <!-- TAB 1: DANH SÁCH PHIẾU NHẬP KHO -->
        <!-- ======================================================== -->
        @if (activeTab == "receipts")
        {
            <!-- BỘ LỌC TÌM KIẾM -->
            <form method="get" asp-action="Index" class="mb-4">
                <input type="hidden" name="tab" value="receipts" />
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" 
                                   placeholder="Tìm kiếm mã phiếu, nhà cung cấp, người lập..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white small text-muted">Từ:</span>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white small text-muted">Đến:</span>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                        </div>
                    </div>
                    <div class="col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-danger w-100 fw-bold" title="Lọc dữ liệu">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <a asp-action="Index" asp-route-tab="receipts" class="btn btn-outline-secondary" title="Xóa lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>

            <!-- BẢNG PHIẾU NHẬP -->
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                    <h6 class="text-muted fw-bold">Chưa có phiếu nhập kho nào phù hợp.</h6>
                    <p class="small text-muted mb-3">Tạo phiếu nhập mới để nhập hàng từ nhà phân phối và cập nhật tồn kho.</p>
                    <a asp-action="Create" class="btn btn-sm btn-danger fw-bold">
                        <i class="bi bi-plus-circle me-1"></i> Tạo phiếu nhập ngay
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted" style="font-size: 11.5px;">
                            <tr>
                                <th style="width: 140px;">Mã phiếu</th>
                                <th>Nhà cung cấp</th>
                                <th>Ngày nhập</th>
                                <th>Người lập</th>
                                <th class="text-center">Số mặt hàng</th>
                                <th class="text-end">Tổng tiền nhập</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-3" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-danger text-decoration-none font-monospace">
                                            @item.ReceiptCode
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.SupplierName</div>
                                        @if (!string.IsNullOrEmpty(item.SupplierPhone))
                                        {
                                            <small class="text-muted" style="font-size: 11px;"><i class="bi bi-telephone me-1"></i>@item.SupplierPhone</small>
                                        }
                                    </td>
                                    <td>
                                        <div>@item.ImportDate.ToString("dd/MM/yyyy HH:mm")</div>
                                        <small class="text-muted" style="font-size: 11px;">@item.ImportDate.ToString("dddd")</small>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(item.CreatedBy ?? "Admin")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @item.Details.Count mặt hàng (@item.Details.Sum(d => d.Quantity) chiếc)
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-dark fs-6">
                                        @item.TotalAmount.ToString("N0")₫
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Completed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                                <i class="bi bi-check2-circle me-1"></i> Đã nhập kho
                                            </span>
                                        }
                                        else if (item.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Draft)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold">
                                                <i class="bi bi-file-earmark me-1"></i> Bản nháp
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                                                <i class="bi bi-x-circle me-1"></i> Đã huỷ
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-1 px-2" title="Xem chi tiết phiếu nhập">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        @if (item.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Completed)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" title="Huỷ phiếu nhập & trừ tồn kho" onclick="confirmCancelReceipt(@item.Id, '@item.ReceiptCode')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- PHÂN TRANG -->
                @if (ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <small class="text-muted">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</small>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= ViewBag.TotalPages; p++)
                            {
                                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-tab="receipts" asp-route-page="@p" asp-route-search="@ViewBag.CurrentSearch" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@p</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
        <!-- ======================================================== -->
        <!-- TAB 2: TỒN KHO THỰC TẾ THEO SẢN PHẨM -->
        <!-- ======================================================== -->
        @if (activeTab == "inventory")
        {
            <form method="get" asp-action="Index" class="mb-4">
                <input type="hidden" name="tab" value="inventory" />
                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" 
                                   placeholder="Tìm kiếm sản phẩm, thương hiệu..." value="@ViewBag.CurrentSearch" />
                            <button type="submit" class="btn btn-danger fw-bold">Tìm kiếm</button>
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <span class="badge bg-light text-dark border p-2">
                            <i class="bi bi-info-circle text-primary me-1"></i> Số lượng sản phẩm hoàn toàn phụ thuộc vào việc <b>Nhập hàng</b> và <b>Bán hàng</b>, không thể chỉnh sửa thủ công.
                        </span>
                    </div>
                </div>
            </form>

            @if (productList == null || !productList.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-box fs-1 d-block mb-2"></i>
                    Không tìm thấy sản phẩm nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted" style="font-size: 11.5px;">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th style="width: 70px;">Ảnh</th>
                                <th>Sản phẩm</th>
                                <th>Danh mục / Hãng</th>
                                <th>Biến thể & Tồn kho chi tiết</th>
                                <th class="text-center">Tổng tồn kho</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end pe-3" style="width: 160px;">Tác vụ kho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in productList)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@p.Id</td>
                                    <td>
                                        <img src="@p.ImageUrl" alt="@p.Name" style="width: 48px; height: 48px; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 6px; padding: 2px;" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@p.Name</div>
                                        <div class="text-danger small fw-semibold">@p.SalePrice.ToString("N0")₫</div>
                                    </td>
                                    <td>
                                        <div><span class="badge bg-light text-dark border">@(p.Category?.Name ?? "Chưa rõ")</span></div>
                                        <small class="text-muted">@(p.Brand?.Name ?? "N/A")</small>
                                    </td>
                                    <td>
                                        @if (p.Variants != null && p.Variants.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var v in p.Variants)
                                                {
                                                    <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1" style="font-size: 11px;">
                                                        <span class="rounded-circle" style="width: 10px; height: 10px; background-color: @(string.IsNullOrEmpty(v.ColorHex) ? "#000" : v.ColorHex); border: 1px solid #cbd5e1;"></span>
                                                        <strong>@v.ColorName</strong> (@v.Storage): 
                                                        <span class="badge @(v.StockQuantity > 10 ? "bg-success" : (v.StockQuantity > 0 ? "bg-warning text-dark" : "bg-danger"))" style="font-size: 10px;">
                                                            @v.StockQuantity
                                                        </span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Không có biến thể (Sản phẩm tiêu chuẩn)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="fs-5 fw-bold @(p.StockQuantity > 20 ? "text-success" : (p.StockQuantity > 0 ? "text-warning" : "text-danger"))">
                                            @p.StockQuantity
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (p.StockQuantity > 20)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Còn hàng</span>
                                        }
                                        else if (p.StockQuantity > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Sắp hết hàng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Hết hàng</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Create" asp-route-productId="@p.Id" class="btn btn-sm btn-outline-danger py-1 px-2 fw-semibold d-inline-flex align-items-center gap-1" title="Tạo phiếu nhập hàng ngay cho sản phẩm này">
                                            <i class="bi bi-box-arrow-in-down"></i> Nhập Hàng
                                        </a>
                                        <a asp-controller="Product" asp-action="Variants" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Xem danh sách biến thể">
                                            <i class="bi bi-diagram-3"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <small class="text-muted">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</small>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= ViewBag.TotalPages; p++)
                            {
                                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-tab="inventory" asp-route-page="@p" asp-route-search="@ViewBag.CurrentSearch">@p</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
        <!-- ======================================================== -->
        <!-- TAB 3: SỔ THẺ KHO & LỊCH SỬ BIẾN ĐỘNG -->
        <!-- ======================================================== -->
        @if (activeTab == "logs")
        {
            <form method="get" asp-action="Index" class="mb-4">
                <input type="hidden" name="tab" value="logs" />
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" 
                                   placeholder="Tìm kiếm sản phẩm, mã chứng từ, ghi chú..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white small text-muted">Từ ngày:</span>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white small text-muted">Đến ngày:</span>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                        </div>
                    </div>
                    <div class="col-md-1 d-flex gap-1">
                        <button type="submit" class="btn btn-danger w-100 fw-bold" title="Lọc dữ liệu">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <a asp-action="Index" asp-route-tab="logs" class="btn btn-outline-secondary" title="Xóa lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>

            @if (inventoryLogs == null || !inventoryLogs.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                    Chưa có dữ liệu biến động kho nào được ghi nhận.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted" style="font-size: 11.5px;">
                            <tr>
                                <th style="width: 140px;">Thời gian</th>
                                <th>Sản phẩm / Biến thể</th>
                                <th class="text-center">Loại giao dịch</th>
                                <th class="text-center">Thay đổi (+/-)</th>
                                <th class="text-center">Tồn trước</th>
                                <th class="text-center">Tồn sau</th>
                                <th>Mã chứng từ</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in inventoryLogs)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@log.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted" style="font-size: 11px;">@log.CreatedAt.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@(log.Product?.Name ?? "Sản phẩm #" + log.ProductId)</div>
                                        @if (log.ProductVariant != null)
                                        {
                                            <span class="badge bg-light text-primary border" style="font-size: 11px;">
                                                @log.ProductVariant.ColorName - @log.ProductVariant.Storage
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (log.ChangeType == "Import")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-box-arrow-in-down me-1"></i> Nhập kho
                                            </span>
                                        }
                                        else if (log.ChangeType == "Sale")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-cart-dash-fill me-1"></i> Bán hàng
                                            </span>
                                        }
                                        else if (log.ChangeType == "Return")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <i class="bi bi-arrow-return-left me-1"></i> Huỷ đơn hoàn tồn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">
                                                <i class="bi bi-sliders me-1"></i> @log.ChangeType
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold fs-6">
                                        @if (log.QuantityChange > 0)
                                        {
                                            <span class="text-success">+@log.QuantityChange</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@log.QuantityChange</span>
                                        }
                                    </td>
                                    <td class="text-center text-muted">@log.StockBefore</td>
                                    <td class="text-center fw-bold text-dark">@log.StockAfter</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.ReferenceCode))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace">@log.ReferenceCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(log.Note ?? "--")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <small class="text-muted">Trang @ViewBag.CurrentPage / @ViewBag.TotalPages</small>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= ViewBag.TotalPages; p++)
                            {
                                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-tab="logs" asp-route-page="@p" asp-route-search="@ViewBag.CurrentSearch" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@p</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmCancelReceipt(receiptId, code) {
            Swal.fire({
                title: 'Huỷ phiếu nhập kho?',
                text: `Bạn có chắc muốn huỷ phiếu nhập "${code}"? Số lượng tồn kho tương ứng sẽ được trừ lại tự động!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d70018',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý huỷ',
                cancelButtonText: 'Không'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Warehouse/CancelReceipt/${receiptId}`, {
                            method: 'POST'
                        });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Thành công', data.message, 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    } catch (err) {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    }
                }
            });
        }
    </script>
}
