@model WebsiteBanDienThoai.Models.WarehouseReceipt
@{
    ViewData["Title"] = "Chi Tiết Phiếu Nhập Kho: " + Model.ReceiptCode;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 d-print-none">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size: 13px;">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Warehouse" asp-action="Index">Kho hàng</a></li>
                <li class="breadcrumb-item active text-danger fw-semibold">Chi tiết phiếu nhập</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-text-fill text-danger"></i> Phiếu Nhập Kho: <span class="font-monospace text-danger">@Model.ReceiptCode</span>
        </h4>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <button type="button" class="btn btn-outline-dark btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In phiếu nhập
        </button>
        <a asp-action="Create" class="btn btn-danger btn-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Tạo phiếu mới
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-4">
        <!-- HEADER PHIẾU NHẬP (CHUẨN IN ẤN VÀ HIỂN THỊ) -->
        <div class="row align-items-center pb-3 mb-4 border-bottom">
            <div class="col-sm-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="bg-danger text-white rounded px-2 py-1 fw-bold fs-6">CellphoneS</span>
                    <h5 class="fw-bold text-dark mb-0">HỆ THỐNG BÁN LẺ CÔNG NGHỆ CELLPHONES</h5>
                </div>
                <div class="text-muted small">Địa chỉ: 213 Trần Quang Khải, P. Tân Định, Quận 1, TP. Hồ Chí Minh</div>
                <div class="text-muted small">Hotline: 1800.2097 | Email: cskh@cellphones.com.vn</div>
            </div>
            <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                <div class="d-inline-block text-start text-sm-end">
                    <span class="badge @(Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Completed ? "bg-success" : (Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Draft ? "bg-warning text-dark" : "bg-danger")) fs-6 px-3 py-2 mb-2">
                        @(Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Completed ? "ĐÃ NHẬP KHO THÀNH CÔNG" : (Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Draft ? "BẢN NHÁP (CHƯA VÀO KHO)" : "PHIẾU ĐÃ HUỶ"))
                    </span>
                    <div class="font-monospace fw-bold fs-5 text-dark">Số: @Model.ReceiptCode</div>
                    <div class="text-muted small">Ngày lập: @Model.ImportDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- THÔNG TIN NHÀ CUNG CẤP & NGƯỜI LẬP -->
        <div class="row g-3 mb-4 p-3 bg-light rounded-3">
            <div class="col-md-6">
                <h6 class="fw-bold text-danger text-uppercase small mb-2"><i class="bi bi-truck me-1"></i> Nhà Cung Cấp</h6>
                <div class="fw-bold text-dark fs-6">@Model.SupplierName</div>
                @if (!string.IsNullOrEmpty(Model.SupplierPhone))
                {
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i> Điện thoại: @Model.SupplierPhone</div>
                }
                @if (!string.IsNullOrEmpty(Model.SupplierAddress))
                {
                    <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i> Địa chỉ: @Model.SupplierAddress</div>
                }
            </div>

            <div class="col-md-6 border-start-md">
                <h6 class="fw-bold text-primary text-uppercase small mb-2"><i class="bi bi-person-badge me-1"></i> Người Tiếp Nhận & Ghi Chú</h6>
                <div>Người lập phiếu: <strong>@(Model.CreatedBy ?? "Quản Trị Viên")</strong></div>
                <div>Thời gian ghi nhận: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="text-muted small mt-1"><i class="bi bi-card-text me-1"></i> Ghi chú: <em>@Model.Note</em></div>
                }
            </div>
        </div>

        <!-- BẢNG CHI TIẾT CÁC MẶT HÀNG -->
        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-list-check text-danger me-1"></i> Danh Sách Hàng Hoá Trong Phiếu</h6>
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted" style="font-size: 11.5px;">
                    <tr>
                        <th style="width: 45px;" class="text-center">STT</th>
                        <th style="width: 60px;" class="text-center">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Biến thể (Màu sắc / Dung lượng)</th>
                        <th class="text-center" style="width: 110px;">Số lượng nhập</th>
                        <th class="text-end" style="width: 150px;">Đơn giá nhập</th>
                        <th class="text-end" style="width: 170px;">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var d in Model.Details)
                    {
                        <tr>
                            <td class="text-center text-muted fw-bold">@(idx++)</td>
                            <td class="text-center">
                                <img src="@(d.ProductVariant?.ImageUrl ?? d.Product?.ImageUrl ?? "/images/default-phone.png")" 
                                     alt="@(d.Product?.Name)" 
                                     style="width: 42px; height: 42px; object-fit: contain; border: 1px solid #e2e8f0; border-radius: 4px; padding: 1px;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(d.Product?.Name ?? "Sản phẩm #" + d.ProductId)</div>
                                <small class="text-muted" style="font-size: 11px;">Mã SP: #@d.ProductId</small>
                            </td>
                            <td>
                                @if (d.ProductVariant != null)
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="rounded-circle" style="width: 12px; height: 12px; background-color: @(d.ProductVariant.ColorHex ?? "#000"); border: 1px solid #cbd5e1;"></span>
                                        <strong>@d.ProductVariant.ColorName</strong> - @d.ProductVariant.Storage
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(d.VariantInfo))
                                {
                                    <span>@d.VariantInfo</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Tiêu chuẩn</span>
                                }
                            </td>
                            <td class="text-center fw-bold fs-6 text-danger">
                                +@d.Quantity
                            </td>
                            <td class="text-end">
                                @d.ImportPrice.ToString("N0")₫
                            </td>
                            <td class="text-end fw-bold text-dark fs-6">
                                @d.TotalPrice.ToString("N0")₫
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-bold text-uppercase">Tổng cộng số lượng & tiền hàng:</td>
                        <td class="text-center fw-bold text-danger fs-5">+@Model.Details.Sum(d => d.Quantity)</td>
                        <td></td>
                        <td class="text-end fw-bold text-danger fs-4">@Model.TotalAmount.ToString("N0")₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- PHẦN KÝ NHẬN (KHI IN PHIẾU) -->
        <div class="row text-center mt-5 pt-3 d-none d-print-flex">
            <div class="col-4">
                <div class="fw-bold">Người giao hàng</div>
                <small class="text-muted">(Ký và ghi rõ họ tên)</small>
                <div style="height: 70px;"></div>
            </div>
            <div class="col-4">
                <div class="fw-bold">Thủ kho tiếp nhận</div>
                <small class="text-muted">(Ký và ghi rõ họ tên)</small>
                <div style="height: 70px;"></div>
            </div>
            <div class="col-4">
                <div class="fw-bold">Kế toán / Giám đốc duyệt</div>
                <small class="text-muted">(Ký và ghi rõ họ tên)</small>
                <div style="height: 70px;"></div>
            </div>
        </div>

        <!-- CÁC NÚT THAO TÁC DUYỆT / HUỶ -->
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top d-print-none">
            @if (Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Draft)
            {
                <button type="button" class="btn btn-success fw-bold px-4" onclick="confirmCompleteDraft(@Model.Id)">
                    <i class="bi bi-check-circle-fill me-1"></i> Xác Nhận Nhập Kho Ngay (+ Tồn kho)
                </button>
            }
            else if (Model.Status == WebsiteBanDienThoai.Models.ReceiptStatus.Completed)
            {
                <button type="button" class="btn btn-outline-danger fw-semibold" onclick="confirmCancel(@Model.Id)">
                    <i class="bi bi-x-circle me-1"></i> Huỷ Phiếu Nhập & Hoàn Tồn Kho
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmCompleteDraft(id) {
            Swal.fire({
                title: 'Xác nhận nhập kho?',
                text: 'Hệ thống sẽ cập nhật tăng số lượng tồn kho cho các sản phẩm trong phiếu nhập này!',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý nhập kho',
                cancelButtonText: 'Đóng'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Warehouse/CompleteDraft/${id}`, { method: 'POST' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Thành công', data.message, 'success').then(() => window.location.reload());
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    } catch (e) {
                        Swal.fire('Lỗi', 'Có lỗi kết nối máy chủ', 'error');
                    }
                }
            });
        }

        function confirmCancel(id) {
            Swal.fire({
                title: 'Xác nhận huỷ phiếu nhập?',
                text: 'Hệ thống sẽ trừ lại số lượng tồn kho tương ứng của các sản phẩm trong phiếu!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d70018',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý huỷ',
                cancelButtonText: 'Không'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const res = await fetch(`/Admin/Warehouse/CancelReceipt/${id}`, { method: 'POST' });
                        const data = await res.json();
                        if (data.success) {
                            Swal.fire('Thành công', data.message, 'success').then(() => window.location.reload());
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    } catch (e) {
                        Swal.fire('Lỗi', 'Có lỗi kết nối máy chủ', 'error');
                    }
                }
            });
        }
    </script>
}
