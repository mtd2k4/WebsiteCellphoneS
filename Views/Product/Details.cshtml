        // Cho phép bấm trực tiếp vào ảnh thumbnail dưới khung ảnh chính để đổi màu biến thể
        function selectColorFromGallery(colorName, imgUrl) {
            const hasInCurrentStorage = productVariants.some(v => v.storage === currentStorage && v.colorName === colorName);
            if (hasInCurrentStorage) {
                selectColor(colorName);
            } else {
                const matchAny = productVariants.find(v => v.colorName === colorName);
                if (matchAny) {
                    selectStorage(matchAny.storage);
                    selectColor(colorName);
                }
            }
        }

        // Hàm chọn phiên bản bộ nhớ (Storage)
        function selectStorage(storage) {
            currentStorage = storage;

            // Highlight storage pill
            document.querySelectorAll("#storage-container .cps-storage-pill").forEach(el => {
                if (el.getAttribute("data-storage") === storage) {
                    el.classList.add("active");
                } else {
                    el.classList.remove("active");
                }
            });

            // Lọc danh sách màu sắc có sẵn cho dung lượng này
            const availableColors = productVariants.filter(v => v.storage === storage);
            const colorsContainer = document.getElementById("colors-container");
            if (colorsContainer) {
                colorsContainer.innerHTML = "";

                availableColors.forEach((v, index) => {
                    const colorPill = document.createElement("div");
                    colorPill.className = "cps-color-pill " + (index === 0 ? "active" : "");
                    colorPill.setAttribute("data-color", v.colorName);
                    colorPill.onclick = () => selectColor(v.colorName);

                    const resolvedImg = v.imageUrl || getSmartColorImage(productName, v.colorName, defaultProductImg);

                    let thumbHtml = '';
                    if (resolvedImg) {
                        thumbHtml = `<img src="${resolvedImg}" alt="${v.colorName}" class="cps-color-thumb me-1" style="width: 26px; height: 26px; object-fit: contain; border-radius: 4px; background: #fff; padding: 1px; border: 1px solid #e2e8f0;" onerror="this.onerror=null; this.style.display='none';" />`;
                    } else {
                        thumbHtml = `<span class="cps-color-dot" style="background-color: ${v.colorHex};"></span>`;
                    }

                    colorPill.innerHTML = `
                        <div class="d-flex align-items-center gap-2">
                            ${thumbHtml}
                            <div class="d-flex flex-column text-start">
                                <span class="cps-color-name" style="font-weight: 700; font-size: 13px;">${v.colorName}</span>
                                <span class="cps-color-price" style="font-size: 11px; color: #64748b;">${Number(v.price).toLocaleString('vi-VN')}₫</span>
                            </div>
                        </div>
                    `;
                    colorsContainer.appendChild(colorPill);
                });

                // Tự động chọn màu đầu tiên của storage này
                if (availableColors.length > 0) {
                    selectColor(availableColors[0].colorName);
                }
            }
        }

        // Hàm chọn màu sắc (Color)
        function selectColor(colorName) {
            currentColor = colorName;

            // Highlight color pill
            document.querySelectorAll("#colors-container .cps-color-pill").forEach(el => {
                if (el.getAttribute("data-color") === colorName) {
                    el.classList.add("active");
                } else {
                    el.classList.remove("active");
                }
            });

            // Highlight thumbnail in left gallery
            document.querySelectorAll("#variant-thumbs-gallery .variant-gallery-thumb").forEach(el => {
                if (el.getAttribute("data-color") === colorName) {
                    el.classList.add("border-danger", "border-2", "shadow-xs");
                    el.style.background = "#fff5f5";
                } else {
                    el.classList.remove("border-danger", "border-2", "shadow-xs");
                    el.style.background = "#ffffff";
                }
            });

            const activeColorLabel = document.getElementById("active-color-name");
            if (activeColorLabel) activeColorLabel.innerText = colorName;

            const previewColorLabel = document.getElementById("preview-color-label");
            if (previewColorLabel) previewColorLabel.innerText = colorName;

            // Tìm biến thể thỏa mãn cả Storage và Color
            const matchVariant = productVariants.find(v => v.storage === currentStorage && v.colorName === colorName);
            if (matchVariant) {
                selectedVariantId = matchVariant.id;

                // Cập nhật giá hiển thị
                const currentPriceEl = document.getElementById("current-price");
                if (currentPriceEl) {
                    currentPriceEl.innerText = Number(matchVariant.price).toLocaleString('vi-VN') + "₫";
                }

                // Cập nhật tóm tắt lựa chọn
                const summaryEl = document.getElementById("selected-summary-text");
                if (summaryEl) {
                    summaryEl.innerText = `${matchVariant.storage} - ${matchVariant.colorName} (${Number(matchVariant.price).toLocaleString('vi-VN')}₫)`;
                }

                // Tự động đồng bộ dropdown trong form đánh giá
                const reviewVarSelect = document.getElementById("reviewVariantInfo");
                if (reviewVarSelect) {
                    const optionVal = `${matchVariant.colorName} - ${matchVariant.storage}`;
                    for (let opt of reviewVarSelect.options) {
                        if (opt.value === optionVal) {
                            reviewVarSelect.value = optionVal;
                            break;
                        }
                    }
                }

                // Đổi ảnh sản phẩm tương ứng với màu đã chọn
                const targetImg = matchVariant.imageUrl || getSmartColorImage(productName, matchVariant.colorName, defaultProductImg);
                const mainImg = document.getElementById("main-product-img");
                if (mainImg && targetImg) {
                    if (mainImg.getAttribute("data-current-src") !== targetImg) {
                        mainImg.setAttribute("data-current-src", targetImg);
                        mainImg.style.opacity = '0.2';
                        mainImg.style.transform = 'scale(0.96)';
                        setTimeout(() => {
                            mainImg.src = targetImg;
                            mainImg.style.opacity = '1';
                            mainImg.style.transform = 'scale(1)';
                        }, 130);
                    }
                }
            }
        }

        // Xử lý nút MUA NGAY
        function handleBuyNow() {
            const productId = @product.Id;
            addToCart(productId, 1, selectedVariantId);
            setTimeout(() => {
                window.location.href = '/Cart';
            }, 300);
        }

        // Xử lý nút THÊM VÀO GIỎ HÀNG
        function handleAddToCart() {
            const productId = @product.Id;
            addToCart(productId, 1, selectedVariantId);
            Swal.fire({
                icon: 'success',
                title: 'Đã thêm vào giỏ hàng!',
                text: 'Sản phẩm "@Html.Raw(product.Name.Replace("\"", "\\\""))" đã được thêm vào giỏ hàng của bạn.',
                showCancelButton: true,
                confirmButtonColor: '#d70018',
                cancelButtonColor: '#334155',
                confirmButtonText: '<i class="bi bi-cart3 me-1"></i> Xem giỏ hàng',
                cancelButtonText: 'Tiếp tục mua sắm',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Cart';
                }
            });
        }

        // ========================================================
        // LOGIC ĐÁNH GIÁ & NHẬN XÉT (REVIEWS & RATINGS)
        // ========================================================
        function toggleReviewForm() {
            const container = document.getElementById("reviewFormContainer");
            if (container) {
                if (container.style.display === "none" || container.style.display === "") {
                    container.style.display = "block";
                    container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    container.style.display = "none";
                }
            }
        }

        // Khởi tạo tương tác chọn sao đánh giá
        function initStarSelector() {
            const stars = document.querySelectorAll("#starSelectorContainer .star-interactive");
            const label = document.getElementById("ratingLabelText");
            const input = document.getElementById("reviewRatingInput");
            const labels = {
                1: "1/5: Rất tệ",
                2: "2/5: Tệ, chưa hài lòng",
                3: "3/5: Bình thường",
                4: "4/5: Rất tốt, hài lòng",
                5: "5/5: Tuyệt vời, vượt mong đợi"
            };

            stars.forEach(star => {
                star.addEventListener("click", function () {
                    const val = parseInt(this.getAttribute("data-rating"));
                    input.value = val;
                    label.innerText = labels[val] || `${val}/5 sao`;

                    stars.forEach(s => {
                        const sVal = parseInt(s.getAttribute("data-rating"));
                        if (sVal <= val) {
                            s.classList.add("active");
                            s.classList.replace("bi-star", "bi-star-fill");
                        } else {
                            s.classList.remove("active");
                            s.classList.replace("bi-star-fill", "bi-star");
                        }
                    });
                });
            });

            // Đếm ký tự
            const contentArea = document.getElementById("reviewContent");
            const countLabel = document.getElementById("charCount");
            contentArea?.addEventListener("input", function () {
                countLabel.innerText = `${this.value.length}/1000 ký tự`;
            });
        }

        // Gửi đánh giá qua AJAX
        async function submitReview(e) {
            e.preventDefault();

            const productId = parseInt(document.getElementById("reviewProductId").value);
            const rating = parseInt(document.getElementById("reviewRatingInput").value);
            const customerName = document.getElementById("reviewCustomerName").value.trim();
            const phoneNumber = document.getElementById("reviewPhoneNumber").value.trim();
            const variantInfo = document.getElementById("reviewVariantInfo") ? document.getElementById("reviewVariantInfo").value : "";
            const content = document.getElementById("reviewContent").value.trim();
            const btnSubmit = document.getElementById("btnSubmitReview");

            if (content.length < 5) {
                showWarning("Nội dung đánh giá cần tối thiểu 5 ký tự.");
                return;
            }

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...`;

            try {
                const response = await fetch('/Product/AddReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: productId,
                        rating: rating,
                        customerName: customerName,
                        phoneNumber: phoneNumber,
                        variantInfo: variantInfo,
                        content: content
                    })
                });

                const data = await response.json();
                if (data.success) {
                    showSuccess(data.message, "Đánh giá thành công");
                    
                    // Ẩn form và reset
                    toggleReviewForm();
                    document.getElementById("productReviewForm").reset();

                    // Thêm trực tiếp đánh giá mới lên đầu danh sách
                    const r = data.review;
                    const initial = r.customerName.charAt(0).toUpperCase();
                    let starsHtml = "";
                    for (let s = 1; s <= 5; s++) {
                        starsHtml += s <= r.rating ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star text-muted opacity-50"></i>';
                    }

                    const reviewHtml = `
                        <div class="cps-review-item review-row border-start border-4 border-success ps-3 bg-success-subtle bg-opacity-10" data-rating="${r.rating}" data-verified="true">
                            <div class="d-flex align-items-start gap-3">
                                <div class="cps-review-avatar">${initial}</div>
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <strong class="text-dark">${r.customerName}</strong>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 11px;">
                                                <i class="bi bi-patch-check-fill me-1"></i>Đã mua tại CellphoneS
                                            </span>
                                            <span class="badge bg-warning text-dark" style="font-size: 10px;">Vừa xong</span>
                                        </div>
                                        <small class="text-muted" style="font-size: 11.5px;"><i class="bi bi-clock me-1"></i>${r.createdAt}</small>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <div class="text-warning small">${starsHtml}</div>
                                        ${r.variantInfo ? `<span class="badge bg-light text-secondary border" style="font-size: 11px;"><i class="bi bi-phone me-1"></i>Phiên bản: ${r.variantInfo}</span>` : ''}
                                    </div>
                                    <p class="text-dark mb-2" style="font-size: 13.5px; line-height: 1.6;">${r.content}</p>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-light border py-1 px-2" style="font-size: 11.5px;" onclick="likeReview(${r.id}, this)">
                                            <i class="bi bi-hand-thumbs-up me-1 text-danger"></i> Hữu ích (<strong>0</strong>)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;

                    const container = document.getElementById("reviewsListContainer");
                    const emptyNotice = document.getElementById("emptyReviewNotice");
                    if (emptyNotice) emptyNotice.remove();
                    container.insertAdjacentHTML('afterbegin', reviewHtml);

                    // Cập nhật số lượng
                    const countEl = document.getElementById("summary-total-count");
                    const topBadge = document.getElementById("top-reviews-badge");
                    if (countEl) countEl.innerText = parseInt(countEl.innerText) + 1;
                    if (topBadge) topBadge.innerHTML = `<i class="bi bi-patch-check-fill me-1"></i> ${parseInt(countEl.innerText)} lượt đánh giá xác thực`;
                } else {
                    showError(data.message || "Có lỗi xảy ra khi gửi đánh giá.");
                }
            } catch (err) {
                showError("Lỗi kết nối khi gửi đánh giá. Vui lòng thử lại!");
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = `<i class="bi bi-send-fill me-1"></i> Gửi Đánh Giá Ngay`;
            }
        }

        // Like review
        async function likeReview(reviewId, btn) {
            try {
                const res = await fetch('/Product/LikeReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(reviewId)
                });
                const data = await res.json();
                if (data.success) {
                    btn.querySelector('strong').innerText = data.likes;
                    btn.classList.add('text-danger', 'fw-bold');
                }
            } catch (e) {}
        }

        // Lọc đánh giá theo số sao
        function filterReviews(filter, btn) {
            document.querySelectorAll(".review-filter-btn").forEach(b => {
                b.classList.remove("btn-danger", "active");
                b.classList.add("btn-outline-secondary");
            });
            btn.classList.add("btn-danger", "active");
            btn.classList.remove("btn-outline-secondary");

            const rows = document.querySelectorAll("#reviewsListContainer .review-row");
            rows.forEach(row => {
                if (filter === 'all') {
                    row.style.display = "block";
                } else if (filter === 'verified') {
                    row.style.display = row.getAttribute("data-verified") === 'true' ? "block" : "none";
                } else {
                    row.style.display = row.getAttribute("data-rating") === filter ? "block" : "none";
                }
            });
        }

        // Kiểm tra trạng thái yêu thích của sản phẩm khi tải trang
        (async function checkFav() {
            try {
                const res = await fetch('/Wishlist/CheckStatus?productId=@product.Id');
                if (res.ok) {
                    const data = await res.json();
                    if (data.isFavorited) {
                        const btn = document.getElementById('btn-fav-toggle');
                        if (btn) {
                            btn.classList.remove('btn-outline-danger');
                            btn.classList.add('btn-danger');
                            const icon = btn.querySelector('i');
                            if (icon) icon.className = 'bi bi-heart-fill fs-4';
                            const text = document.getElementById('fav-text');
                            if (text) text.innerText = 'ĐÃ YÊU THÍCH';
                        }
                    }
                }
            } catch (e) {}
        })();
    </script>
}
