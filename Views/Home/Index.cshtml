@model WebsiteBanDienThoai.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "CellphoneS - Điện thoại, laptop, tablet, phụ kiện chính hãng";
}

<div class="container cps-hero-container">
    <!-- 1. HERO SECTION (3 COLUMNS) -->
    <div class="row g-3 cps-hero-section">
        
        <!-- Cột 1: Mega Menu Dọc bên trái -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="cps-sidebar-menu">
                <ul class="cps-menu-list">
                    @foreach (var cat in Model.Categories)
                    {
                        <li class="cps-menu-item">
                            <a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" class="cps-menu-link">
                                <i class="@(string.IsNullOrEmpty(cat.IconClass) ? "bi bi-phone" : cat.IconClass) menu-icon"></i>
                                <span>@cat.Name</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>

                            <!-- Flyout Mega Menu -->
                            <div class="cps-mega-flyout">
                                <div class="row g-3">
                                    <div class="col-4 cps-flyout-column">
                                        <h6>THƯƠNG HIỆU HÀNG ĐẦU</h6>
                                        <ul>
                                            @foreach (var brand in Model.Brands.Take(6))
                                            {
                                                <li>
                                                    <a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" asp-route-brand="@brand.Slug">
                                                        @cat.Name @brand.Name
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                    <div class="col-4 cps-flyout-column">
                                        <h6>CHỌN THEO MỨC GIÁ</h6>
                                        <ul>
                                            <li><a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" asp-route-maxPrice="5000000">Dưới 5 triệu</a></li>
                                            <li><a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" asp-route-minPrice="5000000" asp-route-maxPrice="10000000">Từ 5 - 10 triệu</a></li>
                                            <li><a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" asp-route-minPrice="10000000" asp-route-maxPrice="20000000">Từ 10 - 20 triệu</a></li>
                                            <li><a asp-controller="Product" asp-action="Category" asp-route-slug="@cat.Slug" asp-route-minPrice="20000000">Trên 20 triệu</a></li>
                                        </ul>
                                    </div>
                                    <div class="col-4 cps-flyout-column">
                                        <h6>NHU CẦU NỔI BẬT</h6>
                                        <ul>
                                            <li><a href="#">Hỗ trợ 5G tốc độ cao</a></li>
                                            <li><a href="#">Chơi game cấu hình khủng</a></li>
                                            <li><a href="#">Chụp ảnh quay phim đẹp</a></li>
                                            <li><a href="#">Pin trâu sạc siêu nhanh</a></li>
                                            <li><a href="#">Màn hình gập thời thượng</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Cột 2: Main Slider Carousel ở giữa -->
        <div class="col-12 col-lg-6">
            <div class="cps-main-slider">
                <div class="swiper cps-hero-swiper">
                    <div class="swiper-wrapper">
                        @for (int idx = 0; idx < Model.MainBanners.Count; idx++)
                        {
                            var banner = Model.MainBanners[idx];
                            string fallbackMainImg = idx switch {
                                0 => "/images/banners/banner-iphone16.jpg",
                                1 => "/images/banners/banner-s24ultra.jpg",
                                2 => "/images/banners/banner-khaitruong.jpg",
                                _ => "/images/banners/banner-laptop.jpg"
                            };
                            <div class="swiper-slide">
                                <a href="@banner.LinkUrl">
                                    <img src="@banner.ImageUrl" alt="@banner.Title" onerror="this.onerror=null; this.src='@fallbackMainImg';" />
                                </a>
                            </div>
                        }
                    </div>
                    <div class="swiper-button-next text-white"></div>
                    <div class="swiper-button-prev text-white"></div>
                </div>

                <!-- Slider Bottom Tabs -->
                <div class="cps-slider-tabs d-none d-sm-flex">
                    @for (int i = 0; i < Model.MainBanners.Count; i++)
                    {
                        var b = Model.MainBanners[i];
                        <div class="cps-tab-item @(i == 0 ? "active" : "")" data-slide-index="@i">
                            <strong>@b.Title</strong><br />
                            <small class="text-muted" style="font-size: 10px;">@(b.Subtitle ?? "Ưu đãi lớn")</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột 3: Khối Smember & Mini Banners bên phải -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="cps-right-widget">
                <!-- Smember Card -->
                <div class="cps-smember-box">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var memberLevel = User.FindFirst("SmemberLevel")?.Value ?? "Smember";
                        var memberPoints = User.FindFirst("SmemberPoints")?.Value ?? "0";
                        <div class="cps-smember-header">
                            <div class="cps-smember-avatar bg-warning text-dark">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="text-truncate mb-0" title="@User.Identity.Name">Xin chào, @User.Identity.Name</h6>
                                <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-warning text-dark")" style="font-size: 10px;">
                                    @(User.IsInRole("Admin") ? "Admin Quản trị" : memberLevel)
                                </span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center my-2 p-2 bg-light rounded border text-muted" style="font-size: 12px;">
                            <span>Điểm tích luỹ:</span>
                            <strong class="text-danger fs-6">@memberPoints PTS</strong>
                        </div>

                        <div class="cps-smember-actions">
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-danger btn-smember text-decoration-none">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-danger btn-smember text-decoration-none">Tài khoản</a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Profile" class="btn btn-danger btn-smember text-decoration-none">Tài khoản</a>
                                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-smember text-decoration-none">Đăng xuất</a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cps-smember-header">
                            <div class="cps-smember-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <div>
                                <h6>Chào mừng đến CellphoneS</h6>
                                <span class="badge bg-danger" style="font-size: 10px;">Smember VIP</span>
                            </div>
                        </div>
                        <p>Đăng nhập để nhận thêm ưu đãi giảm giá và tích điểm nâng hạng thành viên!</p>
                        <div class="cps-smember-actions">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-smember text-decoration-none">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-danger btn-smember text-decoration-none">Đăng ký</a>
                        </div>
                    }
                </div>

                <!-- Right Banners -->
                @if (Model.RightBanners != null && Model.RightBanners.Any())
                {
                    @for (int rIdx = 0; rIdx < Model.RightBanners.Count; rIdx++)
                    {
                        var rBanner = Model.RightBanners[rIdx];
                        bool isTradeIn = rBanner.Title.Contains("Thu c", StringComparison.OrdinalIgnoreCase) || 
                                         rBanner.Title.Contains("Thu cũ", StringComparison.OrdinalIgnoreCase) || 
                                         (rBanner.LinkUrl != null && rBanner.LinkUrl.Contains("TradeIn", StringComparison.OrdinalIgnoreCase));
                        string rTargetUrl = (isTradeIn ? Url.Action("Index", "TradeIn") : (!string.IsNullOrEmpty(rBanner.LinkUrl) && rBanner.LinkUrl != "#" ? rBanner.LinkUrl : Url.Action("Profile", "Account"))) ?? "#";
                        string rFallbackImg = isTradeIn ? "/images/banners/banner-tradein.jpg" : "/images/banners/banner-smember.jpg";

                        <a href="@rTargetUrl" class="cps-mini-banner">
                            <img src="@rBanner.ImageUrl" alt="@rBanner.Title" onerror="this.onerror=null; this.src='@rFallbackImg';" />
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="TradeIn" asp-action="Index" class="cps-mini-banner">
                        <img src="/images/banners/banner-tradein.jpg" alt="Thu cũ đổi mới" />
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="cps-mini-banner">
                        <img src="/images/banners/banner-smember.jpg" alt="Ưu đãi Smember" />
                    </a>
                }
            </div>
        </div>

    </div>

    <!-- 2. QUICK SERVICE PILLS BAR -->
    <div class="cps-quick-pills my-3">
        <a href="#flashsale" class="cps-pill-item">
            <i class="bi bi-lightning-charge-fill text-warning"></i>
            <span>Hot Sale Giờ Vàng</span>
        </a>
        <a asp-controller="Product" asp-action="Category" asp-route-slug="dien-thoai" class="cps-pill-item">
            <i class="bi bi-phone"></i>
            <span>Điện thoại Flagship</span>
        </a>
        <a asp-controller="TradeIn" asp-action="Index" class="cps-pill-item">
            <i class="bi bi-arrow-left-right text-success"></i>
            <span>Thu cũ đổi mới - Trợ giá 4 triệu</span>
        </a>
        <a href="#aar-zone" class="cps-pill-item">
            <i class="bi bi-apple text-dark"></i>
            <span>Apple Authorised Reseller</span>
        </a>
        <a href="#" class="cps-pill-item">
            <i class="bi bi-mortarboard-fill text-primary"></i>
            <span>Đặc quyền Sinh viên (S-Student)</span>
        </a>
        <a href="#" class="cps-pill-item">
            <i class="bi bi-credit-card-2-front"></i>
            <span>Trả góp 0% lãi suất</span>
        </a>
    </div>

    <!-- 3. FLASH SALE: HOT SALE GIỜ VÀNG (CÓ TABS CHUYÊN MỤC) -->
    <section id="flashsale" class="cps-flashsale-block">
        <div class="cps-flashsale-header">
            <div class="cps-flashsale-title">
                <i class="bi bi-fire"></i>
                <span>HOT SALE GIỜ VÀNG</span>
            </div>

            <!-- Countdown Timer -->
            <div class="cps-countdown">
                <span>KẾT THÚC TRONG:</span>
                <span id="cps-flash-hours" class="time-box">00</span>
                <span class="colon">:</span>
                <span id="cps-flash-mins" class="time-box">00</span>
                <span class="colon">:</span>
                <span id="cps-flash-secs" class="time-box">00</span>
            </div>
        </div>

        <!-- Flash Sale Category Filter Tabs -->
        <div class="cps-flash-tabs">
            <button class="cps-flash-tab active" data-flash-cat="all">Tất cả deal sốc</button>
            <button class="cps-flash-tab" data-flash-cat="dien-thoai">Điện thoại</button>
            <button class="cps-flash-tab" data-flash-cat="am-thanh">Âm thanh</button>
            <button class="cps-flash-tab" data-flash-cat="dong-ho">Đồng hồ</button>
            <button class="cps-flash-tab" data-flash-cat="phu-kien">Phụ kiện</button>
        </div>

        <div class="swiper cps-flashsale-swiper">
            <div class="swiper-wrapper">
                @foreach (var product in Model.FlashSaleProducts)
                {
                    var priceToShow = product.FlashSalePrice ?? product.SalePrice;
                    var percent = product.OriginalPrice > 0 ? (int)Math.Round((product.OriginalPrice - priceToShow) / product.OriginalPrice * 100) : 0;
                    var soldPercent = product.FlashSaleQuantity > 0 ? (int)((double)product.FlashSaleSold / product.FlashSaleQuantity * 100) : 75;
                    var catSlug = product.Category?.Slug ?? "";

                    <div class="swiper-slide cps-flash-slide" data-cat="@catSlug">
                        <div class="cps-product-card">
                            <div class="cps-card-badges">
                                <span class="cps-badge-installment">Trả góp 0%</span>
                                <span class="cps-badge-discount">-@percent%</span>
                            </div>

                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="cps-card-image">
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                            </a>

                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="cps-card-title">
                                @product.Name
                            </a>

                            <div class="cps-card-price">
                                <span class="cps-sale-price">@priceToShow.ToString("N0")₫</span>
                                <span class="cps-origin-price">@product.OriginalPrice.ToString("N0")₫</span>
                            </div>

                            @if (product.SmemberDiscount > 0)
                            {
                                <div class="cps-smember-tag">
                                    <i class="bi bi-star-fill me-1"></i> Smember giảm thêm @product.SmemberDiscount.ToString("N0")₫
                                </div>
                            }

                            <!-- Progress bar -->
                            <div class="cps-sold-progress">
                                <div class="bar" style="width: @soldPercent%;"></div>
                                <div class="label">
                                    @if (soldPercent >= 85)
                                    {
                                        <span><i class="bi bi-fire text-warning"></i> Sắp cháy hàng (@product.FlashSaleSold/@product.FlashSaleQuantity)</span>
                                    }
                                    else
                                    {
                                        <span>Đã bán @product.FlashSaleSold / @product.FlashSaleQuantity</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ============================================================
         3.5. BANNER QUẢNG CÁO LỚN TRANG CHỦ (NẾU CÓ CẤU HÌNH TRONG ADMIN)
         ============================================================ -->
    @{
        var promoBanners = Model.BigBanners.Where(b => b.Position == "BigBanner" || b.Position == "MiddleBanner").ToList();
    }
    @if (promoBanners.Any())
    {
        <section class="cps-big-promo-section position-relative my-4" aria-label="Banner khuyến mãi lớn">
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Banner" asp-action="Index" asp-route-position="BigBanner" 
                   class="cps-admin-edit-banner-badge" title="Quản trị viên: Quản lý hoặc thay đổi banner to này">
                    <i class="bi bi-pencil-square me-1"></i> Quản lý banner to này
                </a>
            }

            @if (promoBanners.Count > 1)
            {
                <!-- Slider nhiều Banner quảng cáo to -->
                <div class="swiper cps-big-promo-swiper">
                    <div class="swiper-wrapper">
                        @foreach (var b in promoBanners)
                        {
                            <div class="swiper-slide">
                                <div class="cps-big-promo-card">
                                    <a href="@b.LinkUrl" class="cps-big-promo-link" title="@b.Title">
                                        <img src="@b.ImageUrl" alt="@b.Title" class="cps-big-promo-img" 
                                             onerror="this.onerror=null; this.src='/images/banners/banner-megasale.jpg';" />
                                        <div class="cps-big-promo-sheen"></div>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    <!-- Navigation Buttons (Hover-reveal Glassmorphism) -->
                    <div class="swiper-button-next big-promo-next" aria-label="Next slide"></div>
                    <div class="swiper-button-prev big-promo-prev" aria-label="Previous slide"></div>
                </div>
                <!-- Sleek Frosted Pill Pagination đặt bên dưới để hiển thị toàn bộ ảnh 100% không bị khuất -->
                <div class="cps-big-promo-pagination-wrap">
                    <div class="swiper-pagination big-promo-pagination"></div>
                </div>
            }
            else
            {
                <!-- 1 Banner quảng cáo to duy nhất -->
                var singleBanner = promoBanners[0];
                <div class="cps-big-promo-card">
                    <a href="@singleBanner.LinkUrl" class="cps-big-promo-link" title="@singleBanner.Title">
                        <img src="@singleBanner.ImageUrl" alt="@singleBanner.Title" class="cps-big-promo-img" 
                             onerror="this.onerror=null; this.src='/images/banners/banner-megasale.jpg';" />
                        <div class="cps-big-promo-sheen"></div>
                    </a>
                </div>
            }
        </section>
    }

    <!-- 4. KHỐI ĐIỆN THOẠI NỔI BẬT (CÓ BỘ LỌC HÃNG & TẦM GIÁ NHANH) -->
    <section class="my-4">
        <div class="cps-section-header">
            <div>
                <h3 class="cps-section-title">
                    <i class="bi bi-phone-fill text-danger me-1"></i> ĐIỆN THOẠI NỔI BẬT NHẤT
                </h3>
            </div>

            <!-- Tabs Lọc Hãng -->
            <div class="d-flex align-items-center gap-2">
                <div class="cps-brand-tabs">
                    <button class="cps-brand-tab active" data-brand="all">Tất cả</button>
                    @foreach (var brand in Model.Brands.Take(5))
                    {
                        <button class="cps-brand-tab" data-brand="@brand.Slug">@brand.Name</button>
                    }
                </div>
                <a asp-controller="Product" asp-action="Category" asp-route-slug="dien-thoai" class="cps-view-all d-none d-md-inline">
                    Xem tất cả <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>

        <!-- Sub-filter: Bộ lọc mức giá nhanh -->
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="small fw-bold text-muted"><i class="bi bi-cash me-1"></i> Mức giá:</span>
            <div class="cps-price-pills">
                <button class="cps-price-pill active" data-price-range="all">Tất cả giá</button>
                <button class="cps-price-pill" data-price-range="under-5m">Dưới 5 triệu</button>
                <button class="cps-price-pill" data-price-range="5m-10m">Từ 5 - 10 triệu</button>
                <button class="cps-price-pill" data-price-range="10m-20m">Từ 10 - 20 triệu</button>
                <button class="cps-price-pill" data-price-range="over-20m">Trên 20 triệu</button>
            </div>
        </div>

        <!-- Grid Sản Phẩm -->
        <div id="grid-phones" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-2 g-md-3">
            @foreach (var product in Model.FeaturedPhones)
            {
                <div class="col cps-product-item" data-brand="@(product.Brand?.Slug ?? "")" data-price="@product.SalePrice">
                    <div class="cps-product-card">
                        <div class="cps-card-badges">
                            @if (product.HasInstallment0Percent)
                            {
                                <span class="cps-badge-installment">Trả góp 0%</span>
                            }
                            @if (product.DiscountPercent > 0)
                            {
                                <span class="cps-badge-discount ms-auto">-@product.DiscountPercent%</span>
                            }
                        </div>

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="cps-card-image">
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                        </a>

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="cps-card-title">
                            @product.Name
                        </a>

                        <div class="cps-card-price">
                            <span class="cps-sale-price">@product.SalePrice.ToString("N0")₫</span>
                            @if (product.OriginalPrice > product.SalePrice)
                            {
                                <span class="cps-origin-price">@product.OriginalPrice.ToString("N0")₫</span>
                            }
                        </div>

                        @if (product.SmemberDiscount > 0)
                        {
                            <div class="cps-smember-tag">
                                <i class="bi bi-gem me-1"></i> Smember giảm thêm @product.SmemberDiscount.ToString("N0")₫
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(product.PromotionInfo))
                        {
                            <div class="cps-promo-box">
                                <i class="bi bi-gift-fill text-danger me-1"></i> @product.PromotionInfo
                            </div>
                        }

                        <div class="cps-card-footer">
                            <div class="cps-rating">
                                <i class="bi bi-star-fill"></i>
                                <span><strong>@product.Rating.ToString("0.0")</strong> (@product.ReviewCount)</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn cps-wishlist-btn p-1" data-product-id="@product.Id" onclick="toggleWishlist(@product.Id, this)" title="Lưu yêu thích">
                                    <i class="bi bi-heart"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" onclick="addToCart(@product.Id, 1)">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 5. APPLE AUTHORISED RESELLER (AAR) SHOWCASE ZONE -->
    <section id="aar-zone" class="cps-aar-box">
        <div class="cps-aar-header">
            <div class="cps-aar-title">
                <i class="bi bi-apple fs-3"></i>
                <span>Apple Authorised Reseller</span>
                <span class="cps-aar-badge">Đại lý uỷ quyền Apple chính thức</span>
            </div>
            <a asp-controller="Product" asp-action="Category" asp-route-slug="all" asp-route-brand="apple" class="text-white text-decoration-none small fw-bold">
                Khám phá hệ sinh thái Apple <i class="bi bi-chevron-right"></i>
            </a>
        </div>

        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var appleProduct in Model.FeaturedPhones.Where(p => p.Brand?.Slug == "apple").Take(4))
            {
                <div class="col">
                    <div class="cps-product-card bg-white text-dark">
                        <div class="cps-card-badges">
                            <span class="badge bg-dark text-white">Apple VN/A</span>
                            <span class="cps-badge-discount ms-auto">-@appleProduct.DiscountPercent%</span>
                        </div>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@appleProduct.Id" class="cps-card-image">
                            <img src="@appleProduct.ImageUrl" alt="@appleProduct.Name" />
                        </a>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@appleProduct.Id" class="cps-card-title">
                            @appleProduct.Name
                        </a>
                        <div class="cps-card-price">
