<!-- ============================================================
     13. PROMOTIONAL POPUP BANNER (POPUP QUẢNG CÁO TRANG CHỦ)
     ============================================================ -->
@if (Model.PopupBanner != null && Model.PopupBanner.IsActive)
{
    <div id="cpsPromoPopupModal" class="cps-promo-popup-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="popupBannerTitle">
        <div class="cps-promo-popup-wrapper">
            <!-- Nút chỉnh sửa nhanh dành riêng cho Admin (nổi bật phía trên modal) -->
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Banner" asp-action="Edit" asp-route-id="@Model.PopupBanner.Id" 
                   class="cps-promo-popup-admin-btn" title="Quản trị viên: Chỉnh sửa popup này trong Admin">
                    <i class="bi bi-pencil-square me-1"></i> Quản lý Popup trong Admin
                </a>
            }

            <!-- Nút đóng tròn nổi bật ở góc ngoài trên cùng -->
            <button type="button" class="cps-promo-popup-close-btn" onclick="closePromoPopup(false)" title="Đóng quảng cáo" aria-label="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>

            <!-- Card chính của Popup (Full-bleed Edge-to-Edge) -->
            <div class="cps-promo-popup-card">
                <!-- Banner Image & Link -->
                <a href="@Model.PopupBanner.LinkUrl" class="cps-promo-popup-link" onclick="closePromoPopup(false)" title="@Model.PopupBanner.Title">
                    <img src="@Model.PopupBanner.ImageUrl" alt="@Model.PopupBanner.Title" id="popupBannerTitle" class="cps-promo-popup-img" 
                         onerror="this.onerror=null; this.src='/images/banners/banner-megasale.jpg';" />
                    <div class="cps-promo-popup-sheen"></div>
                </a>

                <!-- Thanh thao tác chân Popup: Thiết kế Kính tối màu cao cấp (Dark Frosted Glass) -->
                <div class="cps-promo-popup-actions">
                    <label class="cps-promo-popup-checkbox-label" for="cpsDontShowPopupToday">
                        <input type="checkbox" id="cpsDontShowPopupToday" class="cps-custom-checkbox" />
                        <span>Không hiển thị lại trong hôm nay</span>
                    </label>
                    <div class="cps-promo-popup-buttons">
                        <button type="button" class="cps-promo-btn-close" onclick="closePromoPopup(false)">
                            Bỏ qua
                        </button>
                        <a href="@Model.PopupBanner.LinkUrl" class="cps-promo-btn-cta" onclick="closePromoPopup(false)">
                            <span>Khám Phá Ngay</span>
                            <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const popupModal = document.getElementById("cpsPromoPopupModal");
            if (!popupModal) return;

            const hideDate = localStorage.getItem("cps_hide_promo_popup_date");
            const todayStr = new Date().toISOString().slice(0, 10);

            // Mở popup sau 700ms nếu người dùng chưa chọn ẩn hôm nay
            if (hideDate !== todayStr) {
                setTimeout(function () {
                    popupModal.style.display = "flex";
                    requestAnimationFrame(function () {
                        popupModal.classList.add("cps-popup-active");
                    });
                }, 700);
            }

            // Đóng khi click vào vùng đen bên ngoài
            popupModal.addEventListener("click", function (e) {
                if (e.target === popupModal) {
                    closePromoPopup(false);
                }
            });

            // Đóng khi nhấn phím Escape
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && popupModal.classList.contains("cps-popup-active")) {
                    closePromoPopup(false);
                }
            });
        });

        function closePromoPopup(forceSave) {
            const popupModal = document.getElementById("cpsPromoPopupModal");
            if (!popupModal) return;

            const chk = document.getElementById("cpsDontShowPopupToday");
            if (forceSave || (chk && chk.checked)) {
                localStorage.setItem("cps_hide_promo_popup_date", new Date().toISOString().slice(0, 10));
            }

            popupModal.classList.remove("cps-popup-active");
            popupModal.classList.add("cps-popup-closing");
            setTimeout(function () {
                popupModal.style.display = "none";
                popupModal.classList.remove("cps-popup-closing");
            }, 300);
        }
    </script>
}
