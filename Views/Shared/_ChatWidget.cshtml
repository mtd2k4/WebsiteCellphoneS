                    </div>
                    <div class="mb-2">
                        <input type="tel" id="cbPhone" class="form-control form-control-sm bg-white" placeholder="Số điện thoại nhận tư vấn (*)" required />
                    </div>
                    <div class="mb-2">
                        <select id="cbTopic" class="form-select form-select-sm bg-white">
                            <option value="Tư vấn mua iPhone / Samsung">Tư vấn mua Điện thoại / Tablet</option>
                            <option value="Thu cũ đổi mới trợ giá">Thu cũ đổi mới lên đời</option>
                            <option value="Bảo hành & Sửa chữa">Bảo hành & Sửa chữa Điện Thoại Vui</option>
                            <option value="Tra cứu đơn hàng">Tra cứu & Hỗ trợ đơn hàng</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <textarea id="cbNote" class="form-control form-control-sm bg-white" rows="2" placeholder="Ghi chú nội dung cần tư vấn (tùy chọn)..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold py-2 shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> GỬI YÊU CẦU GỌI LẠI
                    </button>
                </form>
                <div id="cbAlertSuccess" class="alert alert-success mt-2 py-2 small d-none text-center rounded-3">
                    <i class="bi bi-check-circle-fill me-1"></i> Yêu cầu đã được gửi! Chuyên viên sẽ gọi cho bạn trong ít phút.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Fallback: If on a page (e.g. Admin) that doesn't have #cpsFloatingButtons, create a unified trigger button
        let triggerBtn = document.getElementById('cpsChatTriggerBtn');
        let invitePill = document.getElementById('cpsChatInvitePill');
        let dismissPill = document.getElementById('cpsChatDismissPill');

        if (!triggerBtn) {
            const adminCluster = document.createElement('div');
            adminCluster.className = 'cps-floating-buttons';
            adminCluster.innerHTML = `
                <div class="cps-float-chat-wrap">
                    <div class="cps-chat-invite-pill" id="cpsChatInvitePill">
                        <span class="cps-pulse-beacon"></span>
                        <span>Chatbot & Tư vấn viên 24/7</span>
                        <i class="bi bi-x-circle-fill text-muted ms-1" id="cpsChatDismissPill" title="Ẩn"></i>
                    </div>
                    <button type="button" id="cpsChatTriggerBtn" class="cps-float-btn cps-float-chat" title="Chatbot & Tư vấn viên CellphoneS">
                        <i class="bi bi-headset" id="cpsChatTriggerIcon"></i>
                        <span class="cps-chat-badge-ai">AI</span>
                    </button>
                </div>
            `;
            document.body.appendChild(adminCluster);

            triggerBtn = document.getElementById('cpsChatTriggerBtn');
            invitePill = document.getElementById('cpsChatInvitePill');
            dismissPill = document.getElementById('cpsChatDismissPill');
        }

        const triggerIcon = document.getElementById('cpsChatTriggerIcon');
        const chatWindow = document.getElementById('cpsChatWindow');
        const minBtn = document.getElementById('cpsChatMinBtn');
        const closeBtn = document.getElementById('cpsChatCloseBtn');

        const tabBtnBot = document.getElementById('tabBtnBot');
        const tabBtnAdvisor = document.getElementById('tabBtnAdvisor');
        const tabBot = document.getElementById('tabBot');
        const tabAdvisor = document.getElementById('tabAdvisor');
        const headerIcon = document.getElementById('cpsHeaderIcon');
        const headerStatus = document.getElementById('cpsHeaderStatus');

        const chatStream = document.getElementById('cpsChatStream');
        const inputField = document.getElementById('cpsChatInputField');
        const sendBtn = document.getElementById('cpsChatSendAction');

        // Toggle Open / Close
        function toggleChatWindow(forceOpen = null) {
            const isOpen = forceOpen !== null ? forceOpen : !chatWindow.classList.contains('open');
            if (isOpen) {
                chatWindow.classList.add('open');
                if (triggerBtn) triggerBtn.classList.add('active');
                if (triggerIcon) {
                    triggerIcon.classList.remove('bi-headset');
                    triggerIcon.classList.add('bi-x-lg');
                }
                if (invitePill) invitePill.style.display = 'none';
                setTimeout(() => { if (inputField) inputField.focus(); }, 200);
            } else {
                chatWindow.classList.remove('open');
                if (triggerBtn) triggerBtn.classList.remove('active');
                if (triggerIcon) {
                    triggerIcon.classList.remove('bi-x-lg');
                    triggerIcon.classList.add('bi-headset');
                }
            }
        }

        if (triggerBtn) triggerBtn.addEventListener('click', () => toggleChatWindow());
        if (minBtn) minBtn.addEventListener('click', () => toggleChatWindow(false));
        if (closeBtn) closeBtn.addEventListener('click', () => toggleChatWindow(false));
        if (invitePill) {
            invitePill.addEventListener('click', (e) => {
                if (e.target.id !== 'cpsChatDismissPill') {
                    toggleChatWindow(true);
                }
            });
        }
        if (dismissPill) {
            dismissPill.addEventListener('click', (e) => {
                e.stopPropagation();
                invitePill.style.display = 'none';
            });
        }

        // Tab Switching
        function switchTab(tab) {
            if (tab === 'bot') {
                tabBtnBot.classList.add('active');
                tabBtnAdvisor.classList.remove('active');
                tabBot.classList.remove('d-none');
                tabAdvisor.classList.add('d-none');
                headerIcon.className = 'bi bi-robot';
                headerStatus.innerText = 'Trợ lý AI trực tuyến 24/7';
                setTimeout(() => { if (inputField) inputField.focus(); }, 150);
            } else {
                tabBtnAdvisor.classList.add('active');
                tabBtnBot.classList.remove('active');
                tabAdvisor.classList.remove('d-none');
                tabBot.classList.add('d-none');
                headerIcon.className = 'bi bi-headset';
                headerStatus.innerText = 'Chuyên viên Trần Minh Hoàng (Online)';
            }
        }

        if (tabBtnBot) tabBtnBot.addEventListener('click', () => switchTab('bot'));
        if (tabBtnAdvisor) tabBtnAdvisor.addEventListener('click', () => switchTab('advisor'));

        // Smart Knowledge Base Engine
        function generateBotAnswer(query) {
            const q = query.toLowerCase().trim();

            if (q.includes('iphone') || q.includes('apple') || q.includes('16 pro')) {
                return `📱 <strong>Báo giá iPhone chính hãng hot nhất tại CellphoneS:</strong><br>
                • <strong>iPhone 16 Pro Max 256GB</strong>: Từ 34.490.000₫ (Trợ giá thu cũ 4 triệu)<br>
                • <strong>iPhone 16 128GB</strong>: Từ 21.990.000₫<br>
                • <strong>iPhone 15 Pro Max 256GB</strong>: Từ 28.990.000₫<br>
                👉 Quý khách có thể xem đầy đủ tại <a href="/Product/Category?slug=dien-thoai">Danh mục iPhone</a> hoặc chuyển sang tab <strong>Tư Vấn Viên</strong> để giữ hàng ưu đãi!`;
            }

            if (q.includes('samsung') || q.includes('galaxy') || q.includes('s24')) {
                return `✨ <strong>Báo giá Samsung Galaxy nổi bật:</strong><br>
                • <strong>Galaxy S24 Ultra 5G</strong>: Quyền năng Galaxy AI, giá từ 27.990.000₫<br>
                • <strong>Galaxy Z Fold6 / Z Flip6</strong>: Điện thoại gập thế hệ mới<br>
                • <strong>Galaxy A55 5G</strong>: Bán chạy nhất phân khúc tầm trung<br>
                👉 Xem ưu đãi trả góp 0% tại <a href="/Product/Category?slug=dien-thoai">Danh mục điện thoại</a>.`;
            }

            if (q.includes('bảo hành') || q.includes('imei') || q.includes('serial')) {
                return `🛡️ <strong>Chính sách Bảo hành & Tra cứu IMEI:</strong><br>
                Mọi thiết bị mua tại CellphoneS đều được cấp <strong>Phiếu bảo hành điện tử chính hãng</strong> từ 12 - 24 tháng.<br>
                👉 Quý khách có thể tra cứu tình trạng bảo hành theo mã IMEI tại: <a href="/Warranty/Lookup">Trang Tra Cứu Bảo Hành IMEI</a>.`;
            }

            if (q.includes('sửa chữa') || q.includes('điện thoại vui') || q.includes('thay pin') || q.includes('thay màn')) {
                return `🔧 <strong>Dịch vụ sửa chữa Điện Thoại Vui:</strong><br>
                CellphoneS hợp tác trực tiếp cùng hệ thống Điện Thoại Vui hỗ trợ sửa chữa, thay pin, ép kính lấy ngay trong 30-60 phút.<br>
                👉 Quý khách có thể đăng ký lịch trước để được giảm giá và không phải chờ đợi tại: <a href="/Repair/Booking">Đặt Lịch Sửa Chữa Điện Thoại Vui</a>.`;
            }

            if (q.includes('thu cũ') || q.includes('đổi mới') || q.includes('trade in') || q.includes('lên đời')) {
                return `🔄 <strong>Chương trình Thu Cũ Đổi Mới tại CellphoneS:</strong><br>
                • Thu mua máy cũ với giá tốt nhất thị trường.<br>
                • Trợ giá lên đời máy mới lên đến <strong>4.000.000₫</strong>.<br>
                • Hỗ trợ thu mua cả máy trầy xước, xách tay, không phụ kiện.<br>
                👉 Định giá thiết bị ngay tại: <a href="/TradeIn">Thu Cũ Đổi Mới</a>.`;
            }

            if (q.includes('giảm giá') || q.includes('voucher') || q.includes('khuyến mãi') || q.includes('coupon') || q.includes('mã giảm')) {
                return `🏷️ <strong>Kho Voucher Miễn Phí Mỗi Ngày:</strong><br>
                • Điểm danh mỗi ngày để rinh ngay mã giảm đến <strong>500.000₫</strong> & Freeship 0Đ!<br>
                • Áp dụng song song cả mã đơn hàng và mã vận chuyển tại CellphoneS.<br>
                • Giảm thêm đến 500.000₫ khi thanh toán qua ví điện tử VNPAY / MoMo.<br>
                👉 Nhận mã ngay tại: <a href="/Voucher" class="fw-bold text-danger">🎁 Kho Voucher Miễn Phí Mỗi Ngày</a>!`;
            }

            if (q.includes('tư vấn viên') || q.includes('nhân viên') || q.includes('người thật') || q.includes('hotline') || q.includes('gọi')) {
                setTimeout(() => switchTab('advisor'), 1200);
                return `👨‍💼 <em>Dạ vâng! Em đang chuyển kết nối sang Chuyên viên tư vấn CellphoneS cho quý khách ngay đây ạ...</em>`;
            }

            return `Dạ câu hỏi của quý khách đã được ghi nhận! Quý khách có thể xem thêm tại <a href="/">Trang chủ CellphoneS</a> hoặc chuyển sang tab <strong>Tư Vấn Viên</strong> để chuyên viên hỗ trợ 1:1, hoặc gọi tổng đài miễn phí <strong>1800.2097</strong> nhé!`;
        }

        // Send User Message & Trigger Bot Reply
        function handleUserMessage(text) {
            if (!text.trim()) return;

            // 1. Append User Bubble
            const userRow = document.createElement('div');
            userRow.className = 'cps-chat-bubble-row user';
            userRow.innerHTML = `
                <div class="cps-bubble-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="cps-bubble-content">${escapeHtml(text)}</div>
            `;
            chatStream.appendChild(userRow);
            chatStream.scrollTop = chatStream.scrollHeight;
            inputField.value = '';

            // 2. Typing Indicator
            const typingRow = document.createElement('div');
            typingRow.className = 'cps-chat-bubble-row bot';
            typingRow.id = 'cpsChatTyping';
            typingRow.innerHTML = `
                <div class="cps-bubble-avatar"><i class="bi bi-robot"></i></div>
                <div class="cps-typing-indicator">
                    <span class="cps-typing-dot"></span>
                    <span class="cps-typing-dot"></span>
                    <span class="cps-typing-dot"></span>
                </div>
            `;
            chatStream.appendChild(typingRow);
            chatStream.scrollTop = chatStream.scrollHeight;

            // 3. Bot responds after 750ms
            setTimeout(() => {
                const typingEl = document.getElementById('cpsChatTyping');
                if (typingEl) typingEl.remove();

                const botReply = generateBotAnswer(text);
                const botRow = document.createElement('div');
                botRow.className = 'cps-chat-bubble-row bot';
                botRow.innerHTML = `
                    <div class="cps-bubble-avatar"><i class="bi bi-robot"></i></div>
                    <div class="cps-bubble-content">${botReply}</div>
                `;
                chatStream.appendChild(botRow);
                chatStream.scrollTop = chatStream.scrollHeight;
            }, 750);
        }

        function escapeHtml(string) {
            return String(string).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        if (sendBtn) {
            sendBtn.addEventListener('click', () => handleUserMessage(inputField.value));
        }
        if (inputField) {
            inputField.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleUserMessage(inputField.value);
                }
            });
        }

        // Delegate Click on Quick Action Chips
        if (chatStream) {
            chatStream.addEventListener('click', function (e) {
                const chip = e.target.closest('.cps-chip-btn');
                if (chip) {
                    const query = chip.getAttribute('data-query') || chip.innerText;
                    handleUserMessage(query);
                }
            });
        }

        // Callback Form Submission
        const cbForm = document.getElementById('cpsCallbackForm');
        const cbSuccess = document.getElementById('cbAlertSuccess');
        if (cbForm) {
            cbForm.addEventListener('submit', function (e) {
                e.preventDefault();
                const name = document.getElementById('cbName').value;
                const phone = document.getElementById('cbPhone').value;
                const topic = document.getElementById('cbTopic').value;

                if (cbSuccess) {
                    cbSuccess.classList.remove('d-none');
                    cbForm.reset();
                    setTimeout(() => {
                        cbSuccess.classList.add('d-none');
                    }, 5000);
                }
            });
        }
    });
</script>
