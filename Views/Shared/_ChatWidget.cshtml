                    <div class="small text-muted mt-2">Quý khách có thể chọn nhanh câu hỏi dưới đây hoặc nhập tin nhắn:</div>
                </div>
            </div>

            <!-- Suggested Quick Chips -->
            <div class="cps-chat-chips" id="cpsInitialChips">
                <button type="button" class="cps-chip-btn" data-query="Tư vấn iPhone 16 Pro Max">📱 iPhone 16 Series</button>
                <button type="button" class="cps-chip-btn" data-query="Tra cứu bảo hành theo IMEI">🛡️ Tra cứu bảo hành IMEI</button>
                <button type="button" class="cps-chip-btn" data-query="Thu cũ đổi mới trợ giá">🔄 Thu cũ đổi mới trợ giá</button>
                <button type="button" class="cps-chip-btn" data-query="Đặt lịch sửa chữa">🔧 Đặt lịch sửa Điện Thoại Vui</button>
                <button type="button" class="cps-chip-btn" data-query="Mã giảm giá hôm nay">🏷️ Mã giảm giá / Voucher</button>
                <button type="button" class="cps-chip-btn" data-query="Kết nối tư vấn viên">👨‍💼 Gặp chuyên viên tư vấn</button>
            </div>
        </div>

        <!-- Footer Input -->
        <div class="cps-chat-footer">
            <div class="cps-chat-input-wrapper">
                <input type="text" id="cpsChatInputField" class="cps-chat-input" placeholder="Hỏi giá máy, bảo hành, sửa chữa..." autocomplete="off" />
                <button type="button" id="cpsChatSendAction" class="cps-chat-send-btn" title="Gửi câu hỏi">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ==========================================
         PANE 2: TƯ VẤN VIÊN THỰC TẾ (1:1 SUPPORT)
         ========================================== -->
    <div class="cps-chat-tab-pane d-none" id="tabAdvisor">
