            </button>
            <button type="button" class="cps-chat-ctrl-btn" id="cpsChatCloseBtn" title="Đóng">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- Mode Switcher Tabs -->
    <div class="cps-chat-tabs">
        <button type="button" class="cps-chat-tab-btn active" id="tabBtnBot" data-target="tabBot">
            <i class="bi bi-robot"></i>
            <span>Trợ Lý AI 24/7</span>
        </button>
        <button type="button" class="cps-chat-tab-btn" id="tabBtnAdvisor" data-target="tabAdvisor">
            <i class="bi bi-headset"></i>
            <span>Tư Vấn Viên</span>
            <span class="badge bg-success ms-1 py-0 px-1" style="font-size: 9px;">Online</span>
        </button>
    </div>

    <!-- ==========================================
         PANE 1: TRỢ LÝ CHATBOT AI
         ========================================== -->
