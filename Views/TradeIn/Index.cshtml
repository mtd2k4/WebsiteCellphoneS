@model WebsiteBanDienThoai.Models.ViewModels.TradeInPageViewModel
@{
    ViewData["Title"] = "Thu Cũ Đổi Mới - Bán Lại Máy Cũ Lên Đời Siêu Phẩm | CellphoneS";
}

<div class="container my-4">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 py-2 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door-fill me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Thu cũ đổi mới</li>
        </ol>
    </nav>

    <!-- HERO BANNER SECTION (CHUẨN CELLPHONES) -->
    <div class="card border-0 shadow-sm overflow-hidden mb-4" style="background: linear-gradient(135deg, #d70018 0%, #b30012 55%, #7a000c 100%); border-radius: 18px;">
        <div class="card-body p-4 p-md-5 text-white position-relative">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-warning text-dark px-3 py-2 fw-bold text-uppercase rounded-pill shadow-sm">
                            <i class="bi bi-fire text-danger me-1"></i> ĐẶC QUYỀN CELLPHONES
                        </span>
                        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 fw-bold rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> CAM KẾT S-BUYBACK
                        </span>
                    </div>
                    <h1 class="display-6 fw-black mb-2 text-uppercase" style="font-weight: 800;">
                        Thu Cũ Đổi Mới - Lên Đời Giá Hời
                    </h1>
                    <p class="fs-5 mb-4 text-white-50">
                        Định giá online 60 giây • Trợ giá lên đời đến <strong class="text-warning">4.000.000₫</strong> • Tặng thêm <strong class="text-warning">5% cho Smember</strong>
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="#tradein-wizard" class="btn btn-warning text-dark fw-bolder px-4 py-2 shadow rounded-pill">
                            <i class="bi bi-calculator-fill me-1"></i> ĐỊNH GIÁ NGAY BÂY GIỜ
                        </a>
                        <a asp-action="Tracking" class="btn btn-outline-light fw-bold px-4 py-2 rounded-pill">
                            <i class="bi bi-search me-1"></i> Tra cứu phiếu thu cũ
                        </a>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-block text-center position-relative">
                    <div class="p-3 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-25 shadow-lg backdrop-blur">
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="p-2 bg-white rounded-3 text-dark">
                                    <div class="fs-4 text-danger fw-bold"><i class="bi bi-shield-lock-fill"></i></div>
                                    <div class="fw-bold small">Không ép giá</div>
                                    <small class="text-muted" style="font-size: 11px;">Minh bạch 5 bậc</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-white rounded-3 text-dark">
                                    <div class="fs-4 text-danger fw-bold"><i class="bi bi-clock-history"></i></div>
                                    <div class="fw-bold small">15 phút</div>
                                    <small class="text-muted" style="font-size: 11px;">Nhận tiền / máy</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 bg-white rounded-3 text-dark">
                                    <div class="fs-4 text-danger fw-bold"><i class="bi bi-gift-fill"></i></div>
                                    <div class="fw-bold small">+4 Triệu</div>
                                    <small class="text-muted" style="font-size: 11px;">Trợ giá độc quyền</small>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 text-white-50 small">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> Hơn 120 cửa hàng CellphoneS sẵn sàng phục vụ
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHÍNH SÁCH ĐỘC QUYỀN CELLPHONES HIGHLIGHTS -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-left: 5px solid #f97316 !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-25 text-warning-emphasis d-flex align-items-center justify-content-center p-3 me-3 fs-3">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">
                            Mua trước - Thu cũ sau (trong 3 ngày)
                        </h6>
                        <small class="text-muted">
                            Mua máy mới mang về trải nghiệm, sao lưu dữ liệu thong thả. Mang máy cũ đến sau 3 ngày vẫn nhận trọn vẹn trợ giá và ưu đãi!
                        </small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left: 5px solid #22c55e !important;">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-25 text-success d-flex align-items-center justify-content-center p-3 me-3 fs-3">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold text-dark mb-1">
                            Chương trình S-BuyBack bảo chứng
                        </h6>
                        <small class="text-muted">
                            Cam kết thu lại thiết bị với mức giá cao nhất lên đến 65% trong 15 tháng. Thủ tục nhanh gọn, bảo vệ quyền lợi người dùng.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN INTERACTIVE WIZARD -->
    <div id="tradein-wizard" class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        
        <!-- DEVICE CATEGORY TABS (CELLPHONES BENCHMARK) -->
        <div class="bg-light p-2 border-bottom">
            <div class="d-flex flex-wrap gap-2 justify-content-center" id="device-category-tabs">
                @foreach (var type in Model.DeviceTypes)
                {
                    bool isActive = string.Equals(type, Model.SelectedDeviceType, StringComparison.OrdinalIgnoreCase);
                    string icon = type switch
                    {
                        "Điện thoại" => "bi-phone",
                        "Laptop" => "bi-laptop",
                        "Tablet" => "bi-tablet",
                        "Đồng hồ" => "bi-smartwatch",
                        "Tai nghe" => "bi-headphones",
                        _ => "bi-device-ssd"
                    };
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 category-tab-btn @(isActive ? "active text-white" : "bg-white")"
                            data-type="@type" onclick="onSwitchCategory('@type', this)">
                        <i class="bi @icon me-1"></i> @type
                    </button>
                }
            </div>
        </div>

        <!-- ACTION SWITCHER: LÊN ĐỜI MÁY MỚI vs BÁN LẠI NHẬN TIỀN -->
        <div class="p-3 bg-white border-bottom text-center">
            <div class="d-inline-flex p-1 bg-light rounded-pill border">
                <button type="button" id="tab-action-upgrade" class="btn btn-sm rounded-pill px-4 fw-bold action-toggle-btn active" onclick="switchActionType('Upgrade')">
                    <i class="bi bi-stars text-danger me-1"></i> Lên đời máy mới (Có trợ giá đến 4 Triệu)
                </button>
                <button type="button" id="tab-action-cashout" class="btn btn-sm rounded-pill px-4 fw-bold action-toggle-btn text-muted" onclick="switchActionType('CashOut')">
                    <i class="bi bi-cash-stack text-success me-1"></i> Bán lại máy cũ (Nhận tiền ngay)
                </button>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                
                <!-- CỘT TRÁI: CÁC BƯỚC ĐỊNH GIÁ -->
                <div class="col-lg-7">
                    
                    <!-- BƯỚC 1: CHỌN MÁY CŨ & TÌM KIẾM NHANH -->
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-danger rounded-circle me-2 px-2 py-1">1</span>
                                <h5 class="fw-bold mb-0 text-dark">Chọn thiết bị bạn muốn thu cũ</h5>
                            </div>
                            <span class="text-muted small" id="lbl-current-category">Danh mục: <strong class="text-danger">@Model.SelectedDeviceType</strong></span>
                        </div>

                        <!-- LIVE SEARCH BOX (AUTOCOMPLETE) -->
                        <div class="position-relative mb-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-danger-subtle"><i class="bi bi-search text-danger"></i></span>
                                <input type="text" id="tradein-live-search" class="form-control border-danger-subtle shadow-none" 
                                       placeholder="Tìm nhanh model máy cũ (vd: iPhone 14 Pro Max, MacBook Air M1, Galaxy S23...)"
                                       oninput="handleLiveSearch(this.value)" autocomplete="off">
                                <button type="button" class="btn btn-outline-secondary border-danger-subtle" onclick="clearLiveSearch()" title="Xóa tìm kiếm">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <!-- Live search dropdown popup -->
                            <div id="live-search-results" class="list-group position-absolute w-100 shadow-lg rounded-3 mt-1 overflow-auto d-none" 
                                 style="max-height: 240px; z-index: 1050; background: #ffffff;">
                            </div>
                        </div>

                        <!-- Brand Pills -->
                        <div class="d-flex flex-wrap gap-2 mb-3" id="brand-pills-container">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 brand-pill active" 
                                    data-brand="" onclick="onSelectBrand('', this)">
                                Tất cả hãng
                            </button>
                            @foreach (var brand in Model.Brands)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 brand-pill" 
                                        data-brand="@brand" onclick="onSelectBrand('@brand', this)">
                                    @brand
                                </button>
                            }
                        </div>

                        <!-- Dropdown chọn máy cũ -->
                        <div class="mb-2">
                            <label class="form-label small text-muted fw-bold">Hoặc chọn model từ danh sách:</label>
                            <select id="select-old-device" class="form-select form-select-lg border-danger-subtle shadow-none" onchange="onSelectOldDevice()">
                                <option value="" disabled>-- Vui lòng chọn thiết bị cũ --</option>
                                @{
                                    var groupedDevices = Model.FeaturedOldDevices.GroupBy(d => d.Brand);
                                    bool isFirstDev = true;
                                }
                                @foreach (var grp in groupedDevices)
                                {
                                    <optgroup label="Hãng @grp.Key">
                                        @foreach (var dev in grp)
                                        {
                                            <option value="@dev.Id" data-base-price="@((long)dev.BasePrice)" data-brand="@dev.Brand" data-name="@dev.ModelName" data-storage="@dev.Storage" selected="@(isFirstDev)">
                                                [@dev.Brand] @dev.ModelName - @dev.Storage (Định giá loại 1: @dev.BasePrice.ToString("N0")₫)
                                            </option>
                                            isFirstDev = false;
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- BƯỚC 2: CHỌN TÌNH TRẠNG MÁY (5 BẬC CELLPHONES) -->
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-danger rounded-circle me-2 px-2 py-1">2</span>
                                <h5 class="fw-bold mb-0 text-dark">Tình trạng thực tế của máy cũ</h5>
                            </div>
                            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Minh bạch 5 cấp độ CellphoneS</span>
                        </div>

                        <div class="row g-2" id="condition-cards">
                            <!-- Loại 1 -->
                            <div class="col-md-12">
                                <label class="condition-card p-3 rounded-3 border w-100 cursor-pointer position-relative active" for="cond-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" name="conditionGrade" id="cond-1" value="1" checked onchange="recalculate()">
                                            <label class="form-check-label fw-bold text-dark" for="cond-1">
                                                Loại 1: Máy đẹp như mới (99%)
                                            </label>
                                        </div>
                                        <span class="badge bg-danger px-2 py-1">100% Giá thu</span>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4" style="font-size: 12px;">
                                        Màn hình đẹp không trầy xước, thân máy đẹp không trầy, pin tốt (>85%), mọi chức năng hoạt động hoàn hảo.
                                    </small>
                                </label>
                            </div>

                            <!-- Loại 2 -->
                            <div class="col-md-12">
                                <label class="condition-card p-3 rounded-3 border w-100 cursor-pointer position-relative" for="cond-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" name="conditionGrade" id="cond-2" value="2" onchange="recalculate()">
                                            <label class="form-check-label fw-bold text-dark" for="cond-2">
                                                Loại 2: Trầy xước nhẹ (95%)
                                            </label>
                                        </div>
                                        <span class="badge bg-secondary px-2 py-1">~88% Giá thu</span>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4" style="font-size: 12px;">
                                        Màn hình đẹp, thân máy xước nhẹ lông mèo, không cấn móp, mọi chức năng hoạt động bình thường.
                                    </small>
                                </label>
                            </div>

                            <!-- Loại 3 -->
                            <div class="col-md-12">
                                <label class="condition-card p-3 rounded-3 border w-100 cursor-pointer position-relative" for="cond-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" name="conditionGrade" id="cond-3" value="3" onchange="recalculate()">
                                            <label class="form-check-label fw-bold text-dark" for="cond-3">
                                                Loại 3: Trầy cấn nhiều (90%)
                                            </label>
                                        </div>
                                        <span class="badge bg-secondary px-2 py-1">~72% Giá thu</span>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4" style="font-size: 12px;">
                                        Màn hình trầy xước thấy rõ, thân máy cấn móp nhẹ ở góc hoặc viền, pin chai nhẹ.
                                    </small>
                                </label>
                            </div>

                            <!-- Loại 4 -->
                            <div class="col-md-12">
                                <label class="condition-card p-3 rounded-3 border w-100 cursor-pointer position-relative" for="cond-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" name="conditionGrade" id="cond-4" value="4" onchange="recalculate()">
                                            <label class="form-check-label fw-bold text-dark" for="cond-4">
                                                Loại 4: Màn ám ố / Nứt kính nhẹ
                                            </label>
                                        </div>
                                        <span class="badge bg-secondary px-2 py-1">~55% Giá thu</span>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4" style="font-size: 12px;">
                                        Màn hình ám nhẹ, sọc nhẹ hoặc thân vỡ kính lưng, cấn móp sâu, hoạt động bình thường.
                                    </small>
                                </label>
                            </div>

                            <!-- Loại 5 -->
                            <div class="col-md-12">
                                <label class="condition-card p-3 rounded-3 border w-100 cursor-pointer position-relative" for="cond-5">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="form-check m-0">
                                            <input class="form-check-input" type="radio" name="conditionGrade" id="cond-5" value="5" onchange="recalculate()">
                                            <label class="form-check-label fw-bold text-dark" for="cond-5">
                                                Loại 5: Lỗi chức năng / hỏng linh kiện
                                            </label>
                                        </div>
                                        <span class="badge bg-secondary px-2 py-1">~40% Giá thu</span>
                                    </div>
                                    <small class="text-muted d-block mt-1 ps-4" style="font-size: 12px;">
                                        Máy lỗi một vài tính năng (FaceID/Vân tay, camera, mic...) hoặc màn nứt vỡ nhưng máy vẫn lên nguồn.
                                    </small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- BƯỚC 3: ĐẶC QUYỀN HỘI VIÊN SMEMBER (CELLPHONES BONUS +5%) -->
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-danger rounded-circle me-2 px-2 py-1">3</span>
                                <h5 class="fw-bold mb-0 text-dark">Đặc quyền Hội viên Smember</h5>
                            </div>
                            <span class="badge bg-warning text-dark"><i class="bi bi-gift-fill me-1"></i>Tặng thêm 5%</span>
                        </div>
                        <p class="small text-muted mb-2">Hội viên CellphoneS được tặng thêm 5% giá trị thu mua máy cũ (tối đa 300k cho S-Mem, 500k cho S-VIP):</p>
                        
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="p-2 border rounded-3 w-100 cursor-pointer text-center smember-tier-card @(Model.CurrentUserSmemberTier == "None" ? "border-danger bg-danger-subtle" : "bg-light")">
                                    <input type="radio" name="smemberTier" value="None" class="d-none" @(Model.CurrentUserSmemberTier == "None" ? "checked" : "") onchange="onSelectSmemberTier(this)">
                                    <div class="fw-bold text-dark small">Khách thông thường</div>
                                    <small class="text-muted" style="font-size: 11px;">Không có ưu đãi</small>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="p-2 border rounded-3 w-100 cursor-pointer text-center smember-tier-card @(Model.CurrentUserSmemberTier == "S-Mem" ? "border-danger bg-danger-subtle" : "bg-light")">
                                    <input type="radio" name="smemberTier" value="S-Mem" class="d-none" @(Model.CurrentUserSmemberTier == "S-Mem" ? "checked" : "") onchange="onSelectSmemberTier(this)">
                                    <div class="fw-bold text-danger small"><i class="bi bi-gem me-1"></i>Thành viên S-Mem</div>
                                    <small class="text-success fw-semibold" style="font-size: 11px;">+5% (Tối đa 300K)</small>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="p-2 border rounded-3 w-100 cursor-pointer text-center smember-tier-card @(Model.CurrentUserSmemberTier == "S-VIP" ? "border-danger bg-danger-subtle" : "bg-light")">
                                    <input type="radio" name="smemberTier" value="S-VIP" class="d-none" @(Model.CurrentUserSmemberTier == "S-VIP" ? "checked" : "") onchange="onSelectSmemberTier(this)">
                                    <div class="fw-bold text-danger small"><i class="bi bi-crown me-1"></i>Thành viên S-VIP</div>
                                    <small class="text-success fw-semibold" style="font-size: 11px;">+5% (Tối đa 500K)</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- BƯỚC 4: CHỌN MÁY MUỐN LÊN ĐỜI (CHỈ ÁP DỤNG KHI UPGRADE) -->
                    <div id="section-target-product" class="mb-2">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-danger rounded-circle me-2 px-2 py-1">4</span>
                            <h5 class="fw-bold mb-0 text-dark">Bạn muốn lên đời siêu phẩm nào?</h5>
                        </div>

                        <div class="mb-3">
                            <select id="select-target-product" class="form-select form-select-lg border-danger-subtle" onchange="recalculate()">
                                @foreach (var prod in Model.TargetProducts)
                                {
                                    bool isSelected = Model.SelectedTargetProduct != null && Model.SelectedTargetProduct.Id == prod.Id;
                                    <option value="@prod.Id" data-price="@prod.SalePrice" data-name="@prod.Name" selected="@isSelected">
                                        @prod.Name - Giá ưu đãi: @prod.SalePrice.ToString("N0")₫
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                </div>

                <!-- CỘT PHẢI: BẢNG TÍNH MINH BẠCH & FORM ĐẶT LỊCH HẸN -->
                <div class="col-lg-5">
                    <div class="p-4 rounded-4 bg-light border border-danger-subtle shadow-sm position-sticky" style="top: 20px;">
                        
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                            <h5 class="fw-bold text-danger mb-0" id="box-summary-title">
                                <i class="bi bi-receipt me-1"></i> BẢNG TÍNH LÊN ĐỜI
                            </h5>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-shield-check me-1"></i>Giữ giá 30 ngày
                            </span>
                        </div>

                        <!-- Tóm tắt chi tiết -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Thiết bị thẩm định:</span>
                            <strong id="summary-old-name" class="text-dark small text-end">Chưa chọn</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Tình trạng máy:</span>
                            <span id="summary-condition" class="badge bg-light text-dark border small">Loại 1 (99%)</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Giá thu cơ sở:</span>
