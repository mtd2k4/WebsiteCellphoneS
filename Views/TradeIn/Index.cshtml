    <!-- CHÍNH SÁCH CAM KẾT & CÂU HỎI THƯỜNG GẶP -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-question-circle-fill text-danger me-2"></i> Câu hỏi thường gặp về Thu cũ đổi mới CellphoneS</h5>
