@section Scripts {
<script>
    function decodeHtml(html) {
        if (!html) return '';
        const txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
    }

    let currentCategory = decodeHtml('@Html.Raw(Model.SelectedDeviceType)') || 'Điện thoại';
    let currentBrand = '';
    let currentActionType = 'Upgrade'; // 'Upgrade' hoặc 'CashOut'
    let currentSmemberTier = decodeHtml('@Html.Raw(Model.CurrentUserSmemberTier)') || 'None';
    let currentCategoryModels = []; // Cache toàn bộ thiết bị của danh mục hiện tại

    function initModelsCacheFromDOM() {
        const select = document.getElementById("select-old-device");
        if (!select) return;
        const opts = Array.from(select.querySelectorAll("option")).filter(o => o.value);
        if (opts.length > 0) {
            currentCategoryModels = opts.map(o => ({
                id: parseInt(o.value),
                brand: (o.dataset.brand || '').trim(),
                deviceType: currentCategory,
                modelName: (o.dataset.name || '').trim(),
                storage: (o.dataset.storage || '').trim(),
                basePrice: parseFloat(o.dataset.basePrice) || 0,
                displayName: `${o.dataset.name || ''} ${o.dataset.storage || ''}`.trim()
            }));
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Khởi tạo ngày giờ hẹn mặc định: ngày mai 10:00 sáng
        const now = new Date();
        now.setDate(now.getDate() + 1);
        now.setHours(10, 0, 0, 0);
        const isoString = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        const dtInput = document.getElementById("cust-datetime");
        if (dtInput) dtInput.value = isoString;

        // Khởi tạo cache máy cũ từ các option đã được server render
        initModelsCacheFromDOM();

        // Chọn máy cũ đầu tiên nếu có
        const oldSelect = document.getElementById("select-old-device");
        const validOptions = oldSelect ? Array.from(oldSelect.options).filter(o => o.value) : [];
        if (validOptions.length > 0) {
            if (oldSelect.selectedIndex <= 0) {
                oldSelect.value = validOptions[0].value;
            }
        } else {
            // Dự phòng: Nếu server render chưa có danh sách máy, nạp ngay bằng AJAX
            loadModelsByCategoryAndBrand(currentCategory || 'Điện thoại', '');
        }

        // Tự động chọn chi nhánh theo khu vực người dùng đã lưu
        function syncTradeInBranchWithCity(city) {
            const branchSelect = document.getElementById("cust-branch");
            if (!branchSelect || branchSelect.options.length <= 1) return;

            city = city || (typeof getSavedCity === 'function' ? getSavedCity() : (localStorage.getItem('cps_selected_city') || 'Hồ Chí Minh'));
            let searchKw = city;
            if (city.includes('Hồ Chí Minh')) searchKw = 'TP.HCM';

            let matchedIndex = -1;
            for (let i = 1; i < branchSelect.options.length; i++) {
                const optText = branchSelect.options[i].text;
                if (optText.includes(searchKw) || optText.includes(city)) {
                    matchedIndex = i;
                    break;
                }
            }
            if (matchedIndex > 0) {
                branchSelect.selectedIndex = matchedIndex;
            } else if (branchSelect.selectedIndex <= 0) {
                branchSelect.selectedIndex = 1;
            }
        }

        syncTradeInBranchWithCity();

        // Lắng nghe khi người dùng đổi khu vực từ Header Modal
        window.addEventListener('cps:locationChanged', function (e) {
            if (e.detail && e.detail.city) {
                syncTradeInBranchWithCity(e.detail.city);
            }
        });

        recalculate();
    });

    // 1. Chuyển đổi loại thiết bị (Điện thoại, Laptop, Tablet, Đồng hồ, Tai nghe)
    function onSwitchCategory(category, btn) {
        currentCategory = decodeHtml(category) || 'Điện thoại';
        currentBrand = '';
        currentCategoryModels = []; // Reset cache cho danh mục mới

        document.querySelectorAll(".category-tab-btn").forEach(el => {
            el.classList.remove("active", "text-white");
            el.classList.add("bg-white");
        });
        if (btn) {
            btn.classList.add("active", "text-white");
            btn.classList.remove("bg-white");
        }

        const lblCat = document.getElementById("lbl-current-category");
        if (lblCat) lblCat.innerHTML = `Danh mục: <strong class="text-danger">${currentCategory}</strong>`;
        
        const searchInput = document.getElementById("tradein-live-search");
        if (searchInput) searchInput.value = "";
        hideLiveSearch();

        // 1. Tải danh sách Hãng độc lập
        fetch(`/TradeIn/GetBrands?deviceType=${encodeURIComponent(currentCategory)}`)
            .then(res => res.json())
            .then(brands => {
                const container = document.getElementById("brand-pills-container");
                if (container) {
                    let html = `<button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 brand-pill active" 
                                        data-brand="" onclick="onSelectBrand('', this)">Tất cả hãng</button>`;
                    brands.forEach(b => {
                        html += `<button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 brand-pill" 
                                         data-brand="${b}" onclick="onSelectBrand('${b}', this)">${b}</button>`;
                    });
                    container.innerHTML = html;
                }
            })
            .catch(err => console.error("Lỗi tải Hãng:", err));

        // 2. Tải danh sách Máy độc lập (không đợi Hãng)
        loadModelsByCategoryAndBrand(currentCategory, '');
    }

    // 2. Chọn Hãng (Lọc tức thì 0ms từ cache, cực kỳ mượt mà và không bao giờ lỗi)
    function onSelectBrand(brand, btn) {
        currentBrand = decodeHtml(brand ? brand.trim() : '');
        document.querySelectorAll(".brand-pill").forEach(el => el.classList.remove("active"));
        if (btn) btn.classList.add("active");

        // Nếu đã có cache máy của danh mục hiện tại -> lọc tức thì trên client!
        if (currentCategoryModels && currentCategoryModels.length > 0) {
            const filtered = currentBrand 
                ? currentCategoryModels.filter(m => m.brand.toLowerCase().trim() === currentBrand.toLowerCase().trim())
                : currentCategoryModels;
            renderModelsDropdown(filtered);
            return;
        }

        // Nếu cache chưa có, gọi fetch
        loadModelsByCategoryAndBrand(currentCategory, currentBrand);
    }

    function renderModelsDropdown(data) {
        const select = document.getElementById("select-old-device");
        if (!select) return;

        if (!data || data.length === 0) {
            select.innerHTML = '<option value="" disabled selected>-- Không có thiết bị phù hợp --</option>';
            return;
        }

        // Nhóm theo Hãng
        const groups = {};
        data.forEach(item => {
            const b = item.brand || 'Khác';
            if (!groups[b]) groups[b] = [];
            groups[b].push(item);
        });

        let html = '<option value="" disabled>-- Vui lòng chọn thiết bị cũ --</option>';
        let isFirst = true;

        Object.keys(groups).forEach(brandName => {
            html += `<optgroup label="Hãng ${brandName}">`;
            groups[brandName].forEach(item => {
                const selectedAttr = isFirst ? ' selected' : '';
                isFirst = false;
                const priceNum = Number(item.basePrice) || 0;
                html += `
                    <option value="${item.id}" 
                            data-base-price="${priceNum}" 
                            data-brand="${item.brand}" 
                            data-name="${item.modelName}" 
                            data-storage="${item.storage}"${selectedAttr}>
                        [${item.brand}] ${item.displayName} (Định giá loại 1: ${priceNum.toLocaleString('vi-VN')}₫)
                    </option>
                `;
            });
            html += `</optgroup>`;
        });

        select.innerHTML = html;
        recalculate();
    }

    function loadModelsByCategoryAndBrand(category, brand) {
        const select = document.getElementById("select-old-device");
        if (select && select.options.length <= 1) {
            select.innerHTML = '<option value="" disabled selected>⏳ Đang tải danh sách thiết bị...</option>';
        }

        let url = `/TradeIn/GetModels?deviceType=${encodeURIComponent(category)}`;
        if (brand) url += `&brand=${encodeURIComponent(brand)}`;

        fetch(url)
            .then(res => {
                if (!res.ok) throw new Error("HTTP error " + res.status);
                return res.json();
            })
            .then(data => {
                // Nếu tải toàn bộ category (không lọc brand), cập nhật cache
                if (!brand && data && data.length > 0) {
                    currentCategoryModels = data;
                }
                renderModelsDropdown(data);
            })
            .catch(err => {
                console.error("Lỗi tải dòng máy:", err);
                if (select && select.options.length <= 1) {
                    fetch('/TradeIn/GetModels?deviceType=' + encodeURIComponent('Điện thoại'))
                        .then(r => r.json())
                        .then(fallbackData => {
                            currentCategoryModels = fallbackData || [];
                            renderModelsDropdown(fallbackData);
                        })
                        .catch(() => {
                            select.innerHTML = '<option value="" disabled selected>⚠️ Không thể nạp thiết bị. Vui lòng thử lại!</option>';
                        });
                }
            });
    }

    // 3. Tìm kiếm tức thì (Live Autocomplete Search)
    let searchTimeout = null;
    function handleLiveSearch(query) {
        clearTimeout(searchTimeout);
        const resultsBox = document.getElementById("live-search-results");
        if (!query || query.trim().length < 2) {
            hideLiveSearch();
            return;
        }

        searchTimeout = setTimeout(() => {
            fetch(`/TradeIn/GetModels?keyword=${encodeURIComponent(query.trim())}`)
                .then(res => res.json())
                .then(items => {
                    if (!items || items.length === 0) {
                        resultsBox.innerHTML = '<div class="p-3 text-muted small text-center">Không tìm thấy máy phù hợp</div>';
                        resultsBox.classList.remove("d-none");
                        return;
                    }

                    let html = '';
                    items.forEach(item => {
                        const priceNum = Number(item.basePrice) || 0;
                        html += `
                            <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                               onclick="selectFromSearch(${item.id}, '${item.modelName.replace(/'/g, "\\'")}', '${item.storage}', ${priceNum}, '${item.brand}', '${item.deviceType || ''}')">
                                <div>
                                    <span class="badge bg-danger-subtle text-danger me-1">${item.deviceType || 'Máy'}</span>
                                    <strong class="text-dark small">${item.displayName}</strong>
                                </div>
                                <span class="text-danger fw-bold small">${priceNum.toLocaleString('vi-VN')}₫</span>
                            </a>
                        `;
                    });
                    resultsBox.innerHTML = html;
                    resultsBox.classList.remove("d-none");
                })
                .catch(err => console.error("Lỗi tìm kiếm:", err));
        }, 250);
    }

    function selectFromSearch(id, modelName, storage, basePrice, brand, deviceType) {
        hideLiveSearch();
        document.getElementById("tradein-live-search").value = `${modelName} ${storage}`;

        // Nếu thiết bị được chọn thuộc Category khác, đồng bộ tab
        if (deviceType && deviceType !== currentCategory) {
            currentCategory = deviceType;
            document.querySelectorAll(".category-tab-btn").forEach(el => {
                if (el.dataset.type === deviceType) {
                    el.classList.add("active", "text-white");
                    el.classList.remove("bg-white");
                } else {
                    el.classList.remove("active", "text-white");
                    el.classList.add("bg-white");
                }
            });
            const lblCat = document.getElementById("lbl-current-category");
            if (lblCat) lblCat.innerHTML = `Danh mục: <strong class="text-danger">${deviceType}</strong>`;
        }

        const select = document.getElementById("select-old-device");
        let foundOpt = Array.from(select.options).find(o => o.value == id);
        if (!foundOpt) {
            foundOpt = document.createElement("option");
            foundOpt.value = id;
            foundOpt.dataset.basePrice = basePrice;
            foundOpt.dataset.brand = brand;
            foundOpt.dataset.name = modelName;
            foundOpt.dataset.storage = storage;
            foundOpt.textContent = `[${brand}] ${modelName} ${storage} (Định giá loại 1: ${Number(basePrice).toLocaleString('vi-VN')}₫)`;
            select.appendChild(foundOpt);
        }
        foundOpt.selected = true;

        recalculate();
    }

    function clearLiveSearch() {
        document.getElementById("tradein-live-search").value = "";
        hideLiveSearch();
        loadModelsByCategoryAndBrand(currentCategory, currentBrand);
    }

    function hideLiveSearch() {
        const resultsBox = document.getElementById("live-search-results");
        if (resultsBox) resultsBox.classList.add("d-none");
    }

    document.addEventListener("click", function (e) {
        if (!e.target.closest("#tradein-live-search") && !e.target.closest("#live-search-results")) {
            hideLiveSearch();
        }
    });

    function onSelectOldDevice() {
        recalculate();
    }

    // 4. Chuyển đổi Action: Lên đời máy mới vs Bán lại nhận tiền
    function switchActionType(action) {
        currentActionType = action;
        const btnUpgrade = document.getElementById("tab-action-upgrade");
        const btnCashOut = document.getElementById("tab-action-cashout");
        const secTarget = document.getElementById("section-target-product");
        const boxUpgrade = document.getElementById("box-upgrade-calculation");
        const boxCashOut = document.getElementById("box-cashout-calculation");
        const rowSubsidy = document.getElementById("row-summary-subsidy");
        const lblTitle = document.getElementById("box-summary-title");
        const lblSubmit = document.getElementById("lbl-btn-submit");

        if (action === 'Upgrade') {
            btnUpgrade.classList.add("active");
            btnUpgrade.classList.remove("text-muted");
            btnCashOut.classList.remove("active");
            btnCashOut.classList.add("text-muted");

            secTarget.classList.remove("d-none");
            boxUpgrade.classList.remove("d-none");
            boxCashOut.classList.add("d-none");
            rowSubsidy.classList.remove("d-none");
            lblTitle.innerHTML = '<i class="bi bi-receipt me-1"></i> BẢNG TÍNH LÊN ĐỜI';
            lblSubmit.textContent = 'XÁC NHẬN ĐẶT LỊCH LÊN ĐỜI';
        } else {
            btnCashOut.classList.add("active");
            btnCashOut.classList.remove("text-muted");
            btnUpgrade.classList.remove("active");
            btnUpgrade.classList.add("text-muted");

            secTarget.classList.add("d-none");
            boxUpgrade.classList.add("d-none");
            boxCashOut.classList.remove("d-none");
            rowSubsidy.classList.add("d-none");
            lblTitle.innerHTML = '<i class="bi bi-cash-stack me-1"></i> BẢNG TÍNH BÁN LẠI NHẬN TIỀN';
            lblSubmit.textContent = 'XÁC NHẬN BÁN LẠI NHẬN TIỀN';
        }

        recalculate();
    }

    // 5. Chọn bậc hội viên Smember
    function onSelectSmemberTier(radio) {
        currentSmemberTier = radio.value;
        document.querySelectorAll(".smember-tier-card").forEach(c => {
            c.classList.remove("border-danger", "bg-danger-subtle");
            c.classList.add("bg-light");
        });
        const parentCard = radio.closest(".smember-tier-card");
        if (parentCard) {
            parentCard.classList.add("border-danger", "bg-danger-subtle");
            parentCard.classList.remove("bg-light");
        }
        recalculate();
    }

    // 6. Cập nhật thẻ tình trạng máy
    document.querySelectorAll('input[name="conditionGrade"]').forEach(radio => {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.condition-card').forEach(c => c.classList.remove('active'));
            const card = this.closest('.condition-card');
            if (card) card.classList.add('active');
        });
    });

    // 7. Tính toán lại toàn bộ bảng tính
    function recalculate() {
        const oldSelect = document.getElementById("select-old-device");
        if (!oldSelect || oldSelect.selectedIndex < 0) return;

        const selectedOldOpt = oldSelect.options[oldSelect.selectedIndex];
        if (!selectedOldOpt || !selectedOldOpt.value) return;

        const oldDeviceId = parseInt(selectedOldOpt.value);
        const conditionGrade = parseInt(document.querySelector('input[name="conditionGrade"]:checked')?.value || "1");

        const targetSelect = document.getElementById("select-target-product");
        const targetProductId = (currentActionType === 'Upgrade' && targetSelect && targetSelect.value) ? parseInt(targetSelect.value) : null;

        fetch('/TradeIn/Calculate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                oldDeviceId: oldDeviceId,
                conditionGrade: conditionGrade,
                targetProductId: targetProductId,
                actionType: currentActionType,
                smemberTier: currentSmemberTier
            })
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                document.getElementById("summary-old-name").textContent = `${res.oldDeviceName} ${res.oldDeviceStorage}`;
                document.getElementById("summary-condition").textContent = res.conditionName;
                document.getElementById("summary-old-price").textContent = res.baseEstimatePrice.toLocaleString('vi-VN') + '₫';
                
                // Thưởng Smember
                const rowSmember = document.getElementById("row-summary-smember");
                if (res.smemberBonus > 0) {
                    rowSmember.classList.remove("d-none");
                    document.getElementById("summary-smember-bonus").textContent = '+' + res.smemberBonus.toLocaleString('vi-VN') + '₫';
                } else {
                    document.getElementById("summary-smember-bonus").textContent = '+0₫';
                }

                // Trợ giá máy mới
                document.getElementById("summary-subsidy").textContent = '+' + res.subsidyAmount.toLocaleString('vi-VN') + '₫';
                document.getElementById("summary-total-benefit").textContent = res.totalBenefit.toLocaleString('vi-VN') + '₫';
                
                if (currentActionType === 'Upgrade') {
                    document.getElementById("summary-target-name").textContent = res.targetProductName;
                    document.getElementById("summary-target-price").textContent = res.targetProductPrice.toLocaleString('vi-VN') + '₫';
                    document.getElementById("summary-pay-diff").textContent = res.payDifference.toLocaleString('vi-VN') + '₫';
                } else {
                    document.getElementById("summary-cash-receive").textContent = res.totalBenefit.toLocaleString('vi-VN') + '₫';
                }
            }
        })
        .catch(err => console.error("Lỗi tính toán định giá:", err));
    }

    // 8. Gửi Form đặt lịch
    function handleBookSubmit(event) {
        event.preventDefault();

        const btn = document.getElementById("btn-submit-booking");
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tạo phiếu...';

        const oldSelect = document.getElementById("select-old-device");
        const selectedOldOpt = oldSelect.options[oldSelect.selectedIndex];

        const targetSelect = document.getElementById("select-target-product");
        const selectedTargetOpt = (currentActionType === 'Upgrade' && targetSelect) ? targetSelect.options[targetSelect.selectedIndex] : null;

        const oldPriceRaw = document.getElementById("summary-old-price").textContent.replace(/[^\d]/g, '');
        const smemberBonusRaw = document.getElementById("summary-smember-bonus").textContent.replace(/[^\d]/g, '');
        const subsidyRaw = document.getElementById("summary-subsidy").textContent.replace(/[^\d]/g, '');
        const totalRaw = document.getElementById("summary-total-benefit").textContent.replace(/[^\d]/g, '');
        const targetPriceRaw = (currentActionType === 'Upgrade') ? document.getElementById("summary-target-price").textContent.replace(/[^\d]/g, '') : '0';
        const payDiffRaw = (currentActionType === 'Upgrade') ? document.getElementById("summary-pay-diff").textContent.replace(/[^\d]/g, '') : '0';

        const payload = {
            customerName: document.getElementById("cust-name").value,
            phoneNumber: document.getElementById("cust-phone").value,
            email: document.getElementById("cust-email").value,
            oldDeviceName: selectedOldOpt.dataset.name || "Thiết bị cũ",
            oldDeviceStorage: selectedOldOpt.dataset.storage || "",
            conditionGrade: parseInt(document.querySelector('input[name="conditionGrade"]:checked')?.value || "1"),
            actionType: currentActionType,
            smemberTier: currentSmemberTier,
            smemberBonus: parseFloat(smemberBonusRaw) || 0,
            baseEstimatePrice: parseFloat(oldPriceRaw) || 0,
            subsidyAmount: (currentActionType === 'Upgrade') ? (parseFloat(subsidyRaw) || 0) : 0,
            totalBenefit: parseFloat(totalRaw) || 0,
            targetProductId: (currentActionType === 'Upgrade' && targetSelect && targetSelect.value) ? parseInt(targetSelect.value) : null,
            targetProductName: selectedTargetOpt ? selectedTargetOpt.dataset.name : "Không đổi máy",
            targetProductPrice: parseFloat(targetPriceRaw) || 0,
            payDifference: parseFloat(payDiffRaw) || 0,
            branchStore: document.getElementById("cust-branch").value,
            appointmentDate: document.getElementById("cust-datetime").value,
            customerNote: document.getElementById("cust-note").value
        };

        fetch('/TradeIn/Book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-check2-circle me-1"></i> <span id="lbl-btn-submit">${currentActionType === 'Upgrade' ? 'XÁC NHẬN ĐẶT LỊCH LÊN ĐỜI' : 'XÁC NHẬN BÁN LẠI NHẬN TIỀN'}</span>`;

            if (data.success) {
                document.getElementById("res-request-code").textContent = data.requestCode;
                document.getElementById("res-cust-name").textContent = data.customerName;
                document.getElementById("res-branch").textContent = data.branchStore;
                document.getElementById("res-datetime").textContent = data.appointmentDate;
                document.getElementById("res-smember-bonus").textContent = data.smemberBonus || "0₫";
                document.getElementById("res-total-benefit").textContent = data.totalBenefit;
                
                const payDiffRow = document.getElementById("res-paydiff-row");
                if (data.actionType === 'CashOut') {
                    payDiffRow.classList.add("d-none");
                    document.getElementById("res-modal-title").textContent = "ĐẶT LỊCH BÁN MÁY THÀNH CÔNG!";
                } else {
                    payDiffRow.classList.remove("d-none");
                    document.getElementById("res-pay-diff").textContent = data.payDifference;
                    document.getElementById("res-modal-title").textContent = "ĐẶT LỊCH THẨM ĐỊNH THÀNH CÔNG!";
                }

                const modal = new bootstrap.Modal(document.getElementById("modalBookingSuccess"));
                modal.show();
            } else {
                showError(data.message || "Có lỗi xảy ra khi đặt lịch. Vui lòng thử lại!");
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-check2-circle me-1"></i> <span id="lbl-btn-submit">${currentActionType === 'Upgrade' ? 'XÁC NHẬN ĐẶT LỊCH LÊN ĐỜI' : 'XÁC NHẬN BÁN LẠI NHẬN TIỀN'}</span>`;
            console.error("Lỗi đặt lịch:", err);
            showError("Không thể kết nối đến máy chủ. Vui lòng thử lại!");
        });
    }
</script>
}
