@model WebsiteBanDienThoai.Models.TradeInRequest?
@{
    ViewData["Title"] = "Tra Cứu Hồ Sơ Thu Cũ Đổi Mới | CellphoneS";
}

<div class="container my-4" style="max-width: 800px;">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 py-2 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door-fill me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="TradeIn" asp-action="Index" class="text-decoration-none text-muted">Thu cũ đổi mới</a></li>
            <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Tra cứu hồ sơ</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-danger text-white p-4 text-center">
            <h4 class="fw-bolder mb-1 text-uppercase"><i class="bi bi-search me-2"></i> TRA CỨU HỒ SƠ THU CŨ ĐỔI MỚI</h4>
            <p class="mb-0 text-white-50 small">Nhập Mã phiếu (ví dụ: CPS-TC-2410-0088) hoặc Số điện thoại đặt lịch để kiểm tra tiến độ</p>
        </div>
        <div class="card-body p-4">
            <form method="get" asp-action="Tracking" class="row g-2 mb-4 justify-content-center">
                <div class="col-sm-8">
                    <input type="text" name="code" class="form-control form-control-lg border-danger-subtle" 
                           placeholder="Nhập mã phiếu (CPS-TC-...) hoặc SĐT" value="@Context.Request.Query["code"]" required>
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> TRA CỨU
                    </button>
                </div>
            </form>

            @if (Model != null)
            {
                <div class="card border-danger-subtle rounded-3 overflow-hidden shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                        <div>
                            <span class="text-muted small">Mã hồ sơ:</span>
                            <strong class="text-danger fs-5 ms-1">@Model.RequestCode</strong>
                            @if (Model.ActionType == "CashOut")
                            {
                                <span class="badge bg-success ms-2"><i class="bi bi-cash-stack me-1"></i>Bán lại nhận tiền</span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-2"><i class="bi bi-stars me-1"></i>Lên đời máy mới</span>
                            }
                        </div>
                        <span class="badge @Model.StatusBadgeClass px-3 py-2 fs-6">
                            @Model.StatusText
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <!-- TIMELINE TRẠNG THÁI -->
                        <div class="row g-2 text-center mb-4">
                            <div class="col-3">
                                <div class="p-2 rounded bg-light border @(Model.Status >= 0 ? "border-danger text-danger" : "text-muted")">
                                    <i class="bi bi-file-earmark-check fs-4"></i>
                                    <div class="small fw-bold mt-1">1. Đã đặt lịch</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-light border @(Model.Status >= 1 ? "border-danger text-danger" : "text-muted")">
                                    <i class="bi bi-calendar-check fs-4"></i>
                                    <div class="small fw-bold mt-1">2. Đã xác nhận</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-light border @(Model.Status >= 2 ? "border-danger text-danger" : "text-muted")">
                                    <i class="bi bi-tools fs-4"></i>
                                    <div class="small fw-bold mt-1">3. Thẩm định</div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="p-2 rounded bg-light border @(Model.Status == 3 ? "border-success text-success fw-bold" : "text-muted")">
                                    <i class="bi bi-trophy-fill fs-4"></i>
                                    <div class="small fw-bold mt-1">4. Hoàn tất</div>
                                </div>
                            </div>
                        </div>

                        <!-- THÔNG TIN CHI TIẾT -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2"><i class="bi bi-person-fill text-danger me-1"></i> Thông tin khách hàng</h6>
                                <div class="small text-muted mb-1">Khách hàng: <strong class="text-dark">@Model.CustomerName</strong></div>
                                <div class="small text-muted mb-1">Số điện thoại: <strong class="text-dark">@Model.PhoneNumber</strong></div>
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <div class="small text-muted mb-1">Email: <span class="text-dark">@Model.Email</span></div>
                                }
                                <div class="small text-muted mb-1">Thời gian tạo phiếu: <span>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Lịch hẹn thẩm định</h6>
                                <div class="small text-muted mb-1">Cửa hàng: <strong class="text-danger">@Model.BranchStore</strong></div>
                                <div class="small text-muted mb-1">Giờ hẹn: <strong class="text-dark">@Model.AppointmentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                                @if (!string.IsNullOrEmpty(Model.CustomerNote))
                                {
                                    <div class="small text-muted mb-1">Ghi chú: <em>@Model.CustomerNote</em></div>
                                }
                            </div>

                            <div class="col-12">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2"><i class="bi bi-phone-fill text-danger me-1"></i> Chi tiết máy và định giá</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Thiết bị thẩm định</th>
                                                <th>Tình trạng</th>
                                                <th>Giá thu cũ</th>
                                                @if (Model.SmemberBonus > 0)
                                                {
                                                    <th>Thưởng Smember (5%)</th>
                                                }
                                                @if (Model.ActionType != "CashOut")
                                                {
                                                    <th>Trợ giá lên đời</th>
                                                }
                                                <th>Tổng thu lại</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="fw-bold text-dark">@Model.OldDeviceName @Model.OldDeviceStorage</td>
                                                <td>@Model.ConditionName</td>
                                                <td>@Model.BaseEstimatePrice.ToString("N0")₫</td>
                                                @if (Model.SmemberBonus > 0)
                                                {
                                                    <td class="text-primary fw-bold">+@Model.SmemberBonus.ToString("N0")₫</td>
                                                }
                                                @if (Model.ActionType != "CashOut")
                                                {
                                                    <td class="text-success fw-bold">+@Model.SubsidyAmount.ToString("N0")₫</td>
                                                }
                                                <td class="text-danger fw-bolder">@Model.TotalBenefit.ToString("N0")₫</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12">
                                @if (Model.ActionType == "CashOut")
                                {
                                    <div class="p-3 rounded-3 bg-light border border-success-subtle d-flex flex-wrap justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small">Hình thức giao dịch:</span>
                                            <h6 class="fw-bold text-success mb-0"><i class="bi bi-cash-stack me-1"></i>Bán lại lấy tiền mặt / Chuyển khoản</h6>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-muted small">Số tiền nhận được:</span>
                                            <div class="text-success fw-bolder fs-4">@Model.TotalBenefit.ToString("N0")₫</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 rounded-3 bg-light d-flex flex-wrap justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small">Máy mới muốn lên đời:</span>
                                            <h6 class="fw-bold text-dark mb-0">@(Model.TargetProductName ?? "Chưa chỉ định máy mới")</h6>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-muted small">Số tiền cần bù dự kiến:</span>
                                            <div class="text-danger fw-bolder fs-4">@Model.PayDifference.ToString("N0")₫</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                            <span class="small text-muted"><i class="bi bi-telephone-fill me-1"></i> Cần hỗ trợ? Gọi hotline: <strong class="text-danger">1800.2097</strong> (Miễn phí)</span>
                            <a asp-action="Index" class="btn btn-outline-danger btn-sm fw-bold">
                                <i class="bi bi-arrow-repeat me-1"></i> Định giá máy khác
                            </a>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(Context.Request.Query["code"]))
            {
                <div class="alert alert-warning text-center rounded-3 p-4">
                    <i class="bi bi-exclamation-triangle-fill fs-2 text-warning mb-2 d-block"></i>
                    <h5 class="fw-bold">Không tìm thấy hồ sơ phù hợp</h5>
                    <p class="small text-muted mb-3">Không có phiếu thu cũ nào trùng khớp với mã hoặc số điện thoại bạn vừa nhập. Vui lòng kiểm tra lại!</p>
                    <a asp-action="Index" class="btn btn-danger btn-sm fw-bold">Tạo phiếu định giá mới</a>
                </div>
            }
        </div>
    </div>
</div>
