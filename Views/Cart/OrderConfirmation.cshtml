@model WebsiteBanDienThoai.Models.Order

@{
    ViewData["Title"] = $"Đặt Hàng Thành Công #{Model.OrderCode} - CellphoneS";
}

<div class="container my-5" style="max-width: 800px;">
    <!-- CANVAS CONFETTI -->
    <canvas id="orderConfettiCanvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999;"></canvas>

    <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 text-center position-relative overflow-hidden">
        <!-- Accent Top Bar -->
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, #d70018 0%, #ff5252 50%, #d70018 100%);"></div>

        <!-- Success Animated Icon -->
        <div class="mx-auto mb-3" style="width: 76px; height: 76px; background: #e8f5e9; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(46, 125, 50, 0.15);">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 46px;"></i>
        </div>

        <h3 class="fw-bold text-dark mb-1">ĐẶT HÀNG THÀNH CÔNG!</h3>
        <p class="text-muted small mb-3">Cảm ơn quý khách đã tin chọn sản phẩm công nghệ chính hãng tại <strong>CellphoneS</strong>.</p>

        <!-- THÔNG BÁO TỰ ĐỘNG & EMAIL SMTP GỬI VỀ CHO KHÁCH & ADMIN -->
        <div class="alert alert-success border-0 bg-success bg-opacity-10 text-start py-3 px-3 mb-4 rounded-3 d-flex align-items-center gap-3">
            <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; font-size: 20px;">
                <i class="bi bi-envelope-check-fill"></i>
            </div>
            <div class="flex-grow-1 small">
                <div class="fw-bold text-success mb-1 d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span><i class="bi bi-check2-circle me-1"></i> Đã gửi Thông báo hệ thống & Email SMTP thành công!</span>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <a href="/emails/Order_@(Model.OrderCode)_Customer.html" target="_blank" class="badge bg-success text-white text-decoration-none px-2 py-1">
                            <i class="bi bi-envelope-open me-1"></i> Xem bản sao Email của bạn
                        </a>
                    }
                </div>
                <div class="text-muted" style="line-height: 1.5;">
                    • <strong>Khách hàng:</strong> Đã gửi thông báo về tài khoản Smember (Tích lũy <strong>+@(((int)(Model.TotalAmount / 100000m)).ToString("N0")) PTS</strong>) @(string.IsNullOrEmpty(Model.Email) ? "" : $"và gửi Email xác nhận qua SMTP tới {Model.Email}" ).<br />
                    • <strong>Quản trị viên:</strong> Hệ thống đã gửi thông báo đơn hàng mới <strong>#@Model.OrderCode</strong> và Email cảnh báo về trung tâm quản trị CellphoneS.
                </div>
            </div>
        </div>

        <!-- Order Code Box -->
        <div class="bg-light p-3 rounded-4 border d-inline-flex flex-column align-items-center px-4 mb-4 shadow-xs">
            <span class="text-muted small">Mã số đơn hàng chính thức:</span>
            <span class="fs-3 fw-bolder text-danger letter-spacing-1">@Model.OrderCode</span>
            <span class="badge bg-warning text-dark mt-1 px-3 py-1 fw-bold" style="font-size: 11px;">
                <i class="bi bi-clock-history me-1"></i> Chờ xác nhận & chuẩn bị hàng
            </span>
        </div>

        <!-- TIẾN TRÌNH XỬ LÝ ĐƠN HÀNG CELLPHONES (STEP TRACKER) -->
        <div class="mb-4 text-start">
            <h6 class="fw-bold text-dark mb-3 small text-uppercase">
                <i class="bi bi-diagram-3-fill text-danger me-1"></i> Tiến trình xử lý đơn hàng
            </h6>
            <div class="p-3 bg-light rounded-3 border">
                <div class="row g-2 text-center" style="font-size: 11.5px;">
                    <div class="col-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle mb-1 shadow-sm" style="width: 32px; height: 32px;">
                            <i class="bi bi-check-lg fw-bold"></i>
                        </div>
                        <div class="fw-bold text-danger">Đặt hàng</div>
                        <div class="text-muted" style="font-size: 10.5px;">@Model.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM")</div>
                    </div>
                    <div class="col-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-circle mb-1" style="width: 32px; height: 32px;">
                            <i class="bi bi-telephone-inbound-fill"></i>
                        </div>
                        <div class="fw-bold text-dark">Xác nhận đơn</div>
                        <div class="text-muted" style="font-size: 10.5px;">Trong 15 phút</div>
                    </div>
                    <div class="col-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-25 text-muted rounded-circle mb-1" style="width: 32px; height: 32px;">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="text-muted">Đóng gói hàng</div>
                        <div class="text-muted" style="font-size: 10.5px;">Kho CellphoneS</div>
                    </div>
                    <div class="col-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-25 text-muted rounded-circle mb-1" style="width: 32px; height: 32px;">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div class="text-muted">Giao tận nơi</div>
                        <div class="text-muted" style="font-size: 10.5px;">1 - 2 ngày</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin chi tiết giao hàng -->
        <div class="text-start bg-light p-3 p-md-4 rounded-3 border mb-4" style="font-size: 13px;">
            <h6 class="fw-bold border-bottom pb-2 mb-3 text-dark d-flex align-items-center justify-content-between">
                <span><i class="bi bi-person-lines-fill text-danger me-1"></i> Thông tin giao hàng & liên hệ</span>
                <span class="badge bg-danger"><i class="bi bi-shield-check me-1"></i> Bảo hành chính hãng</span>
            </h6>
            <div class="row g-2">
                <div class="col-sm-6"><strong>Người nhận:</strong> @Model.CustomerName</div>
                <div class="col-sm-6"><strong>Số điện thoại:</strong> @Model.PhoneNumber</div>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="col-12"><strong>Email nhận hóa đơn:</strong> @Model.Email</div>
                }
                <div class="col-12"><strong>Địa chỉ giao nhận:</strong> @Model.Address, @Model.Province</div>
                <div class="col-sm-6"><strong>Phương thức thanh toán:</strong> @(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản VietQR")</div>
                <div class="col-sm-6"><strong>Điểm Smember tích lũy:</strong> <span class="badge bg-warning text-dark">+@(((int)(Model.TotalAmount / 100000m)).ToString("N0")) PTS</span></div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="col-12 text-muted"><strong>Ghi chú giao hàng:</strong> @Model.Notes</div>
                }
            </div>
        </div>

        <!-- Danh sách sản phẩm trong đơn -->
        <div class="text-start mb-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-box-seam text-danger me-1"></i> Sản phẩm trong đơn hàng (@Model.OrderDetails.Count)</h6>
            <div class="list-group">
                @foreach (var detail in Model.OrderDetails)
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between py-2 border-start-0 border-end-0">
                        <div class="d-flex align-items-center gap-3">
                            @if (detail.Product != null)
                            {
                                <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 48px; height: 48px; object-fit: contain;" class="rounded border p-1" />
                            }
                            <div>
                                <h6 class="mb-0 fw-semibold text-dark" style="font-size: 13.5px;">@(detail.Product?.Name ?? "Sản phẩm")</h6>
                                @if (!string.IsNullOrEmpty(detail.VariantInfo))
                                {
                                    <small class="text-muted d-block">Phân loại: @detail.VariantInfo</small>
                                }
                            </div>
                        </div>
                        <div class="text-end" style="font-size: 13px;">
                            <span class="text-muted">x@detail.Quantity</span>
                            <span class="text-danger fw-bold ms-3">@detail.TotalPrice.ToString("N0")₫</span>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-light p-3 rounded-bottom border border-top-0 small">
                @if (Model.SubtotalAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Tạm tính sản phẩm:</span>
                        <span class="fw-bold">@Model.SubtotalAmount.ToString("N0")₫</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.OrderDiscountCode) && Model.OrderDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-danger">
                        <span><i class="bi bi-tag-fill me-1"></i>Mã giảm giá (@Model.OrderDiscountCode):</span>
                        <span class="fw-bold">-@Model.OrderDiscountAmount.ToString("N0")₫</span>
                    </div>
                }
                @if (Model.ShippingFee > 0)
                {
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="fw-bold">@Model.ShippingFee.ToString("N0")₫</span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span><i class="bi bi-truck me-1"></i>Phí vận chuyển:</span>
                        <span class="fw-bold">MIỄN PHÍ</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ShippingDiscountCode) && Model.ShippingDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span><i class="bi bi-truck me-1"></i>Giảm phí ship (@Model.ShippingDiscountCode):</span>
                        <span class="fw-bold">-@Model.ShippingDiscountAmount.ToString("N0")₫</span>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                    <span class="fw-bold fs-6">Tổng thanh toán:</span>
                    <span class="text-danger fw-bolder fs-4">@Model.TotalAmount.ToString("N0")₫</span>
                </div>
            </div>
        </div>

        <!-- Hướng dẫn hỗ trợ -->
        <div class="alert alert-info py-2 px-3 small mb-4 text-start rounded-3">
            <i class="bi bi-headset text-primary me-1"></i> Tổng đài CellphoneS <strong>1800.2097</strong> (Miễn phí từ 8h00 - 21h30) luôn sẵn sàng giải đáp bất kỳ thắc mắc nào về đơn hàng của bạn.
        </div>

        <!-- Các nút điều hướng nhanh -->
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
            </a>
            <a asp-controller="Cart" asp-action="Tracking" asp-route-orderCode="@Model.OrderCode" asp-route-phone="@Model.PhoneNumber" class="btn btn-danger px-4 fw-bold shadow-sm">
                <i class="bi bi-search me-1"></i> Theo dõi đơn hàng
            </a>
            <a asp-controller="Account" asp-action="Profile" asp-route-tab="orders" class="btn btn-outline-danger px-4 fw-bold">
                <i class="bi bi-person-vcard me-1"></i> Đơn hàng của tôi
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Trigger Confetti Celebration
            try {
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 }
                    });
                }
            } catch (e) { }

            // Đồng bộ lại chuông thông báo nếu có
            if (typeof fetchCustomerNotifications === 'function') {
                fetchCustomerNotifications();
            }
        });
    </script>
}
