@model WebsiteBanDienThoai.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Smember - CellphoneS";
}

<div class="container py-5" style="max-width: 520px;">
    <!-- CARD ĐĂNG NHẬP -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <!-- Header màu đỏ CellphoneS -->
        <div class="bg-danger text-white text-center py-4 px-3" style="background: linear-gradient(135deg, #d70018 0%, #b30014 100%);">
            <div class="d-inline-flex align-items-center justify-content-center bg-white text-danger rounded-circle mb-2 shadow" style="width: 56px; height: 56px; font-size: 26px;">
                <i class="bi bi-person-fill"></i>
            </div>
            <h4 class="fw-bold mb-1">Đăng Nhập Smember</h4>
            <p class="small text-white-50 m-0">Tích điểm nâng hạng, săn deal hời và đặc quyền VIP</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label small fw-bold">Email hoặc Số điện thoại:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" id="login-username" class="form-control" placeholder="admin@cellphones.com.vn hoặc 0988888888" autofocus required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label small fw-bold">Mật khẩu:</label>
                        <a href="javascript:void(0)" onclick="showForgotPassword()" class="small text-decoration-none text-muted">Quên mật khẩu?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" id="login-password" type="password" class="form-control" placeholder="Nhập mật khẩu..." required />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility()">
                            <i id="eye-icon" class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="chkRememberMe" />
                    <label class="form-check-label small text-muted" for="chkRememberMe">
                        Duy trì đăng nhập trên thiết bị này
                    </label>
                </div>

                <button type="submit" class="btn btn-danger w-100 py-2 fw-bold fs-6 shadow-sm mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> ĐĂNG NHẬP
                </button>

                <div class="text-center small text-muted">
                    Bạn chưa có tài khoản Smember? 
                    <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-danger fw-bold text-decoration-none">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>

    <!-- KHỐI HỖ TRỢ TEST PHÂN QUYỀN (DEMO ACCOUNTS HELPER) -->
    <div class="card border border-warning border-opacity-50 bg-warning bg-opacity-10 rounded-3 mt-4">
        <div class="card-body p-3">
            <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-key-fill text-warning"></i> Tài Khoản Thử Nghiệm Phân Quyền:
            </h6>
            <div class="row g-2 small">
                <!-- Tài khoản Admin -->
                <div class="col-12 col-md-6">
                    <div class="p-2 bg-white rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-danger">ADMIN (Quản trị)</span>
                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 fw-bold" onclick="fillAdminCreds()">
                                <i class="bi bi-lightning-fill"></i> Tự điền
                            </button>
                        </div>
                        <div class="text-muted" style="font-size: 11px;">Tài khoản: <code>admin@cellphones.com.vn</code></div>
                        <div class="text-muted" style="font-size: 11px;">Mật khẩu: <code>Admin@123</code></div>
                        <div class="text-success fw-bold mt-1" style="font-size: 10px;"><i class="bi bi-check-circle"></i> Có toàn quyền vào trang Admin</div>
                    </div>
                </div>

                <!-- Tài khoản Khách -->
                <div class="col-12 col-md-6">
                    <div class="p-2 bg-white rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-secondary">CUSTOMER (Khách)</span>
                            <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 fw-bold" onclick="fillCustomerCreds()">
                                <i class="bi bi-lightning-fill"></i> Tự điền
                            </button>
                        </div>
                        <div class="text-muted" style="font-size: 11px;">Tài khoản: <code>customer@gmail.com</code></div>
                        <div class="text-muted" style="font-size: 11px;">Mật khẩu: <code>User@123</code></div>
                        <div class="text-danger fw-bold mt-1" style="font-size: 10px;"><i class="bi bi-slash-circle"></i> Sẽ bị chặn khi vào trang Admin</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility() {
            const pwd = document.getElementById("login-password");
            const icon = document.getElementById("eye-icon");
            if (pwd.type === "password") {
                pwd.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                pwd.type = "password";
                icon.className = "bi bi-eye";
            }
        }

        function fillAdminCreds() {
            document.getElementById("login-username").value = "admin@cellphones.com.vn";
            document.getElementById("login-password").value = "Admin@123";
        }

        function fillCustomerCreds() {
            document.getElementById("login-username").value = "customer@gmail.com";
            document.getElementById("login-password").value = "User@123";
        }

        function showForgotPassword() {
            Swal.fire({
                icon: 'info',
                title: 'Hỗ Trợ Quên Mật Khẩu',
                html: `
                    <div class="text-start p-2">
                        <p class="mb-2">Để bảo vệ an toàn thông tin tài khoản của bạn, vui lòng liên hệ:</p>
                        <div class="p-3 bg-light rounded border mb-2 text-center">
                            <div class="text-muted small">Tổng đài hỗ trợ kỹ thuật miễn phí:</div>
                            <a href="tel:18002097" class="fs-4 fw-bold text-danger text-decoration-none">
                                <i class="bi bi-telephone-fill me-1"></i> 1800.2097
                            </a>
                            <div class="small text-muted mt-1">(Phục vụ từ 8h00 - 21h30 hằng ngày)</div>
                        </div>
                        <p class="small text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Hoặc bạn có thể mang theo CCCD/SĐT đến cửa hàng CellphoneS gần nhất để được cấp lại mật khẩu ngay.</p>
                    </div>
                `,
                confirmButtonColor: '#d70018',
                confirmButtonText: 'Đã Hiểu',
                customClass: {
                    popup: 'rounded-4'
                }
            });
        }
    </script>
}
